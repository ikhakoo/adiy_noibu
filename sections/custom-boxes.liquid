{% schema %}
{
  "name": "Custom Boxes",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Section Heading",
      "default": "Our Features"
    },
    {
      "type": "number",
      "id": "section_heading_desktop",
      "label": "Section Heading Font Size Desktop (px)",
      "default": 32
    },
    {
      "type": "number",
      "id": "section_heading_tablet",
      "label": "Section Heading Font Size Tablet (px)",
      "default": 28
    },
    {
      "type": "number",
      "id": "section_heading_mobile",
      "label": "Section Heading Font Size Mobile (px)",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "box",
      "name": "Box",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Box Heading (H3)"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Box Content (Paragraph / WYSIWYG)"
        },
        {
          "type": "number",
          "id": "h3_desktop",
          "label": "H3 Font Size Desktop (px)",
          "default": 20
        },
        {
          "type": "number",
          "id": "h3_tablet",
          "label": "H3 Font Size Tablet (px)",
          "default": 18
        },
        {
          "type": "number",
          "id": "h3_mobile",
          "label": "H3 Font Size Mobile (px)",
          "default": 16
        },
        {
          "type": "number",
          "id": "p_desktop",
          "label": "Paragraph Font Size Desktop (px)",
          "default": 16
        },
        {
          "type": "number",
          "id": "p_tablet",
          "label": "Paragraph Font Size Tablet (px)",
          "default": 15
        },
        {
          "type": "number",
          "id": "p_mobile",
          "label": "Paragraph Font Size Mobile (px)",
          "default": 14
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Custom Boxes"
    }
  ]
}
{% endschema %}

{% stylesheet %}
/* Section styling */
.custom-box-section {
  padding: 50px 15px;
  text-align: center;
}

/* Boxes container */
.custom-boxes {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  justify-content: center;
}

/* Individual box styling */
.custom-boxes .box {
  width: 23%;
  background: #f6f4f2;
  padding: 25px 20px;
  border-radius: 12px;
  box-sizing: border-box;
  text-align: center;
}

/* Image styling */
.custom-boxes .box img {
  max-width: 100%;
  height: auto;
  margin-bottom: 20px;
  border-radius: 8px;
  margin-left: auto;
  margin-right: auto;
}
.custom-boxes .box h3
{
    margin-bottom: 10px;
}
/* Section heading */
.custom-box-section h2 {
  text-align: center;
  margin-bottom: 40px;
}

/* Responsive boxes */
@media (max-width: 1024px) {
  .custom-boxes .box {
    width: 48%;
  }
}

@media (max-width: 600px) {
  .custom-boxes .box {
    width: 100%;
  }
}
@media (min-width: 1366px) {
    .custom-box-section {
        padding: 50px 0px;
        text-align: center;
        max-width: 1500px;
        margin: 0 auto;
    }
}
{% endstylesheet %}

<div class="custom-box-section">
  {% if section.settings.section_heading %}
    <h2 class="section-heading"
        style="font-size: {{ section.settings.section_heading_desktop }}px;">
      {{ section.settings.section_heading }}
    </h2>
  {% endif %}

  <div class="custom-boxes">
    {% for block in section.blocks %}
      <div class="box">
        {% if block.settings.image %}
          <img src="{{ block.settings.image | img_url: 'medium' }}" alt="">
        {% endif %}
        {% if block.settings.heading %}
          <h3 class="box-h3" style="font-size: {{ block.settings.h3_desktop }}px;">
            {{ block.settings.heading }}
          </h3>
        {% endif %}
        {% if block.settings.content %}
          <div class="box-p" style="font-size: {{ block.settings.p_desktop }}px;">
            {{ block.settings.content }}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% javascript %}
/* Responsive font sizes for H3 and paragraph */
function setResponsiveFonts() {
  var w = window.innerWidth;
  var sectionHeading = document.querySelector('.custom-box-section h2');
  var boxes = document.querySelectorAll('.custom-boxes .box');

  var sectionSettings = {{ section.settings | json }};
  var blocksSettings = {{ section.blocks | map: "settings" | json }};

  // Section heading
  if(sectionHeading){
    if(w <= 600) sectionHeading.style.fontSize = sectionSettings.section_heading_mobile + "px";
    else if(w <= 1024) sectionHeading.style.fontSize = sectionSettings.section_heading_tablet + "px";
    else sectionHeading.style.fontSize = sectionSettings.section_heading_desktop + "px";
  }

  // Box H3 and paragraph fonts
  boxes.forEach(function(box, i){
    var h3 = box.querySelector('.box-h3');
    var p = box.querySelector('.box-p');
    if(h3){
      if(w <= 600) h3.style.fontSize = blocksSettings[i].h3_mobile + "px";
      else if(w <= 1024) h3.style.fontSize = blocksSettings[i].h3_tablet + "px";
      else h3.style.fontSize = blocksSettings[i].h3_desktop + "px";
    }
    if(p){
      if(w <= 600) p.style.fontSize = blocksSettings[i].p_mobile + "px";
      else if(w <= 1024) p.style.fontSize = blocksSettings[i].p_tablet + "px";
      else p.style.fontSize = blocksSettings[i].p_desktop + "px";
    }
  });
}

document.addEventListener('DOMContentLoaded', setResponsiveFonts);
window.addEventListener('resize', setResponsiveFonts);
{% endjavascript %}