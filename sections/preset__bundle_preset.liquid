{%- render "bundle" -%}
{% schema %}
{
  "name": "Bundle Pre-configured",
  "settings": [
    {
      "type": "header",
      "content": "Bundle Limits"
    },
    {
      "type": "select",
      "id": "restrict_bundle_quantity",
      "label": "Restrict bundle quantity",
      "default": "no_limit",
      "options": [
        {
          "value": "hard_limit",
          "label": "Hard limit"
        },
        {
          "value": "upgrade_limit",
          "label": "Upgrade limit"
        },
        {
          "value": "no_limit",
          "label": "No limit"
        }
      ]
    },
    {
      "type": "header",
      "content": "Bundle Targets"
    },
    {
      "type": "paragraph",
      "content": "Important. This section does not create actual discounts. All discounts need to be created in the Shopify Admin Dashboard to match the settings here."
    },
    {
      "type": "select",
      "id": "bundle_target_type",
      "label": "Bundle Targets",
      "info": "Bundle Targets are displayed via the Select dropdown",
      "default": "item_count",
      "options": [
        {
          "value": "total_price",
          "label": "Amount based"
        },
        {
          "value": "item_count",
          "label": "Quantity based"
        }
      ]
    },
    {
      "type": "select",
      "id": "incentive_target_type",
      "label": "Incentive Targets",
      "info": "Incentive Targets are displayed via the Progress bar Block.",
      "default": "total_price",
      "options": [
        {
          "value": "total_price",
          "label": "Subtotal"
        },
        {
          "value": "final_price",
          "label": "Final price"
        },
        {
          "value": "item_count",
          "label": "Quantity"
        }
      ]
    },
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "text",
      "id": "desktop_sidebar_width_gap",
      "label": "desktop sidebar width | gap",
      "default": "540px / 460px | 24px / 24px",
      "info": "Custom breakpoint at 1280px and 1024px to change to the vertical mobile layout."
    },
    {
      "type": "select",
      "id": "product_scroll",
      "label": "Product scroll",
      "default": "lg:sticky",
      "options": [
        {
          "value": "lg:sticky",
          "label": "Sticky"
