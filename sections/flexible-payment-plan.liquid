    },
    {
      "type": "color",
      "id": "terms_color",
      "label": "Terms Color",
      "default": "#7A7A7A"
    },
    {
      "type": "range",
      "id": "terms_size",
      "label": "Terms Size (Desktop)",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "terms_size_mobile",
      "label": "Terms Size (Mobile)",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "payment_provider",
      "name": "Image",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Payment Providers Image",
          "info": "Upload the full payment card image (e.g. Klarna + Affirm)."
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text",
          "default": "Payment providers"
        },
        {
          "type": "range",
          "id": "image_max_width",
          "label": "Image Max Width (Desktop)",
          "min": 200,
          "max": 800,
          "step": 10,
          "unit": "px",
          "default": 500
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Flexible Payment Plans",
      "blocks": [
        {
          "type": "payment_provider",
          "settings": {
            "alt_text": "Payment providers"
          }
        }
      ]
    }
  ]
}
{% endschema %}