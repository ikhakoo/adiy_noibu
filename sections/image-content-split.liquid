{% comment %}
  Section: Image Content Split
  Pixel-perfect match to Deck Height section design
  Left: Image | Right: Label, Heading, Content Blocks, Button
{% endcomment %}

<section
  class="ics-section"
  id="ics-{{ section.id }}"
  style="
    background-color: {{ section.settings.section_bg }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="ics-container">

    {%- comment -%} LEFT — Image {%- endcomment -%}
    <div class="ics-image-wrap" style="background-color: {{ section.settings.image_bg }};">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 900
          | image_tag:
            loading: 'lazy',
            class: 'ics-image',
            alt: section.settings.image.alt | escape
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'ics-placeholder-svg' }}
      {%- endif -%}
    </div>

    {%- comment -%} RIGHT — Content {%- endcomment -%}
    <div class="ics-content">

      {%- if section.settings.label != blank -%}
        <p
          class="ics-label"
          style="color: {{ section.settings.label_color }};"
        >{{ section.settings.label }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <{{ section.settings.heading_tag }}
          class="ics-heading"
          style="color: {{ section.settings.heading_color }};"
        >{{ section.settings.heading }}</{{ section.settings.heading_tag }}>
      {%- endif -%}

      {%- comment -%} Repeatable content blocks {%- endcomment -%}
      {%- if section.blocks.size > 0 -%}
        <div class="ics-blocks">
          {%- for block in section.blocks -%}
            {%- if block.type == 'content_block' -%}
              <div class="ics-block" {{ block.shopify_attributes }}>
                {%- if block.settings.block_heading != blank -%}
                  <p
                    class="ics-block-heading"
                    style="color: {{ block.settings.heading_color }};"
                  >{{ block.settings.block_heading }}</p>
                {%- endif -%}
                {%- if block.settings.block_text != blank -%}
                  <p
                    class="ics-block-text"
                    style="color: {{ block.settings.text_color }};"
                  >{{ block.settings.block_text }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} Button {%- endcomment -%}
      {%- if section.settings.button_label != blank -%}
        <a
          href="{{ section.settings.button_url }}"
          class="ics-btn"
          style="
            color: {{ section.settings.button_text_color }};
            border-color: {{ section.settings.button_border_color }};
            background-color: {{ section.settings.button_bg }};
            border-radius: {{ section.settings.button_radius }}px;
          "
        >{{ section.settings.button_label }}</a>
      {%- endif -%}

    </div>{%- comment -%} .ics-content {%- endcomment -%}
  </div>{%- comment -%} .ics-container {%- endcomment -%}
</section>

<style>
  #ics-{{ section.id }} {
    --ics-gap: 56px;
    --ics-image-radius: 16px;
    --ics-max-width: 1440px;
    --ics-img-ratio: 45%;
    --ics-content-ratio: 45%;
  }

  /* ── Container ── */
  #ics-{{ section.id }} .ics-container {
    display: flex;
    align-items: center;
    gap: 40px;
    max-width: var(--ics-max-width);
    margin: 0 auto;
    padding: 60px 66px;
    background: #F9F9F9;
    border-radius: 30px;
  }

  /* ── Image Side ── */
  #ics-{{ section.id }} .ics-image-wrap {
    flex: 0 0 var(--ics-img-ratio);
    width: var(--ics-img-ratio);
    border-radius: var(--ics-image-radius);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 340px;
  }

  #ics-{{ section.id }} .ics-image {
    width: 100%;
    {% comment %} height: 377px; {% endcomment %}
    height: auto;
    object-fit: {{ section.settings.image_fit }};
    display: block;
    border-radius: 30px;
  }

  #ics-{{ section.id }} .ics-placeholder-svg {
    width: 100%;
    height: 300px;
    display: block;
  }

  /* ── Content Side ── */
  #ics-{{ section.id }} .ics-content {
    flex: 1 1 var(--ics-content-ratio);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
  }

  /* Label */
  #ics-{{ section.id }} .ics-label {
    font-size: {{ section.settings.label_size }}px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0 0 15px;
    line-height: 1.4;
  }

  /* Heading */
  #ics-{{ section.id }} .ics-heading {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: 500;
    line-height: 1.15;
    margin: 0 0 15px;
    letter-spacing: -0.01em;
  }

  /* Blocks wrapper */
  #ics-{{ section.id }} .ics-blocks {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.block_gap }}px;
    margin-bottom: 32px;
    width: 100%;
  }

  /* Individual block */
  #ics-{{ section.id }} .ics-block {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  #ics-{{ section.id }} .ics-block-heading {
    font-size: {{ section.settings.block_heading_size }}px;
    font-weight: 600;
    margin: 0;
    line-height: 1.4;
  }

  #ics-{{ section.id }} .ics-block-text {
    font-size: {{ section.settings.block_text_size }}px;
    font-weight: 400;
    margin: 0;
    line-height: 1.6;
    max-width: 90%;
  }

  /* Button */
  #ics-{{ section.id }} .ics-btn {
    display: inline-block;
    padding: 10px 50px;
    border: 2px solid;
    text-decoration: none;
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: 600;
    letter-spacing: 0.01em;
    cursor: pointer;
    transition: background-color 0.22s ease, color 0.22s ease;
    margin-top: 4px;
  }

  #ics-{{ section.id }} .ics-btn:hover {
    background-color: {{ section.settings.button_hover_bg }} !important;
    color: {{ section.settings.button_hover_text }} !important;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    #ics-{{ section.id }} {
      padding-left: 20px;
      padding-right: 20px;
      padding-bottom: 20px !important;
    }
    #ics-{{ section.id }} .ics-container {
      flex-direction: {{ section.settings.mobile_order }};
      padding: 20px;
      gap: 20px;
    }
    #ics-{{ section.id }} .ics-btn {
      font-size: 13px;
      text-align: center;
    }
    #ics-{{ section.id }} .ics-image {
      {% comment %} height: 270px; {% endcomment %}
      height: auto;
      border-radius: 24px;
    }

    #ics-{{ section.id }} .ics-image-wrap {
      flex: 0 0 100%;
      width: 100%;
      {% comment %} min-height: 270px; {% endcomment %}
      height: auto;

    }

    #ics-{{ section.id }} .ics-heading {
      font-size: clamp(24px, 6vw, {{ section.settings.heading_size }}px);
    }

    #ics-{{ section.id }} .ics-block-text {
      max-width: 100%;
    }
  }

  @media (max-width: 768px) {
    #ics-{{ section.id }} .ics-block-text {
      font-size:13px;
    }
    #ics-{{ section.id }} .ics-block-heading {
      font-size:13px;
    }
  }
  @media (max-width: 480px) {

    #ics-{{ section.id }} .ics-image-wrap {
      {% comment %} min-height: 270px; {% endcomment %}
      height: auto;
      min-height: auto;
      border-radius: 12px;
    }
    #ics-{{ section.id }} .ics-label {
      font-size: 11px;
    }
    #ics-{{ section.id }} .ics-blocks {
      gap: 30px;
    }
    #ics-{{ section.id }} .ics-image {
      object-fit: cover;
    }
  }
</style>

{% schema %}
{
