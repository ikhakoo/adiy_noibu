{%- render "global_typography" -%}
{% schema %}
{
  "name": "Typography",
  "settings": [
    {
      "type": "header",
      "content": "Root Typography"
    },
    {
      "type": "text",
      "id": "font_family__body",
      "label": "Font family",
      "default": "Inter"
    },
    {
      "type": "text",
      "id": "size_weight_height_opacity__body",
      "label": "size | weight | height | opacity",
      "default": "16px | 400 | 1.3 | 1"
    },
    {
      "type": "text",
      "id": "spacing_transform_style_whitespace__body",
      "label": "spacing | transform | style | wrap",
      "default": "0 | none | normal"
    },
    {
      "type": "textarea",
      "id": "custom_css__body",
      "label": "custom CSS",
      "default": "& strong {\n  font-weight: bolder;\n}\n& em {\n  font-style: italic;\n}\n& [style=\"text-decoration:underline\"] {\n  text-decoration: underline;\n}"
    },
    {
      "type": "paragraph",
      "content": "t:all.empty_char"
    },
    {
      "type": "paragraph",
      "content": "t:all.empty_char"
    },
    {
      "type": "text",
      "id": "responsive_breakpoint",
      "label": "Responsive breakpoint",
      "default": "768px",
      "info": "Only adjust this for rare instances on large screen designs"
    }
  ],
  "blocks": [
    {
      "name": "Font",
      "type": "font",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Font family name",
          "default": "Inter"
        },
        {
          "type": "font_picker",
          "id": "family",
          "label": "Font Family",
          "default": "inter_n4",
          "info": "If you want to use a Custom Font, set the Font Family to a SYSTEM FONT: sans-serif, serif or mono"
        },
        {
          "type": "text",
          "id": "weights",
          "label": "Font Weights / Styles",
          "default": "300, 400, 400i, 700, 700i, 800"
        },
        {
          "type": "header",
          "content": "Custom Fonts Only"
        },
        {
          "type": "liquid",
          "id": "custom_src",
          "label": "Custom font declaration",
          "info": "Accepts HTML / Liquid"
        },
        {
          "type": "text",
          "id": "fallback_families",
          "label": "Font Family",
          "default": "-apple-system, BlinkMacSystemFont, \"San Francisco\", \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif"
        },
        {
          "type": "paragraph",
          "content": "Custom fonts can be uploaded to Shopify (Admin -> Content -> Files) or directly into the theme `assets` folder. For Font Setup instructions [read more](https://fonts.google.com/knowledge/using_type/using_web_fonts)"
        }
      ],
      "limit": 5
    },
    {
      "name": "Richtext Set",
