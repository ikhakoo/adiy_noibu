{% comment %}
  ╔══════════════════════════════════════════════════════════╗
  ║        TAB-BASED FAQ SECTION — ExpertsCabin              ║
  ║   Fully Block-Based: Tabs + FAQ Items — Single File      ║
  ║   BUG FIX: where filter → for loop + if condition        ║
  ╚══════════════════════════════════════════════════════════╝

  HOW IT WORKS:
  ─────────────────────────────────────────────────────────
  • Add "🗂 FAQ Tab" blocks  → ye tabs banate hain
  • Add "❓ FAQ Item" blocks → question + answer + Tab Number select
  • Tab 1 = pehla tab block, Tab 2 = doosra tab block…
  ─────────────────────────────────────────────────────────
{% endcomment %}

{%- liquid
  assign section_id = 'faq-tabs-' | append: section.id
  assign tab_blocks = section.blocks | where: 'type', 'tab'
  assign faq_blocks = section.blocks | where: 'type', 'faq_item'
-%}

<style>
  #{{ section.settings.custom_id }} {
    --faq-bg:              {{ section.settings.section_bg_color }};
    --faq-active:          {{ section.settings.active_tab_color }};
    --faq-text:            {{ section.settings.text_color }};
    --faq-border:          {{ section.settings.border_color }};
    --faq-tab-text:        {{ section.settings.tab_text_color }};
    --faq-tab-active-text: {{ section.settings.tab_active_text_color }};
    --faq-btn-border:      {{ section.settings.btn_color }};
    --faq-btn-text:        {{ section.settings.btn_text_color }};
    --faq-label-color:     {{ section.settings.label_color }};
    --faq-heading-color:   {{ section.settings.heading_color }};
    --faq-plus-color:      {{ section.settings.plus_icon_color }};
    --faq-answer-text:     {{ section.settings.answer_text_color }};
    background-color:      var(--faq-bg);
    padding-top:           {{ section.settings.padding_top }}px;
    padding-bottom:        {{ section.settings.padding_bottom }}px;
    display:               block;
    width:                 100%;
    box-sizing:            border-box;
  }
  #{{ section.settings.custom_id }} .faq-container {
    max-width: 850px;
    margin: 0 auto;
    padding: 0 20px;
    text-align: center;
    box-sizing: border-box;
  }
  #{{ section.settings.custom_id }} .faq-label {
    font-size: 14px;
    font-weight: 600;
    font-family: 'Poppins';
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--faq-label-color);
    margin: 0 0 25px;
    line-height: 1;
  }
  #{{ section.settings.custom_id }} .faq-heading {
    font-size: clamp(24px, 4vw, 40px);
    font-weight: 500;
    font-family: 'Poppins';
    color: var(--faq-heading-color);
    line-height: 44px;
    margin: 0 0 20px;
  }
  #{{ section.settings.custom_id }} .faq-tabs-wrap {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-bottom: 30px;
  }
  #{{ section.settings.custom_id }} .faq-tab-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 40px;
    border-radius: 60px;
    border: 2px solid #D5D5D5;
    background: transparent;
    color: var(--faq-tab-text);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    white-space: nowrap;
    line-height: 1;
    width: 133px;
    height: 52px;
    text-transform: uppercase;
  }
  
  #{{ section.settings.custom_id }} .faq-tab-btn.is-active {
    background: var(--faq-active);
    border: 2px solid #3A6958;
    color: var(--faq-tab-active-text);
    font-weight: 600;
  }
  #{{ section.settings.custom_id }} .faq-panel {
    display: none;
    text-align: left;
  }
  #{{ section.settings.custom_id }} .faq-panel.is-active {
    display: block;
    animation: faqIn_{{ section.id }} 0.25s ease;
    background: #fff;
    border: 1px solid #E5E5E5;
  }
  @keyframes faqIn_{{ section.id }} {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0);   }
  }
  #{{ section.settings.custom_id }} .faq-empty {
    padding: 24px 0;
    color: #999;
    font-size: 14px;
    text-align: center;
    font-style: italic;
  }
  #{{ section.settings.custom_id }} .faq-item {
    border-bottom: 1.5px solid var(--faq-border);
  }
  #{{ section.settings.custom_id }} .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    background: none;
    border: none;
    padding: 20px 20px;
    cursor: pointer;
    text-align: left;
    color: var(--faq-text);
    font-size: 15px;
    font-weight: 500;
    line-height: 22px;
    transition: color 0.2s;
    font-family: inherit;
  }
  #{{ section.settings.custom_id }} .faq-icon {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--faq-plus-color);
    transition: transform 0.3s ease;
  }
  #{{ section.settings.custom_id }} .faq-item.is-open .faq-icon {
    transform: rotate(45deg);
  }
  #{{ section.settings.custom_id }} .faq-answer {
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.35s ease;
    visibility: hidden;
  }
  #{{ section.settings.custom_id }} .faq-answer.is-open {
    visibility: visible;
    padding: 20px 20px;
  }
  #{{ section.settings.custom_id }} .faq-answer-inner {
    padding: 0 0 20px;
    font-size: 14.5px;
    color: var(--faq-answer-text);
    line-height: 1.7;
  }
  #{{ section.settings.custom_id }} .faq-answer-inner p { margin: 0 0 8px; }
  #{{ section.settings.custom_id }} .faq-answer-inner p:last-child { margin-bottom: 0; }
  #{{ section.settings.custom_id }} .faq-cta-wrap {
    margin-top: 35px;
    text-align: center;
  }
  #{{ section.settings.custom_id }} .faq-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 56px;
    padding: 18px 51px 17px 51px;
    border-radius: 60px;
    border: 2px solid var(--faq-btn-border);
    background: #E0EDE7;
    color: var(--faq-btn-text);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: background 0.22s ease, color 0.22s ease;
    cursor: pointer;
    font-family: inherit;
  }
  #{{ section.settings.custom_id }} .faq-cta-btn:hover {
    background: var(--faq-btn-border);
    color: #fff;
  }
  @media (max-width: 600px) {
    #{{ section.settings.custom_id }} { padding-top: 30px; padding-bottom: 30px; }
    #{{ section.settings.custom_id }} .faq-container    { padding: 0 16px; }
    #{{ section.settings.custom_id }} .faq-label { font-size: 10px;  font-weight: 600;  margin: 0 0 10px; letter-spacing: 1.5px; }
    #{{ section.settings.custom_id }} .faq-heading      { line-height: 30px; max-width: 80%; margin: 0 auto 20px; }
    #{{ section.settings.custom_id }} .faq-panel.is-active { background: none; border: none;}
    #{{ section.settings.custom_id }} .faq-tabs-wrap    { gap: 10px; margin-bottom: 15px; }
    #{{ section.settings.custom_id }} .faq-tab-btn      { font-size: 12px; padding: 0 14px; height: 34px; flex: 1 1 calc(50% - 12px);font-weight: 500; }
    #{{ section.settings.custom_id }} .faq-tab-btn:nth-child(-n+3) { flex: 1 1 calc(33.33% - 12px) !important; }
    #{{ section.settings.custom_id }} .faq-question     { font-size: 14px; padding: 16px 0; }
    #{{ section.settings.custom_id }} .faq-answer-inner { font-size: 13.5px; padding: 0 0 10px; }
    #{{ section.settings.custom_id }} .faq-answer.is-open { padding: 0px; }
    #{{ section.settings.custom_id }} .faq-cta-wrap { margin-top: 25px; }
    #{{ section.settings.custom_id }} .faq-cta-btn      { width: 100%; font-size: 13px; }
  }
</style>

<section id="{{ section.settings.custom_id }}">
  <div class="faq-container">

    {%- if section.settings.label != blank -%}
      <p class="faq-label">{{ section.settings.label }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="faq-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if tab_blocks.size > 0 -%}

      {%- comment %} ── Tab Buttons ── {%- endcomment %}
      <div class="faq-tabs-wrap" role="tablist" aria-label="FAQ Categories">
        {%- for tab in tab_blocks -%}
          <button
            class="faq-tab-btn{% if forloop.first %} is-active{% endif %}"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="faq-panel-{{ tab.id }}"
            data-target="faq-panel-{{ tab.id }}"
            {{ tab.shopify_attributes }}
          >
            {{ tab.settings.tab_label }}
          </button>
        {%- endfor -%}
      </div>

      {%- comment %}
        ╔════════════════════════════════════════════════════════╗
        ║  BUG FIX:                                              ║
        ║  Shopify Liquid ka "where" filter nested settings.*    ║
        ║  properties pe kaam nahi karta.                        ║
        ║  Solution: for loop + if faq.settings.tab_number ==    ║
        ║  forloop.index use karo direct comparison ke liye.     ║
        ╚════════════════════════════════════════════════════════╝
      {%- endcomment %}

      {%- comment %} ── FAQ Panels ── {%- endcomment %}
      {%- for tab in tab_blocks -%}
        {%- assign current_tab_num = forloop.index -%}

        <div
          id="faq-panel-{{ tab.id }}"
          class="faq-panel{% if forloop.first %} is-active{% endif %}"
          role="tabpanel"
          {{ tab.shopify_attributes }}
        >
          {%- comment %} Count karo kitne matched FAQs hain is tab mein {%- endcomment %}
          {%- assign matched_count = 0 -%}
          {%- for faq in faq_blocks -%}
            {%- assign faq_tab_num = faq.settings.tab_number | plus: 0 -%}
            {%- if faq_tab_num == current_tab_num -%}
              {%- assign matched_count = matched_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if matched_count > 0 -%}
            {%- comment %} Matched FAQs render karo {%- endcomment %}
            {%- for faq in faq_blocks -%}
              {%- assign faq_tab_num = faq.settings.tab_number | plus: 0 -%}
              {%- if faq_tab_num == current_tab_num -%}
                {%- if faq.settings.question != blank -%}
                  {%- assign item_id = 'fi-' | append: faq.id -%}
                  <div class="faq-item" id="{{ item_id }}" {{ faq.shopify_attributes }}>
                    <button
                      class="faq-question"
                      aria-expanded="false"
                      aria-controls="{{ item_id }}-ans"
                    >
                      <span>{{ faq.settings.question }}</span>
                      <span class="faq-icon" aria-hidden="true">
                        <svg width="11" height="11" viewBox="0 0 11 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M10.1999 6.63961H6.71995V10.1996H3.47995V6.63961H-5.36293e-05V3.57961H3.47995V-0.000391006H6.71995V3.57961H10.1999V6.63961Z" fill="#3A6958"/>
                        </svg>
                      </span>
                    </button>
                    <div class="faq-answer" id="{{ item_id }}-ans" role="region">
                      <div class="faq-answer-inner">{{ faq.settings.answer }}</div>
                    </div>
                  </div>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            <p class="faq-empty">Is tab mein abhi koi FAQ nahi hai.</p>
          {%- endif -%}
        </div>

      {%- endfor -%}

    {%- endif -%}

    {%- if section.settings.btn_text != blank -%}
      <div class="faq-cta-wrap">
        <a
          href="{{ section.settings.btn_url | default: '#' }}"
          class="faq-cta-btn"
          {% if section.settings.btn_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
        >
          {{ section.settings.btn_text }}
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

<script>
(function () {
  var sec = document.getElementById('{{ section.settings.custom_id }}');
  if (!sec) return;

  /* ── Tab switching ── */
  var tabBtns = sec.querySelectorAll('.faq-tab-btn');
  var panels  = sec.querySelectorAll('.faq-panel');

  tabBtns.forEach(function (btn) {
    btn.addEventListener('click', function () {
      tabBtns.forEach(function (b) {
        b.classList.remove('is-active');
        b.setAttribute('aria-selected', 'false');
      });
      panels.forEach(function (p) { p.classList.remove('is-active'); });
      btn.classList.add('is-active');
      btn.setAttribute('aria-selected', 'true');
      var panel = sec.querySelector('#' + btn.dataset.target);
      if (panel) panel.classList.add('is-active');
    });
  });

  /* ── Accordion ── */
  sec.addEventListener('click', function (e) {
    var btn = e.target.closest('.faq-question');
    if (!btn) return;

    var item   = btn.closest('.faq-item');
    var answer = item.querySelector('.faq-answer');
    var isOpen = btn.getAttribute('aria-expanded') === 'true';

    var panel = btn.closest('.faq-panel');
    panel.querySelectorAll('.faq-item').forEach(function (el) {
      el.querySelector('.faq-question').setAttribute('aria-expanded', 'false');
      var ans = el.querySelector('.faq-answer');
      ans.style.maxHeight = null;
      ans.classList.remove('is-open');
      el.classList.remove('is-open');
    });

    if (!isOpen) {
      btn.setAttribute('aria-expanded', 'true');
      answer.classList.add('is-open');
      answer.style.maxHeight = answer.scrollHeight + 'px';
      item.classList.add('is-open');
    }
  });
})();
</script>

{% schema %}
{
  "name": "FAQ Tabs Section",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "custom_id",
      "label": "Custom ID",
      "default": "custom_faq"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label Text",
      "default": "FREQUENTLY ASKED QUESTIONS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Have Questions? We Have Answers."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button Text",
      "default": "Still have questions? Chat with us"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button URL"
    },
    {
      "type": "checkbox",
      "id": "btn_new_tab",
      "label": "Open in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "Section Background",
      "default": "#f2f0eb"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label Color",
      "default": "#555555"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Question Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "answer_text_color",
      "label": "Answer Text Color",
      "default": "#555555"
    },
    {
      "type": "color",
      "id": "active_tab_color",
      "label": "Active Tab Background",
      "default": "#2d6b5e"
    },
    {
      "type": "color",
      "id": "tab_active_text_color",
      "label": "Active Tab Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "tab_text_color",
      "label": "Inactive Tab Text",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "FAQ Item Border",
      "default": "#e0ddd6"
    },
    {
      "type": "color",
      "id": "plus_icon_color",
      "label": "Plus Icon Color",
      "default": "#2d6b5e"
    },
    {
      "type": "color",
      "id": "btn_color",
      "label": "Button Border Color",
      "default": "#2d6b5e"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#2d6b5e"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "🗂 FAQ Tab",
