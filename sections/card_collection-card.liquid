        {
          "type": "header",
          "content": "Image selection"
        },
        {
          "type": "text",
          "id": "primary_image",
          "label": "Primary image",
          "default": "[collection.image]",
          "info": "Use bracket notation for data access: i.e.[collection.image] or [collection.metafields.smart.image]"
        },
        {
          "type": "header",
          "content": "Hover Effect"
        },
        {
          "type": "checkbox",
          "id": "show_secondary_image",
