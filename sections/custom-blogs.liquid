<div class="custom-article-container">

  <!-- FLEX TWO COLUMNS -->
  <div class="custom-article-flex">
    <!-- LEFT COLUMN -->
    <div class="custom-article-left">
      <h1>{{ article.title }}</h1>
      {% if article.excerpt != blank %}
        
      {% endif %}
      <p class="article-meta">
        Written by A-DIY Writers | {{ article.published_at | date: "%B %d, %Y" }}
      </p>
    </div>

    <!-- RIGHT COLUMN -->
    <div class="custom-article-right">
      {% if article.image %}
        <img src="{{ article.image | image_url }}" alt="{{ article.title }}">
      {% endif %}
    </div>
  </div>

  <!-- POST CONTENT -->
  <div class="custom-article-content">
    {{ article.content }}
  </div>

  <!-- SHARE ICONS -->
  <div class="custom-blogs-share modern-share">
    <span>Share this post</span>
    <div class="share-icons-wrapper">

      <!-- Facebook -->
      <a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url }}{{ article.url }}" target="_blank" aria-label="Share on Facebook">
        <svg viewBox="0 0 24 24"><path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 5 3.66 9.12 8.44 9.88v-7h-2.54v-2.88h2.54V9.79c0-2.5 1.49-3.88 3.77-3.88 1.09 0 2.23.2 2.23.2v2.45h-1.25c-1.23 0-1.62.77-1.62 1.56v1.87h2.77l-.44 2.88h-2.33v7C18.34 21.12 22 17 22 12z"/></svg>
      </a>

      <!-- Pinterest -->
      <a href="https://www.pinterest.com/pin/create/button/?url={{ shop.url }}{{ article.url }}&description={{ article.title }}" target="_blank" aria-label="Share on Pinterest">
        <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.02 2.36 7.48 5.79 9.04-.08-.77-.15-1.95.03-2.78.16-.69 1.05-4.43 1.05-4.43s-.26-.52-.26-1.29c0-1.21.7-2.12 1.57-2.12.74 0 1.09.56 1.09 1.23 0 .75-.48 1.87-.73 2.91-.21.87.45 1.57 1.32 1.57 1.58 0 2.79-1.66 2.79-4.05 0-2.12-1.52-3.6-3.68-3.6-2.51 0-3.98 1.87-3.98 3.79 0 .75.29 1.56.65 2.01a.26.26 0 01.06.25c-.06.28-.2.87-.23.99-.04.15-.13.18-.3.11-1.11-.51-1.8-2.13-1.8-3.43 0-2.8 2.03-5.37 5.85-5.37 3.07 0 5.46 2.18 5.46 5.09 0 3.05-1.93 5.51-4.61 5.51-0.9 0-1.74-.47-2.03-1.03l-.55 2.08c-.2.77-.75 1.73-1.12 2.32.84.26 1.73.4 2.65.4 5.52 0 10-4.48 10-10S17.52 2 12 2z"/></svg>
      </a>

      <!-- X (Twitter) -->
      <a href="https://twitter.com/intent/tweet?url={{ shop.url }}{{ article.url }}&text={{ article.title }}" target="_blank" aria-label="Share on X">
        <svg viewBox="0 0 24 24">
          <path d="M18.244 2H21l-6.5 7.43L22 22h-6.828l-5.345-7.07L3.5 22H1l6.953-7.95L2 2h6.828l4.83 6.39L18.244 2zm-2.39 18h1.885L7.155 4H5.09l10.764 16z"/>
        </svg>
      </a>

      <!-- Copy Link -->
      <button onclick="navigator.clipboard.writeText(window.location.href)" aria-label="Copy Link">
        <svg viewBox="0 0 24 24"><path d="M19 2H9a2 2 0 00-2 2v2H5a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-2h2a2 2 0 002-2V4a2 2 0 00-2-2zM7 4h12v12H7V4z"/></svg>
      </button>

    </div>
  </div>
</div>

<style>
.custom-article-container {
  width: 100%;
  padding: 60px 20px 0px 20px;
  box-sizing: border-box;
}

/* FLEX TWO COLUMNS */
.custom-article-flex {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-bottom: 30px;
  align-items: center;
  flex-direction: column-reverse;
}
.custom-article-left, .custom-article-right {
  width: 48%;
}

.custom-article-left h1 {
  font-size: 32px;
  margin-bottom: 10px;
}

.article-excerpt {
  font-size: 18px;
  margin-bottom: 10px;
}

.article-meta {
  color: #666;
  font-size: 14px;
}

.custom-article-right img {
  width: 100%;
  height: auto;
  object-fit: cover;
}

/* POST CONTENT */
.custom-article-content {
  max-width: 700px;
  margin: 0 auto 30px auto;
  line-height: 1.7;
  font-size: 16px;
}

.custom-blogs-share.modern-share {
  text-align: center;
  margin: 40px auto 60px;
  font-family: sans-serif;
}

.custom-blogs-share.modern-share span {
  font-size: 16px;
  font-weight: bold;
  display: block;
  margin-bottom: 12px;
}

/* Flex grid for icons */
.share-icons-wrapper {
  display: inline-flex;
  gap: 18px;
  align-items: center;
  justify-content: center;
}

/* Circle icons */
.share-icons-wrapper a,
.share-icons-wrapper button {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: #222;       /* Dark background */
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.2s ease;
  border: none;
  cursor: pointer;
  overflow: hidden;
}

/* White icons */
.share-icons-wrapper svg {
  width: 20px;
  height: 20px;
  fill: #fff;
}

/* Hover effect: opacity */
.share-icons-wrapper a:hover,
.share-icons-wrapper button:hover {
  opacity: 0.7;
}

@media (max-width: 768px) {
  .custom-article-left, .custom-article-right {
    width: 100%;
    margin-bottom: 20px;
  }
}
/* ===== BLOG CONTENT STYLING ===== */
.custom-article-content {

  line-height: 1.7;
  color: #333;
  font-size: 16px;
}

.custom-article-content p {
  margin-bottom: 18px;
}

.custom-article-content p b {
  font-weight: 600;
}

.custom-article-content h2,
.custom-article-content h3,
.custom-article-content h4 {
  margin-top: 32px;
  margin-bottom: 12px;
  font-weight: 600;
  line-height: 1.3;
}

.custom-article-content h2 {
  font-size: 26px;
}

.custom-article-content h3 {
  font-size: 22px;
}

.custom-article-content ul {
  padding-left: 20px;
  margin-bottom: 10px;
  list-style:disc;
}

.custom-article-content li {
  margin-bottom: 0px;
}

.custom-article-content ul p {
  margin-bottom: 0 !important;
  margin-top: 0 !important;
}

/* ===== TABLE STYLING ===== */
.custom-article-content table {
  width: 100%;
  border-collapse: collapse;
  margin: 30px 0;
  font-size: 15px;
  overflow: hidden;
  border-radius: 10px;
}

.custom-article-content table thead {
  background: #f4f6f8;
}

.custom-article-content table th {
  text-align: left;
  padding: 14px;
  font-weight: 600;
  border-bottom: 2px solid #e5e7eb;
  background: #e5e7eb;
}

.custom-article-content table td {
  padding: 14px;
  border-bottom: 1px solid #e5e7eb;
  vertical-align: top;
  text-align: left; /* base fix */
}

.custom-article-content table tbody tr:nth-child(even) {
  background: #fafafa;
}

.custom-article-content table tbody tr:hover {
  background: #f1f5f9;
  transition: 0.2s ease;
}

/* ===== FORCE LEFT ALIGN (DESKTOP + MOBILE SAFETY) ===== */
.custom-article-content table td *,
.custom-article-content table th * {
  text-align: left !important;
}
.custom-article-flex:after
{
  content: " ";
  position: relative;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 50%;
  height: 1px;
  background: linear-gradient(to right, transparent, #4077ad, transparent);
  margin-top: 60px;
}
.custom-article-content a
{
  text-decoration:underline;
  color:#4077ad;
}
/* ===== RESPONSIVE SCROLLABLE TABLE ===== */
@media (max-width: 768px) {

  .custom-article-content table {
    display: block;
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .custom-article-content table thead {
    display: table-header-group; /* keep header visible */
  }

  .custom-article-content table tbody {
    display: table-row-group;
  }

  .custom-article-content table tr {
    display: table-row;
  }

  .custom-article-content table th,
  .custom-article-content table td {
    display: table-cell;
    white-space: nowrap; /* prevents breaking */
  }
}
@media(min-width:768px)
{
  .custom-article-flex {
    flex-direction: row;
  }
}
@media(min-width:1024px)
{
  .custom-article-left {
    padding-left: 40px;
    padding-right: 20px;
  }
  .custom-article-left h1 {
    font-size: 40px;
  }
}
@media(min-width:1280px)
{
  .custom-article-left {
    padding-left: 50px;
  }
  .custom-article-left h1 {
    font-size: 52px;
  }
}
@media(min-width:1660px)
{
  .custom-article-left {
    padding-right: 30px;
  }
  .custom-article-left h1 {
    font-size: 56px;
  }
}
</style>