      "id": "border_color",
      "label": "border color"
    },
    {
      "type": "select",
      "id": "image_mobile_style",
      "label": "Mobile style",
      "default": "fullscreen",
      "options": [
        {
          "value": "fullscreen",
          "label": "Fullscreen"
        },
        {
          "value": "container",
          "label": "Container"
        }
      ]
