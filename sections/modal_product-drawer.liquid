{%- render "modal_product-drawer" -%}
{% schema %}
{
  "name": "Product Drawer",
  "settings": [
    {
      "type": "text",
      "id": "close_icon",
      "label": "Close icon",
      "default": "x-mark"
    },
    {
      "type": "product",
      "id": "preview_product",
      "label": "Preview Product",
      "info": "Fallbacks to the first available product"
    },
    {
      "type": "checkbox",
      "id": "default_select_selling_plan",
      "label": "Set Subscription as default",
      "default": false
    },
    {
      "type": "paragraph",
      "content": "t:all.empty_char"
    },
    {
      "type": "header",
      "content": "Container Layout"
    },
    {
      "type": "text",
      "id": "flex_direction_align_x_align_y_gap_wrap",
      "label": "dir | justify | align | gap | wrap | min-h",
      "default": "column | stretch | stretch | 0 | nowrap",
      "info": "Direction accepts: 'row','column'. Alignment accepts: 'start, center, end, evenly, between'"
    },
    {
      "type": "text",
      "id": "padding_top_bottom_left_right",
      "label": "padding: top | bottom | left | right",
      "default": "0 | 0 | 0 | 0"
    },
    {
      "type": "text",
      "id": "width_height_border_width_radius",
      "label": "width | height | border | radius",
      "default": "100% | 75vh | 0 | 16px 16px 0 0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "background gradient"
    },
    {
      "type": "color",
