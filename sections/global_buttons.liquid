{%- render "global_buttons" -%}
{% schema %}
{
  "name": "Buttons",
  "settings": [],
  "blocks": [
    {
      "name": "Button",
      "type": "button",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "CSS Class name",
          "default": "button-primary",
          "info": "hyphens / lowercase / no-spaces [kebab-case](https://developer.mozilla.org/en-US/docs/Glossary/Kebab_case)"
        },
        {
          "type": "header",
          "content": "Colors"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "background color",
          "default": "#79EAA3"
        },
        {
          "type": "color_background",
          "id": "background_gradient",
          "label": "background gradient",
          "default": "linear-gradient(rgba(0, 0, 0, 0.0))"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "text color",
          "default": "#020e0e"
        },
        {
          "type": "color",
          "id": "border_color",
          "label": "border color",
          "default": "#020e0e"
        },
        {
          "type": "paragraph",
          "content": "t:all.empty_char"
        },
        {
          "type": "header",
          "content": "Hover Colors"
        },
        {
          "type": "color",
          "id": "hover_background_color",
          "label": "background color",
          "default": "#0a346e"
        },
        {
          "type": "color_background",
          "id": "hover_background_gradient",
          "label": "background gradient",
          "default": "linear-gradient(rgba(0, 0, 0, 0.0))"
        },
        {
          "type": "color",
          "id": "hover_text_color",
          "label": "text color",
          "default": "#f8fafa"
        },
        {
          "type": "color",
          "id": "hover_border_color",
          "label": "border color",
          "default": "#f8fafa"
        },
        {
          "type": "range",
          "id": "transition_duration",
          "label": "Transition duration",
          "default": 150,
          "min": 0,
          "max": 2000,
          "step": 50,
          "unit": "ms"
        },
        {
          "type": "paragraph",
          "content": "t:all.empty_char"
        },
        {
          "type": "header",
          "content": "Typography Settings"
        },
        {
          "type": "text",
          "id": "font_family",
          "label": "Font family",
          "default": "inherit"
        },
        {
          "type": "text",
          "id": "size_weight_height_opacity",
          "label": "size | weight | height | opacity",
          "default": "16px | 400 | 1.2 | 1"
        },
        {
          "type": "text",
          "id": "spacing_transform_style_whitespace",
          "label": "spacing | transform | style | wrap",
          "default": "0 | none | normal | nowrap"
        },
        {
          "type": "paragraph",
          "content": "t:all.empty_char"
        },
        {
          "type": "header",
          "content": "Spacing"
        },
        {
          "type": "text",
          "id": "padding_top_bottom_left_right_min_height",
          "label": "top | bottom | left | right | min-h",
          "default": "16/14 | 16/14 | 32/28 | 32/28 | 0"
        },
        {
          "type": "text",
          "id": "border_width_radius_shadow_gap_text_align",
          "label": "border | radius | shadow | gap|align",
          "default": "1px | 0 | 0 | 6px | center",
          "info": "Use 0-5 for Shadows"
        },
        {
          "type": "text",
          "id": "hover_radius_shadow_scale",
          "label": "Hover: radius | shadow | scale",
          "default": "4px | 0 | 100%",
          "info": "Shadows: Use 0-5 for shadows"
        },
        {
          "type": "textarea",
          "id": "custom_css",
          "label": "custom CSS",
          "default": "& {\n}"
        },
        {
          "type": "text",
          "id": "responsive_breakpoint",
          "label": "Responsive breakpoint",
          "default": "768px",
          "info": "Only adjust this for rare instances on large screen designs"
        },
        {
          "type": "checkbox",
          "id": "apply_container_queries",
          "label": "Apply container queries",
          "default": true,
          "info": "Create CSS for container queries. Use this for specific smaller styling in areas like the Cart Drawer and spaces where mobile styles should be applied on desktop views. This also enables the preview mode in the Theme editor."
        },
        {
          "type": "paragraph",
          "content": "t:all.empty_char"
        },
