<section class="steps-section" style="background-color: {{ section.settings.background_color }};">
  <div class="steps-container">

    {% if section.settings.heading != blank %}
      <h2 class="steps-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="steps-grid">

      <!-- STEP 1 -->
      <div class="step-item">
        <div class="step-number">1</div>
        <div class="step-content">{{ section.settings.step1_content }}</div>
      </div>

      <!-- STEP 2 -->
      <div class="step-item">
        <div class="step-number">2</div>
        <div class="step-content">{{ section.settings.step2_content }}</div>
      </div>

      <!-- STEP 3 -->
      <div class="step-item">
        <div class="step-number">3</div>
        <div class="step-content">{{ section.settings.step3_content }}</div>
      </div>

      <!-- Horizontal connecting line -->
      <div class="steps-line"></div>

    </div>
  </div>
</section>

<style>
.steps-section {
  padding: 48px 0;
}

.steps-container {
  max-width: 1440px;
  margin: 0 auto;
  padding: 0 20px;
  width: 100%;
}

.steps-heading {
  text-align: center;
  font-size: 28px;
  font-weight: 500;
  margin-bottom: 40px;
}

.steps-grid {
  display: flex;
  justify-content: space-between;
  position: relative;
  align-items: flex-start;
}

/* Horizontal connecting line */
.steps-line {
  position: absolute;
  top: 75px; /* center of 150px circle */
  left: calc(100% / 6); /* start at center of first circle */
  right: calc(100% / 6); /* end at center of last circle */
  height: 2px;
  background-color: #4077ad;
  z-index: 0;
}

/* STEP ITEM */
.step-item {
  text-align: center;
  position: relative;
  flex: 1;
  z-index: 1;
}

/* NUMBER CIRCLE */
.step-number {
  width: 150px;
  height: 150px;
  border-radius: 50%;
  border: 2px solid #4077ad;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 70px;
  color: #4077ad;
  margin: 0 auto 20px;
  background-color: #fff;
  z-index: 1;
}

/* STEP CONTENT */
.step-content {
  font-size: 16px;
  line-height: 1.7;
  text-align: center;
  font-weight:200;
}

/* H3 inside each step */
.step-content h3 {
  font-size: 20px;
  font-weight: 500;
  margin-bottom: 10px;
  line-height: 1.2;
}

/* MOBILE STACK */
@media screen and (max-width: 767px) {
  .steps-grid {
    flex-direction: column;
    gap: 40px;
  }

  .steps-line {
    display: none;
  }

  .steps-heading {
    font-size: 28px;
    margin-bottom: 40px;
  }

  .step-number {
    width: 100px;
    height: 100px;
    font-size: 50px;
  }

  
}
@media(min-width:768px)
{
  .steps-container
  {
    padding:0 48px;
  }
    .steps-heading {
    font-size: 40px;
    }
    .step-content h3 {
        font-size: 26px;
    }
    .step-content
    {
    padding:0 20px;
    }
}
@media(min-width:1024px)
{
    .step-content
    {
    padding:0 40px;
    }
}
</style>

{% schema %}
{
  "name": "3-Step Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How It Works"
    },
    {
      "type": "richtext",
      "id": "step1_content",
      "label": "Step 1 Content",
      "default": "<h3>Step One</h3><p>Describe the first step here.</p>"
    },
    {
      "type": "richtext",
      "id": "step2_content",
      "label": "Step 2 Content",
      "default": "<h3>Step Two</h3><p>Describe the second step here.</p>"
    },
    {
      "type": "richtext",
      "id": "step3_content",
      "label": "Step 3 Content",
      "default": "<h3>Step Three</h3><p>Describe the third step here.</p>"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "3-Step Section"
    }
  ]
}
{% endschema %}