
<section class="tailored-section-{{ section.id }}" id="{{ section.settings.custom_id }}">
  <div class="tailored-container">
    <div class="tailored-header">
      <span>{{ section.settings.top_subheading }}</span>
      <h2>{{ section.settings.top_heading }}</h2>
    </div>

    <div class="tailored-card">
      <div class="tailored-content">
        <span class="subtitle">{{ section.settings.card_subheading }}</span>
        <h3>{{ section.settings.card_heading }}</h3>
        <p>{{ section.settings.card_text }}</p>
        {% if section.settings.button_label != blank %}
          <a href="{{ section.settings.button_link }}" class="tailored-btn">{{ section.settings.button_label }}</a>
        {% endif %}
      </div>

      <div class="tailored-image">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy' }}
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>
    </div>
  </div>
</section>

{%- style -%}
  .tailored-section-{{ section.id }} {
    padding: 50px 20px;
    background-color: #ffffff;
  }

  .tailored-container {
    max-width: 1440px;
    margin: 0 auto;
  }

  .tailored-header {
    text-align: center;
    margin-bottom: 30px;
  }

  .tailored-header span {
    display: block;
    font-size: 12px;
    font-weight: 700;
    color: #3A6958;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 12px;
  }

  .tailored-header h2 {
    font-size: 36px;
    margin: 0;
    color:  #20221d;
    text-align: center;
    font-weight: 700;
    line-height: 44px;
  }

  .tailored-card {
    background-color: #f8f9f8;
    border-radius: 40px;
    display: flex;
    align-items: center;
    padding: 60px;
    /* gap: 40px; */
    overflow: hidden;
  }

  .tailored-content {
    flex: 1;
  }

  .tailored-content .subtitle {
    font-size: 14px;
    font-weight: 600;
    color: #3A6958;
    text-transform: uppercase;
    letter-spacing: 2.051px;
    margin-bottom: 15px;
    display: block;
  }

  .tailored-content h3 {
    font-size: 40px;
    font-weight: 500;
    color: #20221d;
    margin: 0 0 20px 0;
    line-height: 61px;
  }

  .tailored-content p {
    color: #555;
    margin-bottom: 35px;
    max-width: 82%;
    font-family: Poppins;
    font-size: 16px;
    font-style: normal;
    font-weight: 400;
    line-height: normal;
  }

  .tailored-btn {
    display: inline-block;
    padding: 10px 50px;
    border: 2.295px solid #3A6958;
    border-radius: 30px;
    color: #3A6958;
    text-decoration: none;
    font-weight: 600;
    font-size: 16px;
    transition: all 0.3s ease;
  }

  .tailored-btn:hover {
    background-color: #4a5d4e;
    color: #fff;
  }

  .tailored-image {
    border-radius: 30px;
    overflow: hidden;
    line-height: 0;
    flex: 0 0 55%;
    width: 55%;
  }

  .tailored-image img {
    width: 100%;
    height: 377px;
    object-fit: cover;
    display: block;
    border-radius: 30px;
  }

  

  @media (max-width: 768px) {
    .tailored-section-{{ section.id }} {
      padding: 30px 20px 10px;
    }
    .tailored-card {
      flex-direction: column;
      padding: 20px;
      text-align: center;
      border-radius: 24px;
      gap: 20px;
    }
    .tailored-image img {
      /* height: 270px; */
      height: auto;
      border-radius: 24px;
      object-fit: contain;
    }
    
    .tailored-image {
      width: 100%;
      order: -1; /* Image appears first on mobile if desired, or remove to keep below */
      border-radius: 24px;
    }
    .tailored-header span {
        font-size: 10px;
    }
    .tailored-content{
     text-align: left;
    }

    .tailored-header h2 {
      font-size: 24px;
      max-width: 70%;
      margin: 0 auto;
      line-height: 30px;
    }
    
    .tailored-content .subtitle {
      font-size: 11px;
      letter-spacing: 1.12px;
      text-align: left;
    }    
    .tailored-content h3 {
        font-size: 24px;
        line-height: 33.588px;
    }

    .tailored-content p {
      font-size: 13px;
      line-height: 21.341px;
      max-width: 100%;
    }
    .tailored-btn {
       font-size: 13px;
    }

  }
{%- endstyle -%}


{% schema %}
{
  "name": "Tailored Space",
  "settings": [
    {
      "type": "text",
      "id": "custom_id",
      "label": "Custom ID",
      "default": "customizations"
    },
    {
      "type": "header",
      "content": "Top Header"
    },
    {
      "type": "text",
      "id": "top_subheading",
      "label": "Top Sub-heading",
      "default": "CUSTOMIZATION OPTIONS"
    },
    {
      "type": "text",
      "id": "top_heading",
      "label": "Top Heading",
      "default": "Tailored to Your Space"
    },
    {
      "type": "header",
      "content": "Card Content"
    },
    {
      "type": "text",
      "id": "card_subheading",
      "label": "Card Sub-heading",
      "default": "ADJUSTABLE FOR ANY TERRAIN"
    },
    {
      "type": "text",
      "id": "card_heading",
      "label": "Card Heading",
      "default": "Uneven Ground"
    },
    {
      "type": "textarea",
      "id": "card_text",
      "label": "Card Description",
      "default": "Our adjustable post system handles slopes up to 48 inches. Perfect for hilly backyards, uneven surfaces, and elevated installations."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Card Image"
    }
  ],
  "presets": [
    {
      "name": "Tailored Space"
    }
  ]
}
{% endschema %}