{%- comment -%}
  Section: Comparison Table (A-DIY Stacks Up)
  - Brand column shows logo image
  - Mobile: Horizontal scroll, 2 columns visible at a time, bottom scrollbar
  - Desktop/Tablet: Standard table grid
{%- endcomment -%}

{% comment %} <section class="comparison-section" id="comparison-{{ section.id }}"> {% endcomment %}
<section class="comparison-section" id="{{ section.settings.custom_id }}">
  <div class="comparison-container">
    {%- if section.settings.eyebrow != blank -%}
      <p class="comparison-eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="comparison-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="comparison-subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="comparison-table-wrapper">
      <div class="comparison-scroll-none">
        <div class="comparison-table">
          {%- comment -%} Header Row {%- endcomment -%}
          <div class="comparison-row comparison-row--header">
            <div class="comparison-cell comparison-cell--label"></div>
            <div class="comparison-cell comparison-cell--highlight comparison-cell--highlight-top">
              {%- if section.settings.brand_logo != blank -%}
                {{ section.settings.brand_logo | image_url: width: 400 | image_tag:
                  loading: 'lazy',
                  widths: '120, 200, 300, 400',
                  sizes: '(max-width: 900px) 120px, 200px',
                  alt: section.settings.brand_logo.alt | default: 'Brand logo',
                  class: 'comparison-brand-logo'
                }}
              {%- else -%}
                <span class="comparison-brand-fallback">{{ section.settings.brand_name }}</span>
              {%- endif -%}
            </div>
            <div class="comparison-cell comparison-cell--header-text">{{ section.settings.col2_title }}</div>
            <div class="comparison-cell comparison-cell--header-text">{{ section.settings.col3_title }}</div>
          </div>

          {%- comment -%} Data Rows {%- endcomment -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'row' -%}
              <div class="comparison-row" {{ block.shopify_attributes }}>
                <div class="comparison-cell comparison-cell--label">
                  {{ block.settings.label }}
                </div>
                <div class="comparison-cell comparison-cell--highlight {% if forloop.last %}comparison-cell--highlight-bottom{% endif %}">
                  {{ block.settings.brand_value }}
                </div>
                <div class="comparison-cell">
                  {{ block.settings.col2_value }}
                </div>
                <div class="comparison-cell">
                  {{ block.settings.col3_value }}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>

  </div>
</section>

{%- style -%}
  #{{ section.settings.custom_id }} {
    --bg-color: {{ section.settings.bg_color }};
    --container-bg: {{ section.settings.container_bg }};
    --highlight-bg: {{ section.settings.highlight_bg }};
    --highlight-text: {{ section.settings.highlight_text }};
    --label-color: {{ section.settings.label_color }};
    --value-color: {{ section.settings.value_color }};
    --heading-color: {{ section.settings.heading_color }};
    --eyebrow-color: {{ section.settings.eyebrow_color }};
    --subheading-color: {{ section.settings.subheading_color }};
    --divider-color: {{ section.settings.divider_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<style>
  .comparison-section {
    background-color: var(--bg-color, #ffffff);
    width: 100%;
    box-sizing: border-box;
  }

  .comparison-section *,
  .comparison-section *::before,
  .comparison-section *::after {
    box-sizing: border-box;
  }

  .comparison-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 20px 20px;
    text-align: center;
  }

  .comparison-eyebrow {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--eyebrow-color, #6b7280);
    margin: 0 0 14px;
  }

  .comparison-heading {
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 500;
    line-height: 1.15;
    color: var(--heading-color, #111827);
    margin: 0 0 14px;
  }

  .comparison-subheading {
    font-size: 16px;
    font-weight: 400;
    color: var(--subheading-color, #6b7280);
    margin: 0 auto 40px;
    max-width: 620px;
    line-height: 1.5;
  }

  /* ============ TABLE ============ */
  .comparison-table-wrapper {
    background-color: var(--container-bg, #f3f4f0);
    border-radius: 47px;
    padding: 0px 24px;
    text-align: left;
    overflow: hidden; /* keep rounded corners clipping the scroll area */
  }

  .comparison-scroll {
    width: 100%;
  }

  .comparison-table {
    display: grid;
    width: 100%;
  }

  .comparison-row {
    display: grid;
    grid-template-columns: 1.2fr 1.4fr 1.4fr 1.4fr;
    align-items: stretch;
    {% comment %} border-bottom: 1px solid var(--divider-color, #e0ddd4); {% endcomment %}
  }

  .comparison-row:last-child {
    border-bottom: none;
  }

  .comparison-cell {
    padding: 22px 18px;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.4;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--value-color, #1f2937);
  }

  .comparison-cell--label {
    color: var(--label-color, #374151);
    font-weight: 600;
    justify-content: flex-start;
    text-align: left;
  }

  .comparison-cell--header-text {
    color: var(--label-color, #374151);
    font-weight: 600;
    font-size: 16px;
  }

  .comparison-cell--highlight {
    background-color: var(--highlight-bg, #335c44);
    color: var(--highlight-text, #ffffff);
    font-weight: 400;
  }

  .comparison-cell--highlight-top {
    padding-top: 28px;
    padding-bottom: 28px;
  }

  .comparison-row--header .comparison-cell {
    padding-top: 26px;
    padding-bottom: 26px;
  }

  .comparison-brand-logo {
    max-width: 160px;
    max-height: 70px;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .comparison-brand-fallback {
    font-size: 26px;
    font-weight: 700;
    font-style: italic;
    letter-spacing: 0.5px;
    color: var(--highlight-text, #ffffff);
  }

  /* Tablet */
  @media (max-width: 900px) {
    .comparison-table-wrapper {
      padding: 0px 18px;
      border-radius: 32px;
    }

    .comparison-row {
      grid-template-columns: 1.1fr 1.3fr 1.3fr 1.3fr;
    }

    .comparison-cell {
      padding: 18px 12px;
      font-size: 14px;
    }

    .comparison-cell--header-text {
      font-size: 14px;
    }

    .comparison-brand-logo {
      max-width: 120px;
      max-height: 55px;
    }

    .comparison-brand-fallback {
      font-size: 22px;
    }
  }

  /* ============ MOBILE: Horizontal scroll, 2 columns visible ============ */
  @media (max-width: 640px) {
    .comparison-container {
      padding: 0 16px;
    }
    .comparison-eyebrow {
      font-size: 10px;
    }

    .comparison-heading {
      font-size: 26px;
    }

    .comparison-subheading {
      font-size: 11px;
      margin-bottom: 28px;
    }

    .comparison-table-wrapper {
      padding: 0;
      border-radius: 24px;
      overflow: hidden;
    }

    /* Enable horizontal scroll */
    .comparison-scroll {
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x proximity;
      scroll-behavior: smooth;
      padding-bottom: 14px; /* room for scrollbar */
      /* Firefox scrollbar */
      scrollbar-width: thin;
      scrollbar-color: var(--highlight-bg, #335c44) rgba(0, 0, 0, 0.08);
    }

    /* WebKit (Chrome, Safari, Edge) styled scrollbar */
    .comparison-scroll::-webkit-scrollbar {
      height: 6px;
      -webkit-appearance: none;
    }

    .comparison-scroll::-webkit-scrollbar-track {
      background: rgba(0, 0, 0, 0.08);
      border-radius: 10px;
      margin: 0 18px;
    }

    .comparison-scroll::-webkit-scrollbar-thumb {
      background: var(--highlight-bg, #335c44);
      border-radius: 10px;
    }

    .comparison-scroll::-webkit-scrollbar-thumb:hover {
      background: var(--highlight-bg, #335c44);
      opacity: 0.85;
    }

    /* Force table wider so 4 columns = 2 visible at a time */
    .comparison-table {
      min-width: 100%;
    }

    .comparison-row {
      grid-template-columns: 1.1fr 1.3fr 1.3fr 1.3fr;
      width: 100%;
    }

    /* Snap each cell so scroll lands cleanly */
    .comparison-cell {
      scroll-snap-align: start;
      padding: 16px 12px;
      font-size: 11px;
    }

    .comparison-row--header .comparison-cell {
      padding-top: 22px;
      padding-bottom: 22px;
    }

    .comparison-cell--header-text {
      font-size: 12px;
    }

    .comparison-cell--highlight-top {
      padding-top: 22px;
      padding-bottom: 22px;
    }

    .comparison-brand-logo {
      max-width: 110px;
      max-height: 50px;
    }

    .comparison-brand-fallback {
      font-size: 20px;
    }
  }
</style>

{% schema %}
{
  "name": "New Comparison Table",
  "tag": "section",
  "class": "section-comparison-table",
  "settings": [
    {
      "type": "text",
      "id": "custom_id",
      "label": "Custom ID",
      "default": "compare"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "WHY CHOOSE A-DIY?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See How A-DIY Stacks Up"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Compare the real cost, time, and experience of building your deck."
    },
    {
      "type": "header",
      "content": "Brand Column (Highlighted)"
    },
    {
      "type": "image_picker",
      "id": "brand_logo",
      "label": "Brand logo image",
      "info": "Recommended: PNG with transparent background. Will display on dark green column."
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name (fallback if no logo uploaded)",
      "default": "A-DIY"
    },
    {
      "type": "header",
      "content": "Other Column Titles"
    },
    {
      "type": "text",
      "id": "col2_title",
      "label": "Column 2 title",
      "default": "Contractor"
    },
    {
      "type": "text",
      "id": "col3_title",
      "label": "Column 3 title",
      "default": "DIYer"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "container_bg",
      "label": "Table container background",
      "default": "#f3f4f0"
    },
    {
      "type": "color",
      "id": "highlight_bg",
      "label": "Highlight column background",
      "default": "#335c44"
    },
    {
      "type": "color",
      "id": "highlight_text",
      "label": "Highlight column text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#6b7280"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#6b7280"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Row label color",
      "default": "#374151"
    },
    {
      "type": "color",
      "id": "value_color",
      "label": "Cell value color",
      "default": "#1f2937"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Row divider color",
      "default": "#e0ddd4"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 70
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison Row",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Row label",
          "default": "Cost"
        },
        {
          "type": "text",
          "id": "brand_value",
          "label": "Brand column value (highlighted)",
          "default": "One Simple Price"
        },
        {
          "type": "text",
          "id": "col2_value",
          "label": "Column 2 value",
          "default": "High + unpredictable"
        },
        {
          "type": "text",
          "id": "col3_value",
          "label": "Column 3 value",
          "default": "Hard to predict"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "New Comparison Table",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "label": "Cost",
            "brand_value": "One Simple Price",
            "col2_value": "High + unpredictable",
            "col3_value": "Hard to predict"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Time Required",
            "brand_value": "Hours",
            "col2_value": "Weeks",
            "col3_value": "Weekends or more"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Who builds it?",
            "brand_value": "You, with zero experience",
            "col2_value": "Who knows",
            "col3_value": "You (must have skills)"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "How it's built?",
            "brand_value": "Pieces snap together",
            "col2_value": "Built on site using tools + labor",
            "col3_value": "You cut, measure and build everything"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Quality guarantee",
            "brand_value": "Consistent, Engineered",
            "col2_value": "Builder dependent",
            "col3_value": "Still dependent"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Overall Experience",
            "brand_value": "Empowering",
            "col2_value": "Stressful",
            "col3_value": "Overwhelming"
          }
        }
      ]
    }
  ]
}
{% endschema %}