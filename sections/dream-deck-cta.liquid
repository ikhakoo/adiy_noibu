{%- liquid
  assign section_id = 'dream-deck-cta-' | append: section.id
-%}
{%- liquid
  assign s = section.settings
-%}
{%- assign final_video_url = section.settings.video_file | default: section.settings.video_url -%}

{%- if section.settings.video_file != blank -%}
  {%- assign final_video_url = section.settings.video_file.sources[0].url -%}
{%- endif -%}

<style>
  {%- if s.mobile_only -%}
       @media screen and (max-width: 767px) {
      #shopify-section-{{ section.id }} {
        display: none !important;
      }
    }
  {%- endif -%}
  {%- if s.desktop_only -%}
       @media screen and (min-width: 768px) {
       #shopify-section-{{ section.id }} {
        display: none !important;
      }
    }
  {%- endif -%}
</style>

<section
  id="{{ section.settings.custom_id }}"
  class="ddc-section"
  style="
    --ddc-bg: {{ section.settings.bg_color }};
    --ddc-title: {{ section.settings.title_color }};
    --ddc-subtitle: {{ section.settings.subtitle_color }};
    --ddc-feature: {{ section.settings.feature_color }};
    --ddc-btn-primary-bg: {{ section.settings.btn_primary_bg }};
    --ddc-btn-primary-text: {{ section.settings.btn_primary_text }};
    --ddc-btn-secondary-border: {{ section.settings.btn_secondary_border }};
    --ddc-btn-secondary-text: {{ section.settings.btn_secondary_text }};
    --ddc-btn-secondary-hover-bg: {{ section.settings.btn_secondary_hover_bg }};
    --ddc-btn-secondary-hover-text: {{ section.settings.btn_secondary_hover_text }};
    --ddc-pt-d: {{ section.settings.padding_top }}px;
    --ddc-pb-d: {{ section.settings.padding_bottom }}px;
    --ddc-pt-m: {{ section.settings.padding_top_mobile }}px;
    --ddc-pb-m: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="ddc-container">

    {%- if section.settings.heading != blank -%}
      <h2 class="ddc-title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="ddc-subtitle">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if final_video_url != blank -%}
      <div class="ddc-video-container">
        {%- if section.settings.video_file != blank -%}
          <video 
            src="{{ final_video_url }}" 
            class="ddc-video-box" 
            controls 
            playsinline 
            muted 
            autoplay 
            loop>
          </video>
        {%- else -%}
          {%- if section.settings.video_url.type == 'youtube' -%}
            <iframe src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=1&mute=1" class="ddc-video-box" frameborder="0" allowfullscreen></iframe>
          {%- elsif section.settings.video_url.type == 'vimeo' -%}
            <iframe src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1&muted=1" class="ddc-video-box" frameborder="0" allowfullscreen></iframe>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- assign button_blocks = section.blocks | where: 'type', 'button' -%}
    {%- assign feature_blocks = section.blocks | where: 'type', 'feature' -%}

    {%- if button_blocks.size > 0 -%}
      <div class="ddc-buttons aa">
        {%- for block in button_blocks -%}
          {%- liquid
            assign btn_class = 'ddc-btn ddc-btn--' | append: block.settings.style
            assign btn_link = block.settings.link | default: '#'
            
            # If popup is enabled, override the link and add the trigger class
            if block.settings.open_in_popup
              assign btn_class = btn_class | append: ' js-video-trigger'
              assign btn_link = 'javascript:void(0)'
            endif
          -%}

          <a
            href="{{ btn_link }}"
            class="{{ btn_class }}"
            {% if block.settings.open_in_popup %}data-video-url="{{ final_video_url }}"{% endif %}
            {% if block.settings.open_new_tab and block.settings.open_in_popup == false %}target="_blank"{% endif %}
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.show_icon -%}
              <svg class="ddc-btn__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M8 5v14l11-7z"/>
              </svg>
            {%- endif -%}
            <span>{{ block.settings.label }}</span>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if feature_blocks.size > 0 -%}
      <ul class="ddc-features">
        {%- for block in feature_blocks -%}
          <li class="ddc-features__item" {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}
  .ddc-section {
    background: var(--ddc-bg, #3d6b5a);
    padding: var(--ddc-pt-d, 70px) 0 var(--ddc-pb-d, 70px);
    font-family: "Poppins", system-ui, -apple-system, sans-serif;
  }

  .ddc-container {
    /* max-width: 900px; */
    max-width: 70%;
    margin: 0 auto;
    padding: 0 24px;
    text-align: center;
  }

  /* Video Styling */
  .ddc-video-container {
    position: relative;
    width: 100%;
    /* max-width: 700px; */
    margin: 0 auto 35px;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
  }
  
  .ddc-video-box {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Heading */
  .ddc-title {
    font-size: clamp(20px, 3.2vw, 40px);
    font-weight: 500;
    line-height: 50px;
    color: var(--ddc-title, #ffffff);
    margin: 17px;
    font-family: "Poppins";
  }

  /* Subtitle */
  .ddc-subtitle {
    font-size: clamp(14px, 1.05vw, 20px);
    line-height: 1.65;
    color: var(--ddc-subtitle, rgba(255,255,255,0.85));
    margin: 0 auto 32px;
    font-weight: 400;
    font-family: "Poppins";
  }

  /* Buttons wrapper */
  .ddc-buttons {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }

  /* Base button */
  .ddc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 17px 30px 17px 30px;
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 999px;
    transition: all 0.25s ease;
    cursor: pointer;
    line-height: 1;
    min-height: 56px;
    min-width:260px ;
    font-family: "Poppins";
    border: 2px solid transparent;
    white-space: nowrap;
  }

  .ddc-btn__icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  /* Primary (filled white) */
  .ddc-btn--primary {
    background: var(--ddc-btn-primary-bg, #ffffff);
    color: var(--ddc-btn-primary-text, #3d6b5a);
    border-color: var(--ddc-btn-primary-bg, #ffffff);
  }

  .ddc-btn--primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.15);
  }

  /* Secondary (outlined) */
  .ddc-btn--secondary {
    background: transparent;
    color: var(--ddc-btn-secondary-text, #ffffff);
    border-color: var(--ddc-btn-secondary-border, #ffffff);
  }

  .ddc-btn--secondary:hover {
    background: var(--ddc-btn-secondary-hover-bg, #ffffff);
    color: var(--ddc-btn-secondary-hover-text, #3d6b5a);
    transform: translateY(-2px);
  }

  /* Features list */
  .ddc-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 18px;
  }

  .ddc-features__item {
    font-size: 12px;
    color: var(--ddc-feature, rgba(255,255,255,0.9));
    font-weight: 500;
    position: relative;
    padding-right: 15px;
    font-family: 'Poppins';
  }

  .ddc-features__item:not(:last-child)::after {
    content: "•";
    position: absolute;
    right: -7px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--ddc-feature, rgba(255,255,255,0.6));
    font-size: 14px;
  }
  .ddc-hide-desktop { display: none !important; }
  .ddc-hide-mobile { display: none !important; }

  
  @media (min-width: 769px) { 
    .ddc-hide-desktop { display: block !important; } 
  }
  
  /* Tablet */
  @media (max-width: 768px) {
    .ddc-container {max-width: 100%; padding: 0 20px; }
    .ddc-buttons { gap: 14px; }
    .ddc-btn { padding: 13px 30px; }
    .ddc-hide-mobile { display: block !important; }
  }

  /* Mobile */
  @media (max-width: 600px) {
    .ddc-section {
      padding: var(--ddc-pt-m, 50px) 0 var(--ddc-pb-m, 50px);
    }
    .ddc-container { padding: 0 20px; }

    .ddc-title { 
      max-width: 100%;
      margin: 0 auto;
      line-height: 27px;
      margin-bottom: 14px;
    }
    .ddc-subtitle { margin-bottom: 26px; font-size: 14px; }

    .ddc-buttons {
      flex-direction: column;
      gap: 12px;
      margin-bottom: 24px;
    }
    .ddc-btn {
      width: 100%;
      max-width: 380px;
      padding: 14px 24px;
    }

    .ddc-features {
      flex-direction: column;
      gap: 10px;
      display: none;
    }
    .ddc-features__item {
      padding-right: 0;
      font-size: 13px;
    }
    .ddc-features__item:not(:last-child)::after {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Dream Deck CTA",
  "tag": "section",
  "class": "section-dream-deck-cta",
  "settings": [
    {
      "type": "text",
      "id": "custom_id",
      "label": "Custom ID",
      "default": "installation"
    },
    {
      "type": "header",
      "content": "Content"
    },
     {
      "type": "checkbox",
      "id": "mobile_only",
      "label": "Show on Mobile Only",
      "info": "Tick this to hide the section on Desktop devices.",
      "default": false
    },
     {
      "type": "checkbox",
      "id": "desktop_only",
      "label": "Show on desktop_Only",
      "info": "Tick this to hide the section on mobile devices.",
      "default": false
    },
   
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to Build Your Dream Deck?"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "A-DIY's deck kits include All engineered lumber parts, Screws, Drill bit, Deck blocks. The only additional item you need is a residential power drill for securing the screws."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#3d6b5a"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subheading color",
      "default": "#dce8e2"
    },
    {
      "type": "color",
      "id": "feature_color",
      "label": "Feature text color",
      "default": "#dce8e2"
    },
    {
      "type": "header",
      "content": "Primary Button (filled)"
    },
    {
      "type": "color",
      "id": "btn_primary_bg",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_primary_text",
      "label": "Text color",
      "default": "#3d6b5a"
    },
    {
      "type": "header",
      "content": "Secondary Button (outlined)"
    },
    {
      "type": "color",
      "id": "btn_secondary_border",
      "label": "Border color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_secondary_text",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_secondary_hover_bg",
      "label": "Hover background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_secondary_hover_text",
      "label": "Hover text",
      "default": "#3d6b5a"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Show on Desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on Mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Video Settings"
    },
    {
      "type": "video",
      "id": "video_file",
      "label": "Shopify Hosted Video"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "External Video URL",
      "accept": ["youtube", "vimeo"]
    }
  ],
  "blocks": [
    {
      "type": "button",
      "name": "Button",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Watch Video"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "primary", "label": "Filled (Primary)" },
            { "value": "secondary", "label": "Outlined (Secondary)" }
          ],
          "default": "primary"
        },
        {
          "type": "checkbox",
          "id": "open_in_popup",
          "label": "Open video in popup",
          "info": "Requires separate theme JavaScript setup to work",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_icon",
          "label": "Show play icon (filled style only)",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "open_new_tab",
          "label": "Open in new tab",
          "default": false
        }
      ]
    },
    {
      "type": "feature",
      "name": "Feature Badge",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "25-Year Warranty"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Dream Deck CTA",
      "blocks": [
        {
          "type": "button",
          "settings": {
            "label": "Watch Video",
            "style": "primary",
            "show_icon": false
          }
        },
        {
          "type": "button",
          "settings": {
            "label": "Chat With Consultant",
            "style": "secondary"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "25-Year Warranty"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Free Shipping"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "0% Financing"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Hassle-Free Returns"
          }
        }
      ]
    }
  ]
}
{% endschema %}