{% comment %}
This file is auto-generated by PageFly. The content can be overridden when publish page in PageFly. Please do not update this file directly.
If you plan to remove PageFly, please see the guide in our help center first: https://help.pagefly.io/.
{% endcomment %}
{%- capture contentForQuerystring -%}{%- if tinyscript -%}{{ content_for_header }}{%- else -%}{% render 'tiny-script-control' %}{%- endif -%}{%- endcapture -%}
{%- assign query_params = contentForQuerystring | split: '"pageurl":"' | last | split: '"' | first | replace: '\/', '/' | replace: '%20', ' ' | replace: '\u0026', '&' | split: "?" | last -%}
{% if request.path == '/collections' %}
  {% if query_params contains '__modals_data=true' %}
    <div data-modals-section>{% sections '0_modal' %}</div>
    <div data-cards-section>{% sections '0_card' %}</div>
    {{ content }}
    {% break %}
  {% endif %}
{% endif %}
{% if query_params contains 'barba_prefetch=true' %}
  {% if theme.role != 'main' %}
    {% assign dynamic_prefetch = true %}
  {% endif %}
{% endif %}

<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head> 
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible"
        content="IE=edge">
  <meta name="viewport"
        content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="color-scheme" content="light only">
  {%- render "_layout.seo" -%}
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,100..900;1,100..900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" as="style">
    <!-- avoiding chrome force dark mode -->
  <script>
    var isDarkMode = window.matchMedia('(prefers-color-scheme: dark)').matches;
    if (isDarkMode) {
      document.write(`<meta name="color-scheme" content="dark Only"><\/meta>`);
    }
  </script>
  <script async="" src="https://cdn1.affirm.com/js/v2/affirm.js"></script>
  <style>
    :root {
      color-scheme: light only;
    }
  </style>

  {% if dynamic_prefetch != true %}
    {%- render "_layout.imports" -%}
    {%- render "_layout.dynamic-imports" -%}
    {%- render "_layout.library-imports" -%}
    {%- render "_layout.translations" -%}
    {%- render "_layout.global-layout" -%}
    {%- render "_layout.global-colors" -%}
    {%- render "_layout.global-settings" -%}

  {% if theme.role == 'main' or request.path contains '/account' or request.visual_preview_mode %}
    {%- if tinyscript -%}{{ content_for_header }}{%- else -%}{% render 'tiny-script-control' %}{%- endif -%}
  {% elsif settings.development__block_content_for_header %}
    <script>var Shopify = Shopify || {};
      Shopify.shop = "{{ shop.permanent_domain }}";
      Shopify.theme = {
        "name": "{{ theme.name }}",
        "id": {{ theme.id }},
        "theme_store_id": null,
        "role": "{{ theme.role }}",
      };
      Shopify.routes = Shopify.routes || {};
      Shopify.routes.root = "/";</script>
  {% elsif settings.development__block_app_scripts %}
    {% capture _content_for_header %}{%- if tinyscript -%}{{ content_for_header }}{%- else -%}{% render 'tiny-script-control' %}{%- endif -%}{% endcapture %}
    {{ _content_for_header | split: "<script>(function() {" | first }}
    {% assign parts = _content_for_header | split: "<script>(function() {" | last | replace_first: "</script>", "|~|SPLIT|~|" | split: "|~|SPLIT|~|" %}
    <script type="accelerate/blocked">(function() { {{ parts | first }}</script>
    {{ parts | last }}
  {% else %}
    {%- if tinyscript -%}{{ content_for_header }}{%- else -%}{% render 'tiny-script-control' %}{%- endif -%}
  {% endif %}

  {% if theme.role != 'main' and request.design_mode != true and settings.development__enable_marker_io and settings.development__marker_io_id != blank and request.visual_preview_mode != true %}
    <script>
      if (!window.location.origin.includes("127.0.0.1")) {
        window.markerConfig = {
          project: '{{ settings.development__marker_io_id }}',
          source: 'snippet',
        };

        !function (e, r, a) {
          if (!e.__Marker) {
            e.__Marker = {};
            var t = [], n = { __cs: t };
            ["show", "hide", "isVisible", "capture", "cancelCapture", "unload", "reload", "isExtensionInstalled", "setReporter", "setCustomData", "on", "off"].forEach(function (e) {
              n[e] = function () {
                var r = Array.prototype.slice.call(arguments);
                r.unshift(e), t.push(r);
              };
            }), e.Marker = n;
            var s = r.createElement("script");
            s.async = 1, s.src = "https://edge.marker.io/latest/shim.js";
            var i = r.getElementsByTagName("script")[0];
            i.parentNode.insertBefore(s, i);
          }
        }(window, document);
      }
    </script>
  {% endif %}

  {%- if customer.has_account -%}
  {%- case request.path -%}
  {%- when "/account/register" -%}
    <script>
      window.location.href = `{{ request.origin }}{{ routes.account_url }}`;
    </script>
  {%- when "/account/register" -%}
    <script>
      window.location.href = `{{ request.origin }}{{ routes.account_url }}`;
    </script>
  {%- when "/account/login" -%}
    <script>
      window.location.href = `{{ request.origin }}{{ routes.account_url }}`;
    </script>
  {%- when "/cart" -%}
    <script>
      window.location.href = `{{ request.origin }}{{ routes.root_url }}`;
    </script>
  {%- endcase -%}
  {%- endif -%}
    <script>
      document.documentElement.style.setProperty(
        "--scrollbar-width",
        `${window.innerWidth - document.documentElement.clientWidth}px`,
      );

      {% render '_utils.request-idle-callback' %}
    </script>
    {% render '_layout.scripts' %}
  {% endif %}
  <!-- TrustBox script -->
    <script type="text/javascript" src="//widget.trustpilot.com/bootstrap/v5/tp.widget.bootstrap.min.js" async></script>
  <!-- End TrustBox script -->

  <script type="text/javascript"> (function(c,l,a,r,i,t,y){ c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)}; t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i; y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y); })(window, document, "clarity", "script", "sv0fd0hbr4"); </script>
  <meta name="google-site-verification" content="s4JOkYRmC3vfw-AxyKxRrRfaloyoha9Bu0_8GiitTm4" />
{% include 'pagefly-app-header' %}</head>

<body id="shopify-override"
      class="relative flex min-h-screen flex-col overscroll-none {{ settings.color__color_scheme }}"
      data-barba="wrapper"><div class="pagefly-container">
              {{ content_for_layout }}
            </div></body>
</html>



