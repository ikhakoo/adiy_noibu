        "type": "header",
        "content": "Container Margin Spacing"
      },
      {
        "type": "range",
        "id": "layout__page_gutter_desktop",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 36,
        "unit": "px",
        "label": "Desktop"
      },
      {
        "type": "range",
        "id": "layout__page_gutter_mobile",
        "min": 0,
        "max": 100,
        "step": 1,
        "default": 20,
        "unit": "px",
        "label": "Mobile"
