 gravel, concrete, slope), and what you want to use the space for. Our specialists will provide a clear kit recommendation and a list of any site prep required. It takes about 20 minutes and costs nothing.<\/p>","page_content":"","accordion_class":"accordion","default_state":"closed","margin_top_bottom_left_right":"0 | 24px | 0 | 0","max_w_flex_col_row_order_align":"905px | unset | 1 | 1 | unset | left","responsive_visibility":"","hide_if_empty":"none","responsive_breakpoint":"768px","anchor_id":""}},"collapsible_HrYWCC":{"type":"collapsible","settings":{"label":"<strong>How does financing work?<\/strong>","content":"<p>We offer flexible payment plans starting at $0 down with 0% interest for up to 24 months, subject to credit approval. You can apply at checkout in a few minutes. Financing terms and conditions apply, and approval is based on your credit profile.<\/p>","page_content":"","accordion_class":"accordion","default_state":"closed","margin_top_bottom_left_right":"0 | 24px | 0 | 0","max_w_flex_col_row_order_align":"905px | unset | 1 | 1 | unset | left","responsive_visibility":"","hide_if_empty":"none","responsive_breakpoint":"768px","anchor_id":""}}},"block_order":["richtext_zEPG48","collapsible_bwtd3k","collapsible_FhpDi8","collapsible_Ji9w8f","collapsible_xRCEmR","collapsible_HrYWCC"],"name":"FAQ - 2","settings":{"flex_row_wrap_align_x_align_y_gap":"center | center | 0","padding_top_bottom_left_right":"0 | 0 | 0 | 0","margin_top_bottom_left_right":"0 | 0 | 0 | 0","border_width_radius":"0 | 0 |  |  |","background_color":"","border_color":"","section_id":"","color_scheme":"scheme-3774668d-6fb4-4211-94f3-548d80111de5","container_spacing":"px-container-sm","border_divider":"border-y-none","top_bottom_min_height":"64px\/40px | 64px\/40px | 0","responsive_visibility":"","responsive_breakpoint":"768px","target_visibility":"","render_tabs_async":false}},"media_with_text_TpiXUY":{"type":"media-with-text","blocks":{"image_iK3MDJ":{"type":"image","settings":{"desktop_i