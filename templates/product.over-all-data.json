        "custom_liquid_6Fm9cH": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- comment -%}\n  Star rating badge (clickable)\n  Paste into a \"Custom Liquid\" block. Edit the values below.\n\n  SIZE: the whole badge scales from one number, --sr-size (set on .sr-badge).\n  Everything else is in em, so this single value controls the entire badge.\n    18px = original (too big for most placements)\n    11px = roughly half  <-- current default\n    7px  = roughly one third\n\n  LINK: the entire badge is a link that opens sr_url in a new tab.\n{%- endcomment -%}\n\n{%- assign sr_rating  = '4.8' -%}\n{%- assign sr_out_of  = '5' -%}\n{%- assign sr_count   = '1746' -%}\n{%- assign sr_url     = 'https://a-diy.com/pages/reviews' -%}\n\n<a class=\"sr-badge\"\n   href=\"{{ sr_url }}\"\n   target=\"_blank\"\n   rel=\"noopener noreferrer\"\n   aria-label=\"Rated {{ sr_rating }} out of {{ sr_out_of }} stars from {{ sr_count }} reviews. Read the reviews.\"\n   style=\"--sr-size:11px;\">\n  <span class=\"sr-badge__stars\" aria-hidden=\"true\">\n    {%- for i in (1..5) -%}\n      <span class=\"sr-badge__tile\">\n        <svg viewBox=\"0 0 24 24\" class=\"sr-badge__star\" focusable=\"false\">\n          <path d=\"M12 2.5l2.9 5.88 6.49.94-4.7 4.58 1.11 6.46L12 17.9l-5.8 3.05 1.11-6.46-4.7-4.58 6.49-.94L12 2.5z\"/>\n        </svg>\n      </span>\n    {%- endfor -%}\n  </span>\n  <span class=\"sr-badge__text\">\n    <span class=\"sr-badge__score\">{{ sr_rating }} / {{ sr_out_of }} stars</span>\n    <span class=\"sr-badge__count\">{{ sr_count }} reviews</span>\n  </span>\n</a>\n\n<style>\n  a.sr-badge {\n    font-size: var(--sr-size, 11px);\n    display: inline-flex;\n    align-items: center;\n    gap: 0.67em;\n    flex-wrap: wrap;\n    text-decoration: none;\n    cursor: pointer;\n    border-radius: 0.3em;\n    transition: opacity 0.15s ease;\n  }\n  a.sr-badge:hover { opacity: 0.85; }\n  a.sr-badge:focus-visible {\n    outline: 2px solid #00b67a;\n    outline-offset: 3px;\n  }\n  .sr-badge__stars {\n    display: inline-flex;\n    gap: 0.17em;\n  }\n  .sr-badge__tile {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    width: 1.9em;\n    height: 1.9em;\n    background: #00b67a;\n    border-radius: 0.22em;\n  }\n  .sr-badge__star {\n    width: 1.33em;\n    height: 1.33em;\n    fill: #ffffff;\n  }\n  .sr-badge__text {\n    margin: 0;\n    font-size: 1em;\n    line-height: 1.2;\n    white-space: nowrap;\n  }\n  .sr-badge__score {\n    font-weight: 700;\n    color: #191919;\n  }\n  .sr-badge__count {\n    font-weight: 400;\n    color: #6a6a6a;\n    margin-left: 0.33em;\n  }\n\n  @media (max-width: 480px) {\n    .sr-badge__text { white-space: normal; }\n  }\n</style>",
