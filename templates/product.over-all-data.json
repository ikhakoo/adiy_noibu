        "faq_item_4hCJkb": {
          "type": "faq_item",
          "settings": {
            "tab_number": "1",
            "question": "What makes A-DIY different from traditional deck building?",
            "answer": "<p>A-DIY systems are engineered for fast, tool-free assembly without compromising structural integrity.</p>"
          }
        },
        "faq_item_W4kiNm": {
          "type": "faq_item",
          "settings": {
            "tab_number": "1",
            "question": "Do I need special tools or experience?",
            "answer": "<p>No special tools or prior experience is required. Every kit includes step-by-step instructions.</p>"
          }
        },
        "faq_item_GxrrkD": {
          "type": "faq_item",
          "settings": {
            "tab_number": "1",
            "question": "How long does it take to build?",
            "answer": "<p>Most standard deck kits can be assembled in a single weekend — typically 8–16 hours.</p>"
          }
        },
        "faq_item_NVPtbw": {
          "type": "faq_item",
          "settings": {
            "tab_number": "1",
            "question": "What if I have uneven ground or a slope?",
            "answer": "<p>Our adjustable pedestal feet accommodate slopes up to 15°. For steeper grades, contact our support team.</p>"
          }
        },
        "faq_item_dN9TA4": {
          "type": "faq_item",
          "settings": {
            "tab_number": "1",
