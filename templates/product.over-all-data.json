        "custom_liquid_wR8Wtt": {
          "type": "custom_liquid",
          "disabled": true,
          "settings": {
            "custom_liquid": "{%- comment -%}\n  Countdown banner\n  Paste this whole block into a \"Custom Liquid\" section/block on the product page.\n  Edit the values in the assign block below. Nothing else needs touching.\n\n  Deadline format: 'YYYY-MM-DDTHH:MM:SS' followed by your timezone offset.\n  Examples: '2026-07-15T23:59:59-04:00' (Eastern, EDT) or '2026-07-15T23:59:59Z' (UTC).\n  Set it in the timezone you want the sale to end in, or the math will drift.\n{%- endcomment -%}\n\n{%- assign cd_heading    = 'July 4th Sale' -%}\n{%- assign cd_subtext    = 'Save $1000.' -%}\n{%- assign cd_deadline   = '2026-07-05T00:00:00-07:00' -%}\n{%- assign cd_bg         = '#4177AD' -%}\n{%- assign cd_text       = '#ffffff' -%}\n{%- assign cd_border     = '#e7e7e7' -%}\n{%- assign cd_radius     = '16px' -%}\n{%- comment -%} Text shown once the timer hits zero. {%- endcomment -%}\n{%- assign cd_expired    = 'This sale has ended.' -%}\n\n<div class=\"hanso-cd-wrap\"\n     style=\"--cd-bg:{{ cd_bg }};--cd-text:{{ cd_text }};--cd-border:{{ cd_border }};--cd-radius:{{ cd_radius }};\">\n  <div class=\"hanso-cd\" data-deadline=\"{{ cd_deadline }}\" data-expired=\"{{ cd_expired | escape }}\">\n    <div class=\"hanso-cd__copy\">\n      <h2 class=\"hanso-cd__heading\">{{ cd_heading }}</h2>\n      <p class=\"hanso-cd__sub\">{{ cd_subtext }}</p>\n    </div>\n\n    <div class=\"hanso-cd__timer\" role=\"timer\" aria-live=\"off\">\n      <div class=\"hanso-cd__unit\">\n        <span class=\"hanso-cd__num\" data-cd=\"days\">00</span>\n        <span class=\"hanso-cd__label\">days</span>\n      </div>\n      <span class=\"hanso-cd__sep\" aria-hidden=\"true\">:</span>\n      <div class=\"hanso-cd__unit\">\n        <span class=\"hanso-cd__num\" data-cd=\"hrs\">00</span>\n        <span class=\"hanso-cd__label\">hrs</span>\n      </div>\n      <span class=\"hanso-cd__sep\" aria-hidden=\"true\">:</span>\n      <div class=\"hanso-cd__unit\">\n        <span class=\"hanso-cd__num\" data-cd=\"min\">00</span>\n        <span class=\"hanso-cd__label\">min</span>\n      </div>\n      <span class=\"hanso-cd__sep\" aria-hidden=\"true\">:</span>\n      <div class=\"hanso-cd__unit\">\n        <span class=\"hanso-cd__num\" data-cd=\"secs\">00</span>\n        <span class=\"hanso-cd__label\">secs</span>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n  .hanso-cd-wrap {\n    border: 1px solid var(--cd-border);\n    border-radius: calc(var(--cd-radius) + 6px);\n    padding: 10px;\n    box-sizing: border-box;\n    width: 100%;\n  }\n  .hanso-cd {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 24px;\n    flex-wrap: wrap;\n    background: var(--cd-bg);\n    color: var(--cd-text);\n    border-radius: var(--cd-radius);\n    padding: 28px 36px;\n    box-sizing: border-box;\n  }\n  .hanso-cd__copy { min-width: 240px; }\n  .hanso-cd__heading {\n    margin: 0 0 8px;\n    font-size: clamp(24px, 3vw, 32px);\n    font-weight: 700;\n    line-height: 1.1;\n    color: var(--cd-text);\n    letter-spacing: -0.01em;\n  }\n  .hanso-cd__sub {\n    margin: 0;\n    font-size: clamp(16px, 1.6vw, 19px);\n    font-weight: 400;\n    line-height: 1.4;\n    opacity: 0.92;\n    max-width: 30ch;\n  }\n  .hanso-cd__timer {\n    display: flex;\n    align-items: flex-start;\n    gap: 10px;\n  }\n  .hanso-cd__unit {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    min-width: 52px;\n  }\n  .hanso-cd__num {\n    font-size: clamp(30px, 4vw, 40px);\n    font-weight: 700;\n    line-height: 1;\n    font-variant-numeric: tabular-nums;\n    letter-spacing: 0.02em;\n  }\n  .hanso-cd__label {\n    font-size: 14px;\n    font-weight: 400;\n    opacity: 0.9;\n    margin-top: 8px;\n  }\n  .hanso-cd__sep {\n    font-size: clamp(28px, 3.6vw, 38px);\n    font-weight: 700;\n    line-height: 1;\n    margin-top: 2px;\n    opacity: 0.85;\n  }\n  .hanso-cd.is-expired .hanso-cd__timer { display: none; }\n  .hanso-cd__expired-msg {\n    font-size: clamp(18px, 2vw, 22px);\n    font-weight: 600;\n  }\n\n  @media (max-width: 600px) {\n    .hanso-cd {\n      flex-direction: column;\n      align-items: flex-start;\n      padding: 24px;\n      gap: 18px;\n    }\n    .hanso-cd__timer { align-self: stretch; justify-content: space-between; }\n    .hanso-cd__sub { max-width: none; }\n  }\n</style>\n\n<script>\n  (function () {\n    function pad(n) { return n < 10 ? '0' + n : '' + n; }\n\n    function startTimer(el) {\n      if (el.dataset.cdBound === '1') return;\n      el.dataset.cdBound = '1';\n\n      var deadline = new Date(el.getAttribute('data-deadline')).getTime();\n      var expiredText = el.getAttribute('data-expired') || '';\n      var fields = {\n        days: el.querySelector('[data-cd=\"days\"]'),\n        hrs:  el.querySelector('[data-cd=\"hrs\"]'),\n        min:  el.querySelector('[data-cd=\"min\"]'),\n        secs: el.querySelector('[data-cd=\"secs\"]')\n      };\n\n      function expire() {\n        el.classList.add('is-expired');\n        if (expiredText && !el.querySelector('.hanso-cd__expired-msg')) {\n          var msg = document.createElement('div');\n          msg.className = 'hanso-cd__expired-msg';\n          msg.textContent = expiredText;\n          el.appendChild(msg);\n        }\n      }\n\n      function tick() {\n        var diff = deadline - Date.now();\n        if (isNaN(deadline)) { expire(); return; }\n        if (diff <= 0) { expire(); clearInterval(timer); return; }\n\n        var s = Math.floor(diff / 1000);\n        fields.days.textContent = pad(Math.floor(s / 86400));\n        fields.hrs.textContent  = pad(Math.floor((s % 86400) / 3600));\n        fields.min.textContent  = pad(Math.floor((s % 3600) / 60));\n        fields.secs.textContent = pad(s % 60);\n      }\n\n      tick();\n      var timer = setInterval(tick, 1000);\n    }\n\n    function init() {\n      document.querySelectorAll('.hanso-cd').forEach(startTimer);\n    }\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', init);\n    } else {\n      init();\n    }\n  })();\n</script>",
