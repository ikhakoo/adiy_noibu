    "outdoor_moments_MBaiWC": {
      "type": "outdoor-moments",
      "blocks": {
        "card_N9NBff": {
          "type": "card",
          "settings": {
            "video": "shopify://files/videos/202606280055 (1).mp4",
            "image": "shopify://shop_images/image_13.png",
            "title": "Backyard Family Lounge",
            "description": "Turn your backyard into a comfortable outdoor living space where everyone can unwind. Whether it's morning coffee, evening chats, or weekend lounging, this deck creates a stable, inviting foundation for your family."
          }
        },
        "card_Nq4E8K": {
          "type": "card",
          "settings": {
            "video": "shopify://files/videos/202606280055.mp4",
            "image": "shopify://shop_images/image_14.png",
            "title": "Hot Tub Platform",
            "description": "Create a solid, level base for your hot tub setup. The pressure-treated, kiln-dried wood helps ensure durability and stability—giving you peace of mind while you relax and enjoy your spa experience."
          }
        },
        "card_aDcBXg": {
          "type": "card",
          "settings": {
            "video": "shopify://files/videos/IMG_2698 2.MOV",
            "image": "shopify://shop_images/image_15.png",
            "title": "BBQ & Entertainment Area",
            "description": "Upgrade your hosting game with a dedicated space for grilling and gatherings. This deck provides a clean, organized surface for your BBQ setup, outdoor dining, and entertaining guests without the mess."
          }
        },
        "card_qcEYPP": {
          "type": "card",
          "disabled": true,
          "settings": {
            "image": "shopify://shop_images/image_16.png",
            "title": "Kids Play Area Platform",
            "description": "Give kids a safe, raised surface for playtime activities. Ideal for setting up playhouses, outdoor toys, or activity zones, this deck helps keep everything off muddy or uneven ground."
          }
        },
        "card_ddqFpL": {
          "type": "card",
          "disabled": true,
          "settings": {
            "image": "shopify://shop_images/image_17.png",
            "title": "Shade Structure Base",
            "description": "Use it as a strong foundation for pergolas, gazebos, or other shade structures. Its sturdy construction makes it easier to build and maintain a comfortable shaded area for year-round outdoor use."
          }
        },
        "card_tqxwdj": {
          "type": "card",
          "disabled": true,
          "settings": {
