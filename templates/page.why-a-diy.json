        "text_card_Ymc4K3": {
          "type": "text-card",
          "settings": {
            "title": "<p>[icon.5-stars.20.#FFD773]</p><p></p><p>\"The kit came with everything I needed AND I savedover $5,000 in contractor fees. I built the whole deck built in just one weekend. It looks amazing, I couldn't be more proud of what I accomplished. Definitely recommend to anyone who wants a beautiful deck without the hassle!\"</p><p></p><p><strong>Lori M.</strong></p>",
            "content_class": "text-20/16-500",
            "url": "",
            "width_height_aspect": "100% | 100% | auto",
            "flex_row_wrap_align_x_align_y_gap": "start | start | 0",
            "padding_top_bottom_left_right": "48/32 | 48/32 | 48/24 | 48/24",
