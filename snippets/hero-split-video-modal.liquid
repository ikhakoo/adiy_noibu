{% comment %}
  Video Modal Snippet - Place this near your footer or include it once in theme.liquid
{% endcomment %}
<div class="hss-modal-overlay" id="hssVideoModal" aria-hidden="true" role="dialog">
  <div class="hss-modal-wrapper">
    <button class="hss-modal-close" id="hssCloseModal" aria-label="Close Video">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <div class="hss-modal-body">
      <div class="hss-video-container">
        <iframe id="hssModalIframe" src="" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen autoplay></iframe>
      </div>
    </div>
  </div>
</div>

<style>
  .hss-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.85);
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .hss-modal-overlay.is-active {
    opacity: 1;
    visibility: visible;
  }
  .hss-modal-wrapper {
    position: relative;
    width: 90%;
    max-width: 900px;
    padding: 10px;
  }
  .hss-modal-close {
    position: absolute;
    top: -45px;
    right: 0;
    background: transparent;
    border: none;
    color: #ffffff;
    cursor: pointer;
    font-size: 20px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hss-modal-body {
    position: relative;
    padding-top: 56.25%; /* 16:9 Aspect Ratio */
    background: #000000;
  }
  .hss-video-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
  .hss-video-container iframe {
    width: 100%;
    height: 100%;
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const modal = document.getElementById('hssVideoModal');
  const iframe = document.getElementById('hssModalIframe');
  const closeBtn = document.getElementById('hssCloseModal');

  // Use document-level delegation to catch clicks from any section
  document.addEventListener('click', (e) => {
    const trigger = e.target.closest('.js-video-trigger');
    
    if (trigger) {
      e.preventDefault(); // This is the crucial part that stops the reload
      const videoUrl = trigger.getAttribute('data-video-url');
      
      if (!videoUrl) return;

      let embedUrl = videoUrl;

      // Handle YouTube
      if (videoUrl.includes('youtube.com/watch')) {
        const urlParams = new URL(videoUrl).searchParams;
        embedUrl = 'https://www.youtube.com/embed/' + urlParams.get('v');
      } 
      // Handle Vimeo
      else if (videoUrl.includes('vimeo.com/')) {
        embedUrl = 'https://player.vimeo.com/video/' + videoUrl.split('/').pop();
      }

      iframe.src = embedUrl;
      modal.classList.add('is-active');
    }
  });

  // Close functionality
  const closeModal = () => {
    modal.classList.remove('is-active');
    iframe.src = ''; // Stops the video
  };

  closeBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
});
</script>