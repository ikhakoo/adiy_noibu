{%- comment -%} Auto Generated Variables start {%- endcomment -%}
{%- liquid
  assign block_type = "upsell_products"
  assign section_type = "product"
  assign limit = block.settings.limit
  assign upsell_products = block.settings.upsell_products
  assign upsell_variants_namespace_key = block.settings.upsell_variants_namespace_key
  assign title_class = block.settings.title_class
  assign subtitle_class = block.settings.subtitle_class
  assign checkbox_class = block.settings.checkbox_class
  assign input_class = block.settings.input_class
  assign flex_direction_align_x_align_y_gap_wrap = block.settings.flex_direction_align_x_align_y_gap_wrap
  assign flex_dividers_height_width_align = block.settings.flex_dividers_height_width_align
  assign divider_background_color = block.settings.divider_background_color
  assign border_width_radius = block.settings.border_width_radius
  assign padding_top_bottom_left_right = block.settings.padding_top_bottom_left_right
  assign background_color = block.settings.background_color
  assign background_gradient = block.settings.background_gradient
  assign border_color = block.settings.border_color
  assign margin_top_bottom_left_right = block.settings.margin_top_bottom_left_right
  assign max_w_flex_col_row_order_align = block.settings.max_w_flex_col_row_order_align
  assign responsive_visibility = block.settings.responsive_visibility
  assign hide_if_empty = block.settings.hide_if_empty
  assign responsive_breakpoint = block.settings.responsive_breakpoint
  assign anchor_id = block.settings.anchor_id
  assign show_conditionally = block.settings.show_conditionally
-%}
{%- comment -%} Auto Generated Variables end {%- endcomment -%}

{% liquid
  assign namespace = upsell_variants_namespace_key | split: "." | first
  assign key = upsell_variants_namespace_key | split: "." | last

  assign _upsell_variants = null | uniq

  for _product in upsell_items
    assign _upsell_variant = _product.variants.first | uniq
    assign _upsell_variants = _upsell_variants | concat: _upsell_variant | uniq
  endfor

  assign upsell_variants = product.metafields[namespace][key].value
  for variant in upsell_variants
    assign _upsell_variant = variant | uniq
    assign _upsell_variants = _upsell_variants | concat: _upsell_variant | uniq
  endfor
%}

{% liquid
  if request.design_mode != true
    if _upsell_variants.size <= 0
      assign is_empty = true
    endif
    if hide_if_empty == 'block' and is_empty
      echo '<script type="block/hide"></script>'
      break
    endif
    if hide_if_empty == 'container' and is_empty
      echo '<script type="container/break"></script>'
      break
    endif
    if hide_if_empty == 'section' and is_empty
      echo '<script type="section/break"></script>'
      break
    endif
  endif
%}

{% render '_utils.dynamic-css',
    block: block,
    selector: '& [data-style-container]',
    keys: "responsive_visibility,flex_direction_align_x_align_y_gap_wrap" %}

{% render '_utils.dynamic-css',
    block: block,
    selector: "& [data-style-divider]",
    keys: "flex_dividers_height_width_align, divider_background_color" %}

{% render '_utils.dynamic-css',
    block: block,
    keys: "responsive_visibility,max_w_flex_col_row_order_align,padding_top_bottom_left_right,margin_top_bottom_left_right,border_width_radius,background_color,background_gradient,border_color" %}

<div
    data-style-id="{{ section.id }}--{{ block.id }}"
    {% if anchor_id != blank %}id="{{ anchor_id }}"{% endif %}
    {{ block.shopify_attributes }}
    x-show="$data.showConditionally('{{ show_conditionally }}')"
    data-block-type="{{ block.type }}">
  <section {{ block.shopify_attributes }} data-style-container>
    {% for variant in _upsell_variants %}
      <section x-data="{ active: false, engraving: '', engraving_limit: +`{{ variant.product.metafields.smart.engraving_character_limit.value }}` }"
               x-effect="() => {
                        if (active) {
                            $data.state.upsell_items.set(`{{ variant.product.handle }}`, { id: +`{{ variant.id }}`, properties: engraving ? { Engraving: engraving } : {} })
                          if (engraving_limit && !engraving) {
                            $data.state.disable_add_to_cart.add(`{{ variant.product.handle }}`)
                          }
                        } else {
                          $data.state.upsell_items.delete(`{{ variant.product.handle }}`)
                        }
                        if (engraving || !active) {
                            $data.state.disable_add_to_cart.delete(`{{ variant.product.handle }}`)
                        }
                      }"
               class="flex flex-col gap-6 w-full">
        <div class="flex gap-4 w-full items-center">
          <a href="{{ variant.product.url }}" class="size-16 relative">
            {% assign image = variant.featured_media | default: variant.product.featured_media %}
            {% render '_object.image', image: image, class: "w-full h-full object-cover" %}
          </a>
          <div class="flex flex-col justify-center">
            <h3 class="{{ title_class }}">{{ variant.title | replace: "Default Title", '' }} {{ variant.product.title }}</h3>
            <div class="mt-1 {{ subtitle_class }}">{% render '_utils.metafield-richtext', content: variant.product.metafields.smart.short_description %}</div>
            <div class="mt-2">
              {% assign price = variant.price | money_without_trailing_zeros %}
              {% assign name = 'upsell_variant--' | append: variant.id %}
              {% assign label = 'Add (+' | append: price | append: ')' %}
              {% render "_components.checkbox",
                  class: checkbox_class,
                  label: label,
                  name: "name",
                  default_value: false,
                  setState: 'active = value'
              %}
            </div>
          </div>
        </div>
        {% if variant.product.metafields.smart.engraving_character_limit.value > 0 %}
          <div x-show="!!active" class="w-full" x-cloak>
            {% assign placeholder = 'Enter up to ' | append: variant.product.metafields.smart.engraving_character_limit.value | append: " characters" %}
            {% render "_components.input",
                name: name,
                type: 'text',
                label: 'Engraving text',
                placeholder: placeholder,
                autocomplete: 'off',
                class: input_class,
                setState: "engraving = value.substring(0, engraving_limit); $el.value = value.substring(0, engraving_limit)",
                value: 'engraving',
                default_value: "" %}
          </div>
        {% endif %}
      </section>
      {% unless forloop.last %}
        <hr class="border-none" role="separator" data-style-divider>
      {% endunless %}
    {% endfor %}
  </section>
</div>
