{%- comment -%} Auto Generated Variables start {%- endcomment -%}
{%- liquid
  assign section_type = "megamenu"
  assign _handle = section.settings.handle
  assign background_blur = section.settings.background_blur
  assign columns = section.settings.columns
  assign vertical_padding_section = section.settings.vertical_padding_section
  assign section_id = section.settings.section_id
-%}
{%- comment -%} Auto Generated Variables end {%- endcomment -%}

{% liquid
  assign vertical_padding_section = vertical_padding_section | strip_newlines | replace: ' ', "" | split: '|'
  assign pt = vertical_padding_section[0] | split: '/'
  assign pb = vertical_padding_section[1] | split: '/'

  assign columns = columns | strip_newlines | replace: ' ', ""
%}

<style>
  #{{ section.id }} {
    padding-top: {{ pt.first }};
    padding-bottom: {{ pb.first }};
  }
  @media (max-width: 768px) {
    #{{ section.id }} {
      padding-top: {{ pt.last }};
      padding-bottom: {{ pb.last }};
    }
  }
</style>

<div data-megamenu="{{ _handle }}"
     x-data="{ open: $modal.id === 'megamenu--{{ _handle | handleize }}' }"
     x-effect="open = $editor?.select_section_id === '{{ section.id }}' || $modal.id === 'megamenu--{{ _handle | handleize }}'"
     x-cloak>
  <div class="fixed inset-x-0 bottom-0 top-0 z-10 transition duration-75 ease-in-out bg-[--color-modal-background] {{ background_blur }}"
       x-show="open"
       @click="$modal.setId('')"
       @pointerover="$modal.setId('')"></div>
  <section class="pointer-events-none fixed inset-x-0 top-[--header-height-offset] z-20 {{ color_scheme }} max-lg:hidden bg-transparent px-container-md -mt-[18px]"
           data-section-type="megamenu-flex"
           x-show="open"
           x-trap.noautofocus="open">
    <div class="pointer-events-auto relative h-full max-h-[calc(100vh-var(--header-height-offset)-40px)] overflow-auto scrollbar-none rounded-bl-[30px] rounded-br-[30px]">
      {% render "_section.universal-settings", section_type: section_type, section_id: section.id, insert: "before" %}
        <section class="grid h-full grid-cols-[repeat(var(--cols),_minmax(0,_1fr))] gap-6 px-9 pb-9 pt-[30px] bg-[#F6F4F2]" style="--cols: {{ columns }};">
          {% liquid
          for block in section.blocks
            if block.type == 'image-with-content'
              render 'megamenu.image-with-content', block: block, forloop: forloop, section_type: section_type
            endif
          endfor
        %}
        </section>
      {% render "_section.universal-settings", section_type: section_type, insert: "after" %}
    </div>
  </section>
</div>


