{%- comment -%} Auto Generated Variables start {%- endcomment -%}
{%- liquid
  assign max_w_flex_col_row_order_align = block.settings.max_w_flex_col_row_order_align
  assign margin_top_bottom_left_right = block.settings.margin_top_bottom_left_right
  assign divider_border_width_radius = block.settings.divider_border_width_radius
  assign background_color = block.settings.background_color
  assign background_gradient = block.settings.background_gradient
  assign border_color = block.settings.border_color
  assign responsive_visibility = block.settings.responsive_visibility
  assign responsive_breakpoint = block.settings.responsive_breakpoint
-%}
{%- comment -%} Auto Generated Variables end {%- endcomment -%}

{% capture block_content %}
  {% liquid
    assign blockIndex0 = forloop.index0
    case block.type
      when "richtext"
        render '_blocks.richtext', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "button"
        render '_blocks.button', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: "w-full", form: form
      when "variant-based-button"
        render '_blocks.variant-based-button', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: "w-full", form: form
      when "delivery-range"
        render '_blocks.delivery-range', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, form: form
      when "collapsible"
        render '_blocks.collapsible', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "breadcrumbs"
        render '_blocks.breadcrumbs', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "hide-section"
        render '_blocks.hide-section', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "dynamic-content"
        render '_blocks.dynamic-content', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "image-with-caption"
        render '_blocks.image-with-caption', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "text-card"
        render '_blocks.text-card', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "subscribe__button_card"
        render 'product.subscribe__button_card', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "complementary_products"
        render 'product.complementary_products', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "product_cards"
        render 'product.product_cards', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "option__color"
        for i in optionBlocks
          assign index = i | times: 1
          if index == blockIndex0
            if product.options_with_values[forloop.index0].values.size <= 1 and product.options_with_values[forloop.index0].values.first == "Default Title" or product.options_with_values[forloop.index0].values == blank
              echo '<script type="block/hide"></script>'
            endif
            render 'product.option__color', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form, optionIndex: forloop.index0
            break
          endif
        endfor
      when "option__radio"
        for i in optionBlocks
          assign index = i | times: 1
          if index == blockIndex0
            if product.options_with_values[forloop.index0].values.size <= 1 and product.options_with_values[forloop.index0].values.first == "Default Title" or product.options_with_values[forloop.index0].values == blank
              echo '<script type="block/hide"></script>'
            endif
            render 'product.option__radio', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form, optionIndex: forloop.index0
            break
          endif
        endfor
      when "option__radio_custom"
        for i in optionBlocks
          assign index = i | times: 1
          if index == blockIndex0
            if product.options_with_values[forloop.index0].values.size <= 1 and product.options_with_values[forloop.index0].values.first == "Default Title" or product.options_with_values[forloop.index0].values == blank
              echo '<script type="block/hide"></script>'
            endif
            render 'product.option__radio_custom', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form, optionIndex: forloop.index0
            break
          endif
        endfor
      when "option__radio_checkbox"
        for i in optionBlocks
          assign index = i | times: 1
          if index == blockIndex0
            if product.options_with_values[forloop.index0].values.size <= 1 and product.options_with_values[forloop.index0].values.first == "Default Title" or product.options_with_values[forloop.index0].values == blank
              echo '<script type="block/hide"></script>'
            endif
            render 'product.option__radio_checkbox', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form, optionIndex: forloop.index0
            break
          endif
        endfor
      when "addons__checkbox_selector"
        render 'product.addons__checkbox_selector', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form, optionIndex: forloop.index0
      when "option__radio_detailed"
        for i in optionBlocks
          assign index = i | times: 1
          if index == blockIndex0
            if product.options_with_values[forloop.index0].values.size <= 1 and product.options_with_values[forloop.index0].values.first == "Default Title" or product.options_with_values[forloop.index0].values == blank
              echo '<script type="block/hide"></script>'
            endif
            render 'product.option__radio_detailed', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form, optionIndex: forloop.index0
            break
          endif
        endfor
      when "option__select"
        for i in optionBlocks
          assign index = i | times: 1
          if index == blockIndex0
            if product.options_with_values[forloop.index0].values.size <= 1 and product.options_with_values[forloop.index0].values.first == "Default Title" or product.options_with_values[forloop.index0].values == blank
              echo '<script type="block/hide"></script>'
            endif
            render 'product.option__select', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form, optionIndex: forloop.index0
            break
          endif
        endfor
      when "option__color_w_caption"
        for i in optionBlocks
          assign index = i | times: 1
          if index == blockIndex0
            if product.options_with_values[forloop.index0].values.size <= 1 and product.options_with_values[forloop.index0].values.first == "Default Title" or product.options_with_values[forloop.index0].values == blank
              echo '<script type="block/hide"></script>'
            endif
            render 'product.option__color_w_caption', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form, optionIndex: forloop.index0
            break
          endif
        endfor
      when "sibling__select"
        render 'product.sibling__select', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "sibling__radio"
        render 'product.sibling__radio', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "sibling__radio_custom"
        render 'product.sibling__radio_custom', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "sibling__color"
        render 'product.sibling__color', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "subscribe__button_select"
        render 'product.subscribe__button_select', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "rating"
        render 'product.rating', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "labels"
        render 'product.labels', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "variant_selector"
        render 'product.variant_selector', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "upsell_products"
        render 'product.upsell_products', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "bonus_items"
        render 'product.bonus_items', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "variant_selector__color"
        render 'product.variant_selector__color', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "variant_selector__radio"
        render 'product.variant_selector__radio', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "variant_selector__select"
        render 'product.variant_selector__select', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "title"
        render 'product.title', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "image"
        render 'product.image', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "quantity_selector"
        render 'product.quantity_selector', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "price"
        render 'product.price', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "discount__button_card"
        render 'product.discount__button_card', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "price_sqft"
        render 'product.price_sqft', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "product-confirmation"
        render 'product.product-confirmation', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "add_to_cart_button"
        render 'product.add_to_cart_button', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "add_to_bundle_button"
        render 'product.add_to_bundle_button', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "dynamic_buy_button"
        render 'product.dynamic_buy_button', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "payment_terms"
        render 'product.payment_terms', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "gift_card_recipient"
        render 'product.gift_card_recipient', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "description"
        render 'product.description', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "dynamic-text"
        render 'product.dynamic-text', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "required_combine_products"
        render 'product.required_combine_products', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "custom_liquid"
        render '_blocks.custom-liquid', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
      when "low_in_stock"
        render 'product.low_in_stock', block: block, forloop: forloop, section_type: section_type, form: form, product: product, variant: variant, class: class, form: form
    endcase
  %}
  {% if block.type == '@app' %}
    {% render '_utils.dynamic-css',
        block: block,
        keys: "responsive_visibility,max_w_flex_col_row_order_align,padding_top_bottom_left_right,margin_top_bottom_left_right,border_width_radius,background_color,background_gradient,border_color" %}

    <div class="app-block" {{ block.shopify_attributes }} data-style-id="{{ section.id }}--{{ block.id }}" data-block-type="{{ block.type }}">
      {% render block, product: product, variant: variant, forloop: forloop, class: class, form: form %}
    </div>
  {% endif %}

{% endcapture %}
{% if block_content contains '<script type="block/hide"></script>' %}
  {% break %}
{% endif %}
{{ block_content }}