{%- comment -%} Auto Generated Variables start {%- endcomment -%}
{%- liquid
  assign section_type = "media-with-text"
  assign media_position = section.settings.media_position
  assign media_position_mobile = section.settings.media_position_mobile
  assign background_color = section.settings.background_color
  assign section_id = section.settings.section_id
  assign vertical_padding_section = section.settings.vertical_padding_section
  assign container_spacing = section.settings.container_spacing
  assign responsive_visibility = section.settings.responsive_visibility
-%}
{%- comment -%} Auto Generated Variables end {%- endcomment -%}

{% liquid

  if media_position == "right"
    assign media_order = "lg:order-2"
    assign content_ratio =  " lg:grid-cols-[684px_1fr]"
  else 
    assign media_order = "lg:-order-1"
    assign content_ratio =  " lg:grid-cols-[1fr_684px]"
  endif

  if media_position_mobile == "bottom"
    assign media_order = media_order | append: " max-md:order-2"
  else 
      assign media_order = media_order | append: " max-md:-order-1"
  endif

  assign background_color = "background-color: " | append: background_color | append: ";"

  assign vertical_padding_section = vertical_padding_section | strip_newlines | replace: ' ', "" | split: '|'
  assign pt = vertical_padding_section[0] | split: '/'
  assign pb = vertical_padding_section[1] | split: '/'
%}

<style>
  #{{ section.id }} {
    padding-top: {{ pt.first }};
    padding-bottom: {{ pb.first }};
  }
  @media (max-width: 768px) {
    #{{ section.id }} {
      padding-top: {{ pt.last }};
      padding-bottom: {{ pb.last }};
    }
  }
</style>

{% render '_utils.dynamic-css',
  block: block,
  selector: '[data-section-type="media-with-text"]',
  keys: 'background_color'
  %}

{% render "_section.universal-settings", section_type: section_type, styles: background_color, section_id: section.id, insert: "before" %}
<div class="grid h-full gap-6 md:gap-9 {{ content_ratio }}" 
     data-style-media-with-text>
  <section class="h-full w-full max-w-[calc(524px_+_72px)] flex flex-col px-1.5 md:px-9 justify-center">
      {% liquid
        for block in section.blocks
          case block.type
            when 'richtext'
              render 'media-with-text.richtext', block: block, forloop: forloop, section_type: section_type
            when 'dual_text'
              render 'media-with-text.dual_text', block: block, forloop: forloop, section_type: section_type
            when 'buttons'
              render 'media-with-text.buttons', block: block, forloop: forloop, section_type: section_type
          endcase
        endfor
      %}
  </section>
  <section class="w-full relative flex items-center justify-center {{ media_order }}">
    {% liquid
    for block in section.blocks
      case block.type
        when 'image'
          render 'media-with-text.image', block: block, forloop: forloop, section_type: section_type
        when 'video'
          render 'media-with-text.video', block: block, forloop: forloop, section_type: section_type
      endcase 
    endfor
    %}
  </section>
</div>
{% render "_section.universal-settings", section_type: section_type, insert: "after" %}