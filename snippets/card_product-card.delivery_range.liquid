{%- comment -%} Auto Generated Variables start {%- endcomment -%}
{%- liquid
  assign block_type = "delivery_range"
  assign section_type = "card_product-card"
  assign min_days = block.settings.min_days | default: 0 | plus: 0
  assign max_days = block.settings.max_days | default: 0 | plus: 0
  assign delivery_text = block.settings.delivery_text
  assign delivery_class = block.settings.delivery_class
  assign days_text = block.settings.days_text
  assign days_class = block.settings.days_class
  assign margin_top_bottom_left_right = block.settings.margin_top_bottom_left_right
  assign max_w_flex_col_row_order_align = block.settings.max_w_flex_col_row_order_align
  assign responsive_visibility = block.settings.responsive_visibility
  assign hide_if_empty = block.settings.hide_if_empty
  assign responsive_breakpoint = block.settings.responsive_breakpoint
  assign anchor_id = block.settings.anchor_id
-%}
{%- comment -%} Auto Generated Variables end {%- endcomment -%}

{% liquid
  assign today_timestamp = 'now' | date: "%s" | plus: 0

  assign min_days_in_seconds = min_days | times: 86400 
  assign max_days_in_seconds = max_days | times: 86400

  assign min_timestamp = today_timestamp | plus: min_days_in_seconds
  assign max_timestamp = today_timestamp | plus: max_days_in_seconds 

  assign month = min_timestamp | date: "%B" 
  assign min_delivery_date = min_timestamp | date: "%d" 
  assign max_delivery_date = max_timestamp | date: "%d" 

  
  assign min_days_str = min_days | append: ""
  assign max_days_str = max_days | append: ""

  
  assign delivery_text = delivery_text | replace: "[month]", month | replace: "%5Bmonth%5D", month | replace: "[min_date]", min_delivery_date | replace: "%5Bmin_date%5D", min_delivery_date | replace: "[max_date]", max_delivery_date | replace: "%5Bmax_date%5D", max_delivery_date
  
  assign days_text = days_text | replace: "[month]", month | replace: "%5Bmonth%5D", month | replace: "[min_date]", min_delivery_date | replace: "%5Bmin_date%5D", min_delivery_date | replace: "[max_date]", max_delivery_date | replace: "%5Bmax_date%5D", max_delivery_date | replace: "[min_days]", min_days_str | replace: "%5Bmin_days%5D", min_days_str | replace: "[max_days]", max_days_str | replace: "%5Bmax_days%5D", max_days_str
%}

{% render '_utils.dynamic-css',
    block: block,
    keys: "responsive_visibility,margin_top_bottom_left_right, max_w_flex_col_row_order_align" %}

<div data-style-id="{{ section.id }}--{{ block.id }}"
     {% if anchor_id != blank %}id="{{ anchor_id }}"{% endif %}
     class="">
  {% render '_input.richtext', content: delivery_text, class: delivery_class, block: block, forloop: forloop %}
  {% render '_input.richtext', content: days_text, class: days_class, block: block, forloop: forloop %}
</div>