{%- comment -%} Auto Generated Variables start {%- endcomment -%}
{%- liquid
  assign block_type = "_blocks.dynamic-product-cards"
  assign target_product = block.settings.target_product
  assign primary_source = block.settings.primary_source
  assign fallback_source = block.settings.fallback_source
  assign fallback_products = block.settings.fallback_products
  assign fallback_collection = block.settings.fallback_collection
  assign display_limit = block.settings.display_limit
  assign product_card_class = block.settings.product_card_class
  assign slider_cols_rows_align_x_align_y_gap = block.settings.slider_cols_rows_align_x_align_y_gap
  assign slider_scroll_snap = block.settings.slider_scroll_snap
  assign slider_overflow_container = block.settings.slider_overflow_container
  assign infinite_scroll = block.settings.infinite_scroll
  assign scrollbar_class = block.settings.scrollbar_class
  assign padding_top_bottom_left_right = block.settings.padding_top_bottom_left_right
  assign margin_top_bottom_left_right = block.settings.margin_top_bottom_left_right
  assign max_w_flex_col_row_order_align = block.settings.max_w_flex_col_row_order_align
  assign responsive_visibility = block.settings.responsive_visibility
  assign hide_if_empty = block.settings.hide_if_empty
  assign responsive_breakpoint = block.settings.responsive_breakpoint
  assign anchor_id = block.settings.anchor_id
-%}
{%- comment -%} Auto Generated Variables end {%- endcomment -%}

{% liquid
  assign products = "" | split: "" | uniq
  assign complementary_products = target_product.metafields.shopify--discovery--product_recommendation.complementary_products.value
  assign related_products = target_product.metafields.shopify--discovery--product_recommendation.related_products.value
  assign _fallback_products = fallback_products | where: "id"
  assign _fallback_colllection_products = fallback_collection.products | where: "id"
  assign _fallback_products = _fallback_products | concat: _fallback_colllection_products


  assign display_limit = display_limit | strip_newlines | replace: ' ', "" | split: '|'
  assign display_limit = display_limit[0] | split: '/'

  assign desktop_display_limit = display_limit.first | abs
  assign mobile_display_limit = display_limit.last | abs

  assign max_display_limit = desktop_display_limit | at_least: mobile_display_limit | default: 12

  case primary_source
    when 'complementary'
      for _product in complementary_products
        if index >= max_display_limit
          break
        endif
        assign complementary_product = complementary_products | where: 'id', _product.id
        if complementary_product.first.id == target_product.id
          continue
        endif
        assign products = products | concat: complementary_product | uniq
        assign index = index | plus: 1
      endfor
    when 'related'
      for _product in related_products
        if index >= max_display_limit
          break
        endif
        assign related_product = related_products | where: 'id', _product.id
        if related_product.first.id == target_product.id
          continue
        endif
        assign products = products | concat: related_product | uniq
        assign index = index | plus: 1
      endfor
    when 'manual'
      for _product in fallback_products
        if index >= max_display_limit
          break
        endif
        assign fallback_product = fallback_products | where: 'id', _product.id
        if fallback_product.first.id == target_product.id
          continue
        endif
        assign products = products | concat: fallback_product | uniq
        assign index = index | plus: 1
      endfor
  endcase

  case secondary_source
    when 'complementary'
      for _product in complementary_products
        if index >= max_display_limit
          break
        endif
        assign complementary_product = complementary_products | where: 'id', _product.id
        if complementary_product.first.id == target_product.id
          continue
        endif
        assign products = products | concat: complementary_product | uniq
        assign index = index | plus: 1
      endfor
    when 'related'
      for _product in related_products
        if index >= max_display_limit
          break
        endif
        assign related_product = related_products | where: 'id', _product.id
        if related_product.first.id == target_product.id
          continue
        endif
        assign products = products | concat: related_product | uniq
        assign index = index | plus: 1
      endfor
    when 'manual'
      for _product in fallback_products
        if index >= max_display_limit
          break
        endif
        assign fallback_product = fallback_products | where: 'id', _product.id
        if fallback_product.first.id == target_product.id
          continue
        endif
        assign products = products | concat: fallback_product | uniq
        assign index = index | plus: 1
      endfor
  endcase

  for _product in fallback_products
    if index >= max_display_limit
      break
    endif
    assign fallback_product = fallback_products | where: 'id', _product.id
    if fallback_product.first.id == target_product.id
      continue
    endif
    assign products = products | concat: fallback_product | uniq
    assign index = index | plus: 1
  endfor

  assign index = 0

%}


{% liquid
  if request.design_mode != true
    if _products.size <= 0
      assign is_empty = true
    endif
    if hide_if_empty == 'block' and is_empty
      echo '<script type="block/hide"></script>'
      break
    endif
    if hide_if_empty == 'container' and is_empty
      echo '<script type="container/break"></script>'
      break
    endif
    if hide_if_empty == 'section' and is_empty
      echo '<script type="section/break"></script>'
      break
    endif
  endif
%}

{% render '_utils.dynamic-css',
    block: block,
    keys: "margin_top_bottom_left_right, max_w_flex_col_row_order_align" %}

{% render '_utils.dynamic-css',
    block: block,
    selector: "& [data-style-dynamic-product-cards]",
    keys: "slider_cols_rows_align_x_align_y_gap"
%}
{% render '_utils.dynamic-css',
    block: block,
    selector: "& [data-style-scrollbar]",
    keys: "padding_top_bottom_left_right",
    padding_as_margin: true %}
{% liquid

  assign slider_cols_rows_align_x_align_y_gap = slider_cols_rows_align_x_align_y_gap | strip_newlines | split: '|'
  assign grid_cols = slider_cols_rows_align_x_align_y_gap[0] | split: '/'

  assign container_spacing = section.settings.container_spacing
  case slider_overflow_container
    when 'all'
      assign slider_overflow = container_spacing | replace: 'px', '-mx' | append: " scroll-" | append: container_spacing | append: " " | append: container_spacing
    when 'mobile'
      assign slider_overflow = container_spacing | replace: 'px', 'max-md:-mx' | append: " max-md:scroll-" | append: container_spacing | append: " max-md:" | append: container_spacing
    when 'desktop'
      assign slider_overflow = container_spacing | replace: 'px', 'md:-mx' | append: " md:scroll-" | append: container_spacing | append: " md:" | append: container_spacing
  endcase
%}


{% capture fallback_product_data %}
  [{% for _product in fallback_products limit: max_display_limit %}
  {%- render '_json.product', product: _product -%}{% unless forloop.last %},{% endunless %}
{% endfor %}]
{% endcapture %}

<style>
  @media screen and (max-width: {{ responsive_breakpoint | default: "768px" }}) {
    [data-style-id="{{ section.id }}--{{ block.id }}"] [data-style-dynamic-product-cards] > :where(*):nth-of-type({{ grid_cols | last | replace: " ", "" | trim }}n+1) {
      scroll-snap-align: start;
    }
  }

  @media screen and (min-width: {{ responsive_breakpoint | default: "768px" }}) {
    [data-style-id="{{ section.id }}--{{ block.id }}"] [data-style-dynamic-product-cards] > :where(*):nth-of-type({{ grid_cols | first | replace: " ", "" | trim }}n+1) {
      scroll-snap-align: start;
    }
  }
</style>


<div
    class="flex flex-col"
    data-style-id="{{ section.id }}--{{ block.id }}"
    {% if anchor_id != blank %}id="{{ anchor_id }}"{% endif %}
    {{ block.shopify_attributes }}
    data-display-limit-desktop="{{ desktop_display_limit }}"
    data-display-limit-mobile="{{ mobile_display_limit }}"
    data-grid-slider
    x-data="{ ..._sections.initContentSlider($refs.container, undefined,`{{ infinite_scroll }}` === 'true'), ..._sections.initDynamicProductCards($el, `{{ target_product.handle }}`) }">
  <div class="relative grid overflow-x-auto scrollbar-none overflow-y-hidden snap-x {{ slider_scroll_snap }} {{ slider_overflow }}"
       x-ref="container"
       @resize.window="content_slider.handleResize"
       x-init="$nextTick(() => content_slider.handleResize())"
       @scroll="content_slider.handleScroll"
       @scrollend="content_slider.handleInfiniteScroll"
       data-fallback-products="{{ fallback_product_data | escape }}"
       x-effect="async ()=> {
         if (state.product.recommendations_loaded_at || state.product?.complementary_products?.length) {
           await renderDynamicProductCards($el, `{{ primary_source }}`, `{{ fallback_source }}`, `{{ product_card_class }}`, +`{{ desktop_display_limit }}`, +`{{ mobile_display_limit }}`);
           content_slider.handleResize();
         }
       }"
       data-style-dynamic-product-cards>
    {% for product in products limit: max_display_limit %}
      {% assign product_visibility = "" %}
      {% if forloop.index > desktop_display_limit %}
        {% assign product_visibility = "mobile-only" %}
      {% endif %}
      {% if forloop.index > mobile_display_limit %}
        {% assign product_visibility = "desktop-tablet-only" %}
      {% endif %}
      <div class="shrink-0 max-w-full w-full h-full {{ product_visibility }}" data-product-handle="{{ product.handle }}">
        <section class="card-loading product-card--{{ product_card_class }}"
                 data-product-handle="{{ product.handle }}"
                 data-product-id="{{ product.id }}"
                 x-data="{}"
                 x-init="() => $nextTick(() => _sections.hydrateProductCard($el, '{{ product_card_class }}', $el.getAttribute('data-product-handle'), $el.getAttribute('data-product-id'), ['h-full']))"></section>
        <script type="application/json"
                data-product-data="{{ product.handle }}">{%- render '_json.product', product: product, meta_product: true -%}</script>
      </div>
    {% endfor %}
  </div>
  {% if scrollbar_class != blank %}
    {% render "_components.scrollbar",
        class: scrollbar_class,
        scroll_container_ref: '$refs.container',
        html_attributes: 'data-style-scrollbar' %}
  {% endif %}
</div>

{% if target_product.id != product.id %}
  <script type="application/json"
          data-product-data="{{ target_product.handle }}">{%- render '_json.product', product: target_product, meta_product: true -%}</script>
{% endif %}
