{%- comment -%} Auto Generated Variables start {%- endcomment -%}
{%- liquid
  assign block_type = "product-drawer-button"
  assign section_type = "card_product-card"
  assign label = block.settings.label
  assign button_class = block.settings.button_class
  assign show_conditionally = block.settings.show_conditionally
  assign margin_top_bottom_left_right = block.settings.margin_top_bottom_left_right
  assign max_w_flex_col_row_order_align = block.settings.max_w_flex_col_row_order_align
  assign responsive_visibility = block.settings.responsive_visibility
  assign responsive_breakpoint = block.settings.responsive_breakpoint
  assign anchor_id = block.settings.anchor_id
-%}
{%- comment -%} Auto Generated Variables end {%- endcomment -%}

<div
    data-style-id="{{ section.id }}--{{ block.id }}"
    {% if anchor_id != blank %}id="{{ anchor_id }}"{% endif %}
    {{ block.shopify_attributes }}
    data-content="{% render '_input.inline_richtext', content: label, escape: true, block: block, forloop: forloop %}"
    x-data="{ content: renderDynamicText($el.getAttribute('data-content')) }"
    x-effect="() => { if (card?.selected_variant || card?.hydrated) { content = renderDynamicText($el.getAttribute('data-content')); url = renderDynamicText(`{{ url }}`) } }"
    {% if show_conditionally == 'variants_only' %}
      x-show="!!content.trim() && (card?.product?.variants?.length > 1 || card?.product?.variants?.[0]?.title !== 'Default Title')"
    {% else %}
      x-show="!!content.trim()"
    {% endif %}
    x-cloak>
  <button type="button"
          @click="() => { $productDrawer.openProductDrawer({ product: card?.product }) }"
          x-html="content"
          class="w-full {{ button_class }}"></button>
</div>
