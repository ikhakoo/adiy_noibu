{%- comment -%} Auto Generated Variables start {%- endcomment -%}
{%- liquid
  assign block_type = "image"
  assign section_type = "card_page-card"
  assign primary_image = block.settings.primary_image
  assign show_secondary_image = block.settings.show_secondary_image
  assign secondary_image = block.settings.secondary_image
  assign padding_top_bottom_left_right = block.settings.padding_top_bottom_left_right
  assign width_height_aspect_object_fit = block.settings.width_height_aspect_object_fit
  assign border_width_radius = block.settings.border_width_radius
  assign background_color = block.settings.background_color
  assign background_gradient = block.settings.background_gradient
  assign border_color = block.settings.border_color
-%}
{%- comment -%} Auto Generated Variables end {%- endcomment -%}

{% render '_utils.dynamic-css',
    block: block,
    keys: "padding_top_bottom_left_right,background_color,background_gradient,border_color,border_width_radius"
%}

{% render '_utils.dynamic-css',
    block: block,
    selector: "& [data-style-image-container]",
    keys: "width_height_aspect_object_fit",
    css_variables: true
%}


<figure class="overflow-hidden shrink-0"
        data-style-id="{{ section.id }}--{{ block.id }}"
    {{ block.shopify_attributes }}
        x-show="primary_image || secondary_image"
        x-data="{ primary_image: getDynamicValue(`{{ primary_image }}`), secondary_image: getDynamicValue(`{{ secondary_image }}`)}">

  <div data-style-skeleton class="relative isolate" x-show="!card?.hydrated">
    <div class="h-full w-full animate-pulse rounded-md bg-gray-200/70">
    </div>
  </div>

  <a x-show="card?.hydrated" class="relative isolate block overflow-hidden group bg-inherit w-dynamic h-dynamic aspect-dynamic"
     data-style-image-container
     :aria-label="card?.page?.title"
     :title="card?.page?.title"
     :href="`${card?.page?.url}`">
    <img src=""
         x-show="!!primary_image"
         alt=""
         srcset=""
         :src="primary_image?.src ? primary_image?.src : primary_image"
         :alt="primary_image?.alt ?? card?.page?.title"
         :srcset="primary_image.src ? utils.getImageSrcSet(primary_image?.src ?? '', 800) : primary_image"
         width="732"
         height="732"
         loading="lazy"
         onload="this.classList.remove('!opacity-0')"
         class="pointer-events-none relative h-full w-full select-none overflow-hidden object-dynamic !opacity-0"
         sizes="(max-width: 768px) 50vw, (max-width: 1024px) 33vw, 25vw">
    {% if show_secondary_image %}
      <img x-show="!!secondary_image?.src"
           src=""
           alt=""
           srcset=""
           :src="secondary_image?.src"
           :alt="secondary_image?.alt ?? card?.page?.title"
           :srcset="utils.getImageSrcSet(secondary_image?.src ?? '', 800)"
           width="732"
           height="732"
           loading="lazy"
           onload="this.classList.remove('!opacity-0')"
           class="absolute inset-0 h-full w-full select-none overflow-hidden object-dynamic opacity-0 group-hf:opacity-100 bg-inherit !opacity-0"
           sizes="(max-width: 768px) 50vw, (max-width: 1024px) 33vw, 25vw">
    {% endif %}
    {% for block in section.blocks %}
      {% if block.type == 'layout__flex_wrap' and block.settings.location == 'over_image' %}
        <div class="absolute inset-0 grid overflow-hidden">
          {% render 'card_page-card.layout__flex_wrap', block: block, forloop: forloop %}
        </div>
      {% endif %}
    {% endfor %}
  </a>
</figure>
