{%- comment -%} Auto Generated Variables start {%- endcomment -%}
{%- liquid
  assign block_type = "sibling__color"
  assign section_type = "product"
  assign legend_label = block.settings.legend_label
  assign metafield = block.settings.metafield
  assign legend = block.settings.legend
  assign legend_class = block.settings.legend_class
  assign primary_source = block.settings.primary_source
  assign fallback_source = block.settings.fallback_source
  assign size_border_width_radius = block.settings.size_border_width_radius
  assign hover_border_color = block.settings.hover_border_color
  assign outline_width_offset = block.settings.outline_width_offset
  assign hover_outline_color = block.settings.hover_outline_color
  assign show_tooltip = block.settings.show_tooltip
  assign margin_top_gap = block.settings.margin_top_gap
  assign content_flow = block.settings.content_flow
  assign margin_top_bottom_left_right = block.settings.margin_top_bottom_left_right
  assign max_w_flex_col_row_order_align = block.settings.max_w_flex_col_row_order_align
  assign responsive_visibility = block.settings.responsive_visibility
  assign hide_if_empty = block.settings.hide_if_empty
  assign responsive_breakpoint = block.settings.responsive_breakpoint
  assign anchor_id = block.settings.anchor_id
  assign show_conditionally = block.settings.show_conditionally
-%}
{%- comment -%} Auto Generated Variables end {%- endcomment -%}

{% liquid
  assign namespace_key = metafield | replace: " ", "" | trim | strip_newlines | split: '.'
  assign metafield = product.metafields[namespace_key[0]][namespace_key[1]].value
  unless metafield.count > 0
    break
  endunless

  assign sibling_products = metafield | map: "product" | map: 'value'
  assign sibling_handles = metafield | map: "product" | map: 'value' | map: "handle"
  assign sibling_titles = metafield | map: "title" | map: "value"
  assign sibling_colors = metafield | map: "color" | map: 'value'
  assign sibling_images = metafield | map: "image" | map: 'value'
  assign sibling_swatch_titles = metafield | map: "swatch" | map: 'value' | map: "title" | map: 'value'
  assign sibling_swatch_colors = metafield | map: "swatch" | map: 'value' | map: "color" | map: 'value'
  assign sibling_swatch_images = metafield | map: "swatch" | map: 'value' | map: "image" | map: 'value'


  for object in metafield
    if object.product.value.handle == product.handle
      assign current_value = product.handle
      assign current_title = object.swatch.value.title.value | default: object.title.value
      break
    endif
  endfor

  if request.design_mode != true
    unless metafield.count > 0
      assign is_empty = true
    endunless
    if current_value == blank
      assign is_empty = true
    endif
    if hide_if_empty == 'block' and is_empty
      echo '<script type="block/hide"></script>'
      break
    endif
    if hide_if_empty == 'container' and is_empty
      echo '<script type="container/break"></script>'
      break
    endif
    if hide_if_empty == 'section' and is_empty
      echo '<script type="section/break"></script>'
      break
    endif
  endif

  if is_empty
    break
  endif

  assign content_legend = legend | replace: "[heading]", legend_label
  assign current_legend = content_legend | replace: "[value]", current_title | default: legend_label

  case content_flow
    when "show_all"
      assign container_classes = 'flex-wrap overflow-hidden'
    when "truncate"
      assign container_classes = 'overflow-hidden'
    when "overflow"
      assign container_classes = 'overflow-x-auto'
  endcase

  assign outline_classes = "!outline-none border-none ac:border-solid"
  assign outline_width = outline_width_offset | strip_newlines | split: '|' | first
  assign outline_width_desktop = outline_width | split: '/' | first
  assign outline_width_mobile = outline_width | split: '/' | last
%}
    
  <style>
    [data-style-id="{{ section.id }}--{{ block.id }}"] [data-style-label].active {
      border-color: {{ hover_border_color }};
    }
    [data-style-id="{{ section.id }}--{{ block.id }}"] [data-style-label].active:after {
      inset: 0;
      border-width: {{ outline_width_desktop | rstrip | replace: 'px', '' | append: 'px' }};
      border-color: {{ hover_outline_color }};
      border-radius: inherit;
      position: absolute;
      content: '';
    }
    @media screen and (max-width: {{ responsive_breakpoint | default: "768px" }}) {
      [data-style-id="{{ section.id }}--{{ block.id }}"] [data-style-label].active:after {
        border-width: {{ outline_width_mobile | rstrip | replace: 'px', '' | append: 'px' }};
      }
    }

  </style>

{% render '_utils.dynamic-css',
    block: block,
    selector: "& [data-style-container]",
    keys: "margin_top_gap" %}

{% render '_utils.dynamic-css',
    block: block,
    selector: "& [data-style-label]",
    keys: "size_border_width_radius, hover_outline_color" %}

{% render '_utils.dynamic-css',
    block: block,
    keys: "responsive_visibility,max_w_flex_col_row_order_align,padding_top_bottom_left_right,margin_top_bottom_left_right,border_width_radius,background_color,background_gradient,border_color" %}

<div
    data-style-id="{{ section.id }}--{{ block.id }}"
    {% if anchor_id != blank %}id="{{ anchor_id }}"{% endif %}
    {{ block.shopify_attributes }}
    x-show="$data.showConditionally('{{ show_conditionally }}')"
    data-block-type="{{ block.type }}">
  <fieldset x-data="{ current_sibling: $el.getAttribute('data-value'), hoverValue: $el.getAttribute('data-value'), sibling_handles: utils.JSONParse($el.getAttribute('data-values')) }"
            x-init="sibling_handles?.forEach(handle =>{ barba.prefetch(utils.getSiblingUrl(handle)) })"
            data-value="{{ current_value }}"
            data-values="{{ sibling_handles | json | escape }}"
  >
    <legend class="flex w-full max-w-full truncate {{ legend_class }}"
            data-legend="{% render '_input.inline_richtext', content: content_legend, escape: true, block: block, forloop: forloop %}"
            data-current-title="{{ current_title | escape }}"
            x-effect="$el.innerHTML = $el.getAttribute('data-legend').replace('[value]', $el.getAttribute('data-current-title'))">
      {% render '_input.inline_richtext', content: current_legend, block: block, forloop: forloop %}
    </legend>
    <div class="relative w-full flex scrollbar-none {{ container_classes }}"
         x-data="{ offset: +`{{ sibling_handles.size }}` }"
         data-style-container
         style="--gap-md: {{ gap | first }};--gap: {{ gap | last }};">
      {% for value in sibling_handles %}

        {% liquid
          assign i = forloop.index0
          assign title = sibling_titles[i] | handleize
          assign tooltip = sibling_swatch_titles[i] | default: sibling_colors[i]

          if value == blank or title == blank
            continue
          endif

          if sibling_products[i]
            assign _sibling_variant = null
            for sibling_variant in sibling_products[i].variants
              if sibling_variant.options[0] == product.options[0] and sibling_variant.options[1] == product.options[1] and sibling_variant.options[2] == product.options[2]
                assign _sibling_variant = sibling_variant
                break
              endif
            endfor
            if _sibling_variant == null
              for sibling_variant in sibling_products[i].variants
                if sibling_variant.options[0] == product.options[0] and sibling_variant.options[1] == product.options[1]
                  assign _sibling_variant = sibling_variant
                  break
                endif
              endfor
            endif
            if _sibling_variant == null
              for sibling_variant in sibling_products[i].variants
                if sibling_variant.options[0] == product.options[0]
                  assign _sibling_variant = sibling_variant
                  break
                endif
              endfor
            endif

            if _sibling_variant == null
              assign _sibling_variant = sibling_products[i].variants[0]
            endif

            assign current_image = _sibling_variant.image | default: product.image
          endif



          case primary_source
            when "title"
              assign primary_swatch = "--primary-swatch: var(--swatch-" | append: title | append: ")"
            when "image"
              assign image = current_image | image_url: width: 60, height: 60, crop: 'center' | escape
              assign primary_swatch = "--primary-swatch: url(" | append: image | append: ") center center/cover no-repeat"
            when "metafield"
              if sibling_colors[i] != blank
                assign primary_swatch = "--primary-swatch: " | append: sibling_colors[i]
              endif
              if sibling_swatch_colors[i] != blank
                assign primary_swatch = "--primary-swatch: " | append: sibling_swatch_colors[i]
              endif
              if sibling_images[i] != blank
                assign image = sibling_images[i] | image_url: width: 60, height: 60, crop: 'center' | escape
                assign primary_swatch = "--primary-swatch: url(" | append: image | append: ") center center/cover no-repeat"
              endif
              if sibling_swatch_images[i] != blank
                assign image = sibling_swatch_images[i] | image_url: width: 60, height: 60, crop: 'center' | escape
                assign primary_swatch = "--primary-swatch: url(" | append: image | append: ") center center/cover no-repeat"
              endif
          endcase

          case fallback_source
            when "title"
              assign fallback_swatch = "--fallback-swatch: var(--swatch-" | append: title | append: ")"
            when "image"
              assign image = current_image | image_url: width: 60, height: 60, crop: 'center' | escape
              assign fallback_swatch = "--fallback-swatch: url(" | append: image | append: ") center center/cover no-repeat"
            when "metafield"
              if sibling_colors[i] != blank
                assign fallback_swatch = "--fallback-swatch: " | append: sibling_colors[i]
              endif
              if sibling_swatch_colors[i] != blank
                assign fallback_swatch = "--fallback-swatch: " | append: sibling_swatch_colors[i]
              endif
              if sibling_images[i] != blank
                assign image = sibling_images[i] | image_url: width: 60, height: 60, crop: 'center' | escape
                assign fallback_swatch = "--fallback-swatch: url(" | append: image | append: ") center center/cover no-repeat"
              endif
              if sibling_swatch_images[i] != blank
                assign image = sibling_swatch_images[i] | image_url: width: 60, height: 60, crop: 'center' | escape
                assign fallback_swatch = "--fallback-swatch: url(" | append: image | append: ") center center/cover no-repeat"
              endif
          endcase
        %}

        <label class="shrink-0 flex border-gray-300 cursor-pointer relative {{ outline_classes }} {% if value == current_value %}active{% endif %}"
               x-effect="$el.classList.toggle('active', current_sibling === $el.getAttribute('data-value'))"
               data-style-label
               x-show="offset >= +`{{ forloop.index0 }}`"
            {% if show_tooltip %}
              @mouseenter="$tooltip.addTooltip($el, $el.getAttribute('aria-label'))"
              @mouseleave="$tooltip.removeTooltip($el)"
            {% endif %}
               @pointerenter="hoverValue = $el.getAttribute('aria-label')"
               @pointerleave="hoverValue = ''"
               aria-label="{{ tooltip }}"
               data-value="{{ value }}"
               style="{{ primary_swatch }};{{ fallback_swatch }};background: var(--primary-swatch, var(--fallback-swatch, {{ title }}))">
          <input type="radio"
                 class="sr-only"
              {% if show_tooltip %}
                @focus="$tooltip.addTooltip($el.parentElement, $el.value)"
                @blur="$tooltip.removeTooltip($el.parentElement)"
              {% endif %}
                 name="{{ block.id }}"
                 @change="$data.setSiblingProduct($el.value, $el.closest('[data-quick-view-container]'))"
                 :checked="current_sibling === $el.value"
                 value="{{ value }}">
        </label>
      {% endfor %}
      {% if content_flow == 'truncate' %}
        <div class="flex shrink-0 items-center text-sm font-medium"
             :class="offset < +`{{ sibling_handles.size }}` ? '':'opacity-0 pointer-events-none'"
             x-init="$nextTick(async ()=> { if (window.design_mode) { await utils.delay(20) } offset = truncateChildren($el, $el.parentElement)})"
             @resize.window.debounce.200ms="offset = +`{{ sibling_handles.size }}`; await utils.delay(20); offset = truncateChildren($el, $el.parentElement)"
             x-html="`+ ${+`{{ sibling_handles.size }}` - (offset + 1)} {{ legend_label }}`">
          +10 {{ legend_label }}
        </div>
      {% endif %}
    </div>
  </fieldset>
</div>
