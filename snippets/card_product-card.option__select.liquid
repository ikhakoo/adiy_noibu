{%- comment -%} Auto Generated Variables start {%- endcomment -%}
{%- liquid
  assign block_type = "option__select"
  assign section_type = "card_product-card"
  assign legend = block.settings.legend
  assign legend_class = block.settings.legend_class
  assign select_class = block.settings.select_class
  assign margin_top_gap = block.settings.margin_top_gap
  assign match_option_titles = block.settings.match_option_titles
  assign match_exact_word = block.settings.match_exact_word
  assign margin_top_bottom_left_right = block.settings.margin_top_bottom_left_right
  assign max_w_flex_col_row_order_align = block.settings.max_w_flex_col_row_order_align
  assign responsive_visibility = block.settings.responsive_visibility
  assign hide_if_empty = block.settings.hide_if_empty
  assign responsive_breakpoint = block.settings.responsive_breakpoint
  assign anchor_id = block.settings.anchor_id
  assign show_conditionally = block.settings.show_conditionally
-%}
{%- comment -%} Auto Generated Variables end {%- endcomment -%}

{% liquid
  assign content_legend = legend | replace: "[heading]", legend_label
%}

{% render '_utils.dynamic-css',
    block: block,
    selector: "& [data-style-select]",
    keys: "margin_top_gap" %}
{% render '_utils.dynamic-css', block: block %}

<div
    data-style-id="{{ section.id }}--{{ block.id }}"
    {% if anchor_id != blank %}id="{{ anchor_id }}"{% endif %}
    {{ block.shopify_attributes }}
    x-show="$data.showConditionally('{{ show_conditionally }}')">
  <fieldset data-style-id="{{ section.id }}--{{ block.id }}"
            x-data="{ index: getOptionIndex($el.getAttribute('data-block-id'))}"
            x-effect="() => { if (card?.product?.id) { index = getOptionIndex(`{{ block.id }}`) } }"
            x-show="index !== -1 && card?.hydrated && card?.product?.variants?.length && card?.product?.variants?.[0]?.title !== 'Default Title' && card?.selected_variant?.id"
            x-cloak
            data-block-id="{{ block.id }}">
    <legend class="flex w-full max-w-full truncate {{ legend_class }}"
            data-legend="{% render '_input.inline_richtext', content: legend, escape: true, block: block, forloop: forloop %}"
            x-effect="$el.innerHTML = $el.getAttribute('data-legend').replace('[heading]',card?.product?.options[index]).replace('[value]', card?.options[index])">
    </legend>
    {% render "_components.select",
        dynamic: true,
        values: 'card?.product?.options_with_values[index]?.values ?? []',
        titles: 'card?.product?.options_with_values[index]?.values ?? []',
        disabled_items: 'card?.product?.options_with_values[index]?.values?.map(value => !hasAvailableVariant(index, value)) ?? []',
        select_class: select_class,
        label: legend_label,
        setState: "$data.setProductOption({ index, value })",
        state: "card?.options[index]",
        current_value: 'card?.options[index]',
        current_title: 'card?.options[index]',
        html_attributes: "data-style-select"
    %}
  </fieldset>
</div>
