{%- comment -%}
  Custom isolated offer block for Shopify theme engines.
  Hooks into layout loops natively without breaking context scopes.
{%- endcomment -%}

<div class="mpb-block-wrapper-{{ block.id }}" {{ block.shopify_attributes }}>
  <style>
    .mpb-block-wrapper-{{ block.id }} {
      /* Encapsulated Token Properties */
      --mpb-b-bg: {{ block.settings.bg_color | default: '#FFFDF6' }};
      --mpb-b-border: {{ block.settings.border_color | default: '#F4EFE0' }};
      --mpb-b-star: {{ block.settings.star_color | default: '#E48324' }};
      --mpb-b-dark: {{ block.settings.text_dark_color | default: '#000000' }};
      --mpb-b-muted: {{ block.settings.text_muted_color | default: '#666666' }};
      --mpb-b-btn-bg: {{ block.settings.btn_bg_color | default: '#A66D34' }};
      --mpb-b-btn-text: {{ block.settings.btn_text_color | default: '#FFFFFF' }};

      width: 100%;
      margin: 16px 0 0;
      padding-bottom: 20px;
      box-sizing: border-box;
      border-bottom: 1px solid #ebebeb;
    }

    .mpb-embedded-card-{{ block.id }} {
      width: 100%;
      background-color: var(--mpb-b-bg);
      border: 1px solid var(--mpb-b-border);
      border-radius: 12px;
      padding: 10px 15px;
      box-sizing: border-box;
      text-align: center;
    }

    .mpb-e-badge-row {
      display: flex;
      align-items: center;
      justify-content: center;
      gap:20px;
      margin-bottom: 12px;
    }

    .mpb-e-stars {
      display: flex;
      gap: 6px;
      color: var(--mpb-b-star);
      font-size: 22px;
      line-height: 1;
      letter-spacing: 5px;
    }

    .mpb-e-badge-text {
      color: #a66d34;
      font-size: {{ block.settings.header_font_size }}px;
      font-weight: {{ block.settings.header_font_weight | default: '600' }};
      letter-spacing: 2px;
      text-transform: uppercase;
      margin: 0;
    }

    .mpb-e-headline {
      color: var(--mpb-b-muted);
      font-size: {{ block.settings.main_font_size }}px;
      font-weight: {{ block.settings.main_font_weight | default: '300' }};
      letter-spacing: 0.5px;
      text-transform: uppercase;
      margin: 0;
      line-height: 1.2;
    }

    .mpb-e-headline strong {
      color: var(--mpb-b-dark);
      font-weight: 700;
    }

    .mpb-e-action-btn {
      display: block;
      width: 100%;
      background-color: var(--mpb-b-btn-bg);
      color: var(--mpb-b-btn-text);
      font-size: {{ block.settings.btn_font_size }}px;
      font-weight: {{ block.settings.btn_font_weight | default: '700' }};
      border: none;
      border-radius: 8px;
      padding: 14px 20px;
      cursor: pointer;
      transition: opacity 0.2s ease;
      box-sizing: border-box;
      text-align: center;
      text-transform: none;
      letter-spacing: 0.5px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }

    .mpb-e-action-btn:hover {
      opacity: 0.93;
    }

    .mpb-e-urgency-note {
      color: var(--mpb-b-dark);
      font-size: {{ block.settings.footer_font_size }}px;
      font-weight: 600;
      margin: 12px 0 0 0;
      opacity: 0.8;
      letter-spacing: 0.5px;
    }

    @media (max-width:768px){
      .mpb-embedded-card-{{ block.id }} {
        padding: 20px 15px;
        padding-bottom:5px;
      }
      .mpb-e-stars {
        font-size: 16px;
        letter-spacing: 2px;
      }
      .mpb-e-badge-text {
        font-size: 13px;
        letter-spacing: 1px;
      }
      .mpb-e-headline {
        font-size: 26px;
      }
    }
    .cs-countdown-timer{
      margin: 20px 0;
      margin-bottom: 0;
    }
    .cs-countdown-timer__copy { min-width: 240px; }
    .cs-countdown-timer__heading {
      margin: 0 0 8px;
      font-size: clamp(24px, 3vw, 32px);
      font-weight: 700;
      line-height: 1.1;
      color: var(--cd-text);
      letter-spacing: -0.01em;
    }
    .cs-countdown-timer__sub {
      margin: 0;
      font-size: clamp(16px, 1.6vw, 19px);
      font-weight: 400;
      line-height: 1.4;
      opacity: 0.92;
      max-width: 30ch;
    }
    .cs-countdown-timer__timer {
      display: flex;
      align-items: center;
      gap: 10px;
      justify-content:center;
    }
    .cs-countdown-timer__unit {
      display: flex;
      flex-direction: column;
      align-items: center;
      min-width: 52px;
      background: #fff;
      border: 1px solid #f2f2f2;
      border-radius: 10px;
      width: 70px;
      height: 70px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .cs-countdown-timer__num {
      font-size: clamp(20px, 4vw, 30px);
      font-weight: 600;
      line-height: 1;
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.02em;
    }
    .cs-countdown-timer__label {
      font-size: 14px;
      font-weight: 400;
      opacity: 0.9;
      margin-top: 8px;
    }
    .cs-countdown-timer__sep {
      font-size: clamp(28px, 3.6vw, 38px);
      font-weight: 500;
      line-height: 1;
      margin-top: 2px;
      opacity: 0.85;
    }
    .cs-countdown-timer.is-expired .cs-countdown-timer__timer { display: none; }
    .cs-countdown-timer__expired-msg {
      font-size: clamp(18px, 2vw, 22px);
      font-weight: 600;
    }

    @media (max-width: 600px) {
      .cs-countdown-timer {
        flex-direction: column;
        align-items: flex-start;
        padding: 24px;
        padding-bottom:0;
        gap: 18px;
      }
      .cs-countdown-timer{
        margin: 0;
      }
      .cs-countdown-timer__timer { align-self: stretch; justify-content: space-between; }
      .cs-countdown-timer__sub { max-width: none; }
    }
  </style>

  <div class="mpb-embedded-card-{{ block.id }}">
    {%- comment -%}
  Countdown banner
  Paste this whole block into a "Custom Liquid" section/block on the product page.
  Edit the values in the assign block below. Nothing else needs touching.

  Deadline format: 'YYYY-MM-DDTHH:MM:SS' followed by your timezone offset.
  Examples: '2026-07-15T23:59:59-04:00' (Eastern, EDT) or '2026-07-15T23:59:59Z' (UTC).
  Set it in the timezone you want the sale to end in, or the math will drift.
{%- endcomment -%}

{%- assign cd_heading    = 'July 4th Sale' -%}
{%- assign cd_subtext    = 'Save $1000.' -%}
{%- assign cd_deadline   = '2026-07-05T00:00:00-07:00' -%}
{%- assign cd_bg         = '#4177AD' -%}
{%- assign cd_text       = '#ffffff' -%}
{%- assign cd_border     = '#e7e7e7' -%}
{%- assign cd_radius     = '16px' -%}
{%- comment -%} Text shown once the timer hits zero. {%- endcomment -%}
{%- assign cd_expired    = 'This sale has ended.' -%}


    <div class="mpb-e-badge-row">
      <div class="mpb-e-stars">
        <img
          src="https://cdn.shopify.com/s/files/1/0456/9638/5046/files/flag-Stars-and-Stripes-May-1-1795.webp?v=1782747101"
          alt="image" width="30">
      </div>
      <p class="mpb-e-badge-text">{{ block.settings.header_text }}</p>
      <div class="mpb-e-stars">
        <img
          src="https://cdn.shopify.com/s/files/1/0456/9638/5046/files/flag-Stars-and-Stripes-May-1-1795.webp?v=1782747101"
          alt="image" width="30">
      </div>
    </div>

    <div class="cs-countdown-timer" data-deadline="{{ block.settings.countdown_deadline }}" data-expired="Offer Expired">
      <div class="cs-countdown-timer__timer" role="timer" aria-live="off">
        <div class="cs-countdown-timer__unit">
          <span class="cs-countdown-timer__num" data-cd="days">00</span>
          <span class="cs-countdown-timer__label">days</span>
        </div>
        <span class="cs-countdown-timer__sep" aria-hidden="true">:</span>
        <div class="cs-countdown-timer__unit">
          <span class="cs-countdown-timer__num" data-cd="hrs">00</span>
          <span class="cs-countdown-timer__label">hrs</span>
        </div>
        <span class="cs-countdown-timer__sep" aria-hidden="true">:</span>
        <div class="cs-countdown-timer__unit">
          <span class="cs-countdown-timer__num" data-cd="min">00</span>
          <span class="cs-countdown-timer__label">min</span>
        </div>
        <span class="cs-countdown-timer__sep" aria-hidden="true">:</span>
        <div class="cs-countdown-timer__unit">
          <span class="cs-countdown-timer__num" data-cd="secs">00</span>
          <span class="cs-countdown-timer__label">secs</span>
        </div>
      </div>
    </div>

    <h2 class="mpb-e-headline">
      <strong>{{ block.settings.highlight_text }}</strong> {{ block.settings.main_text }}
    </h2>

    {% if block.settings.btn_text != blank %}
      <button type="button" class="mpb-e-action-btn mpb-js-trigger-{{ block.id }}">
        {{ block.settings.btn_text }}
        <svg width="20px" height="auto" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M16.3153 16.6681C15.9247 17.0587 15.9247 17.6918 16.3153 18.0824C16.7058 18.4729 17.339 18.4729 17.7295 18.0824L22.3951 13.4168C23.1761 12.6357 23.1761 11.3694 22.3951 10.5883L17.7266 5.9199C17.3361 5.52938 16.703 5.52938 16.3124 5.91991C15.9219 6.31043 15.9219 6.9436 16.3124 7.33412L19.9785 11.0002L2 11.0002C1.44772 11.0002 1 11.4479 1 12.0002C1 12.5524 1.44772 13.0002 2 13.0002L19.9832 13.0002L16.3153 16.6681Z" fill="#fff"/>
        </svg>
      </button>
    {% endif %}

    <p class="mpb-e-urgency-note">{{ block.settings.footer_text }}</p>
  </div>

 <script>
  (function() {
    // DOM ready hone ka wait karein
    function initKlaviyoTrigger() {
      const blockWrapper = document.querySelector('.mpb-block-wrapper-{{ block.id }}');
      if (!blockWrapper) return;

      const actionButton = blockWrapper.querySelector('.mpb-js-trigger-{{ block.id }}');
      
      if (actionButton) {
        actionButton.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();

          // Target 1: Direct pointer span jo aapke inspect element mein dikh rha hai
          let klaviyoTarget = document.querySelector('.needsclick.Teaser--pointer-Hn1zd') 
                           || document.querySelector('[data-testid="animated-teaser"] .needsclick')
                           || document.querySelector('[data-testid="animated-teaser"]')
                           || document.querySelector('.needsclick.kl-teaser-XTnNTX');

          if (klaviyoTarget) {
            // Native click event simulate karna
            klaviyoTarget.click();
          } else {
            // Backup Fallback: Agar upar wale matches direct fail hon class rotation ki waja se
            const allTeasers = document.querySelectorAll('[class*="kl-teaser"], [class*="Teaser"]');
            let clicked = false;
            
            allTeasers.forEach(function(el) {
              if (el.classList.contains('needsclick') && typeof el.click === 'function') {
                el.click();
                clicked = true;
              }
            });

            if (!clicked) {
              console.warn('Klaviyo popup element directly DOM mein nahi mila. Make sure Klaviyo properly load ho chuka hai.');
            }
          }
        });
      }
    }

    // Shopify customizer support aur safe rendering ke liye execute karein
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initKlaviyoTrigger);
    } else {
      initKlaviyoTrigger();
    }
  })();


  {% comment %} countdown timer {% endcomment %}
  (function () {
    function pad(n) { return n < 10 ? '0' + n : '' + n; }

    function startTimer(el) {
      if (el.dataset.cdBound === '1') return;
      el.dataset.cdBound = '1';

      var deadline = new Date(el.getAttribute('data-deadline')).getTime();
      var expiredText = el.getAttribute('data-expired') || '';
      var fields = {
        days: el.querySelector('[data-cd="days"]'),
        hrs:  el.querySelector('[data-cd="hrs"]'),
        min:  el.querySelector('[data-cd="min"]'),
        secs: el.querySelector('[data-cd="secs"]')
      };

      function expire() {
        el.classList.add('is-expired');
        if (expiredText && !el.querySelector('.cs-countdown-timer__expired-msg')) {
          var msg = document.createElement('div');
          msg.className = 'cs-countdown-timer__expired-msg';
          msg.textContent = expiredText;
          el.appendChild(msg);
        }
      }

      function tick() {
        var diff = deadline - Date.now();
        if (isNaN(deadline)) { expire(); return; }
        if (diff <= 0) { expire(); clearInterval(timer); return; }

        var s = Math.floor(diff / 1000);
        fields.days.textContent = pad(Math.floor(s / 86400));
        fields.hrs.textContent  = pad(Math.floor((s % 86400) / 3600));
        fields.min.textContent  = pad(Math.floor((s % 3600) / 60));
        fields.secs.textContent = pad(s % 60);
      }

      tick();
      var timer = setInterval(tick, 1000);
    }

    function init() {
      document.querySelectorAll('.cs-countdown-timer').forEach(startTimer);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
</div>