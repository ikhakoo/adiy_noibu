{%- comment -%} Auto Generated Variables start {%- endcomment -%}
{%- liquid
  assign block_type = "accordion"
  assign section_type = "global_design-elements"
  assign title = block.settings.title
  assign font_family = block.settings.font_family
  assign size_weight_height_opacity = block.settings.size_weight_height_opacity
  assign spacing_transform_style_whitespace = block.settings.spacing_transform_style_whitespace
  assign padding_top_bottom_left_right = block.settings.padding_top_bottom_left_right
  assign icon_style = block.settings.icon_style
  assign icon = block.settings.icon
  assign width_height = block.settings.width_height
  assign richtext_class = block.settings.richtext_class
  assign content_top_bottom_left_right = block.settings.content_top_bottom_left_right
  assign borders_top_bottom_left_right = block.settings.borders_top_bottom_left_right
  assign border_width_radius = block.settings.border_width_radius
  assign responsive_breakpoint = block.settings.responsive_breakpoint
  assign apply_container_queries = block.settings.apply_container_queries
  assign background_color = block.settings.background_color
  assign background_gradient = block.settings.background_gradient
  assign text_color = block.settings.text_color
  assign border_color = block.settings.border_color
  assign mobile_background_color = block.settings.mobile_background_color
  assign mobile_background_gradient = block.settings.mobile_background_gradient
  assign mobile_text_color = block.settings.mobile_text_color
  assign mobile_border_color = block.settings.mobile_border_color
  assign override_preview_background = block.settings.override_preview_background
-%}
{%- comment -%} Auto Generated Variables end {%- endcomment -%}

{%- liquid
  assign selector = '.' | append: title
  assign summary_selector = selector | append: " .accordion-summary"
  assign icon_selector = selector | append: " [data-style-accordion-icon]"
  render '_utils.dynamic-css', selector: summary_selector, block: block, keys: 'font_family, size_weight_height_opacity, spacing_transform_style_whitespace, padding_top_bottom_left_right,background_color,background_gradient,text_color'

  assign content_top_bottom_left_right = content_top_bottom_left_right | strip_newlines | replace: ' ', "" | split: '|'
  assign content_top = content_top_bottom_left_right[0] | split: '/'
  assign content_bottom = content_top_bottom_left_right[1] | split: '/'
  assign content_left = content_top_bottom_left_right[2] | split: '/'
  assign content_right = content_top_bottom_left_right[3] | split: '/'

  assign borders_top_bottom_left_right = borders_top_bottom_left_right | strip_newlines | replace: ' ', "" | split: '|'
  assign borders_top = borders_top_bottom_left_right[0] | split: '/'
  assign borders_bottom = borders_top_bottom_left_right[1] | split: '/'
  assign borders_left = borders_top_bottom_left_right[2] | split: '/'
  assign borders_right = borders_top_bottom_left_right[3] | split: '/'

%}

{% render '_utils.dynamic-css',
    selector: selector,
    block: block, keys: 'border_color, border_width_radius'
%}
{% render '_utils.dynamic-css',
    selector: icon_selector,
    block: block, keys: 'width_height'
%}

{%- capture css_desktop -%}

  {% case icon_style %}
    {% when "plus" %}
      .{{ title }} .simple-icon {
      display: none !important;
      }


    {% when "icon_plain" %}
      .{{ title }} .animated-icon {
      display: none !important;
      }
      .{{ title }} {
      --accordion-icon: var(--icon-{{ icon | handleize }});
      --accordion-icon-aspect-ratio: var(--icon-{{ icon | handleize }}-aspect-ratio);
      }

    {% when "icon_rotating" %}
      .{{ title }} .animated-icon {
      display: none !important;
      }
      .{{ title }} {
      --accordion-icon: var(--icon-{{ icon | handleize }});
      --accordion-icon-aspect-ratio: var(--icon-{{ icon | handleize }}-aspect-ratio);
      --accordion-icon-rotate: -180deg;
      }
    {% when "icon_rotating" %}
      .{{ title }} .animated-icon {
      display: none !important;
      }
      .{{ title }} {
      --accordion-icon: var(--icon-{{ icon | handleize }});
      --accordion-icon-aspect-ratio: var(--icon-{{ icon | handleize }}-aspect-ratio);
      --accordion-icon-rotate: -180deg;
      }
    {% when "none" %}
      .{{ title }} .animated-icon {
      display: none !important;
      }
      .{{ title }} .simple-icon {
      display: none !important;
      }
  {% endcase %}

  .{{ title }} {
  border-style: solid;
  border-color: {{ border_color }};
  border-width: {{ borders_top | first }} {{ borders_right | first }} {{ borders_bottom | first }} {{ borders_left | first }};
  --richtext-class: {{ richtext_class }};
  }

  .{{ title }} .accordion-summary {
  position: relative;
  display: flex;
  height: max-content;
  width: 100%;
  align-items: center;
  justify-content: space-between;
  user-select: none;
  }

  .{{ title }} .accordion-content {
  padding: {{ content_top | first }} {{ content_right | first }} {{ content_bottom | first }} {{ content_left | first }};
  color: {{ text_color }};
  background: {{ background_gradient | default: background_color }};
  }

{%- endcapture -%}

{%- capture css_mobile -%}
  .{{ title }} {
  border-color: {{ mobile_border_color }};
  border-width: {{ borders_top | last }} {{ borders_right | last }} {{ borders_bottom | last }} {{ borders_left | last }};
  }

  .{{ title }} .accordion-content {
  padding: {{ content_top | last }} {{ content_right | last }} {{ content_bottom | last }} {{ content_left | last }};
  color: {{ mobile_text_color }};
  background: {{ mobile_background_gradient | default: mobile_background_color }};
  }

{%- endcapture -%}

<style>
  {{- css_desktop | strip_newlines  -}}

  @media screen and (max-width: 767px) {
  {{- css_mobile | strip_newlines  -}}
  }

  @container (max-width: 767px) {
  {{- css_mobile | strip_newlines  -}}
  }
</style>

