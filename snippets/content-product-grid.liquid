{%- comment -%} Auto Generated Variables start {%- endcomment -%}
{%- liquid
  assign section_type = "content-product-grid"
  assign products = section.settings.products
  assign _collection = section.settings.collection
  assign display_limit_pagination_limit = section.settings.display_limit_pagination_limit
  assign pagination_class = section.settings.pagination_class
  assign product_card_class = section.settings.product_card_class
  assign grid_cols_align_x_align_y_gap = section.settings.grid_cols_align_x_align_y_gap
  assign section_id = section.settings.section_id
  assign color_scheme = section.settings.color_scheme
  assign container_spacing = section.settings.container_spacing
  assign border_divider = section.settings.border_divider
  assign top_bottom_min_height = section.settings.top_bottom_min_height
  assign responsive_visibility = section.settings.responsive_visibility
  assign responsive_breakpoint = section.settings.responsive_breakpoint
  assign target_visibility = section.settings.target_visibility
  assign metafield_keys = section.settings.metafield_keys
-%}
{%- comment -%} Auto Generated Variables end {%- endcomment -%}

{% capture section_content %}

  {% liquid
    assign display_limit_pagination_limit = display_limit_pagination_limit | strip_newlines | replace: ' ', "" | split: '|'
    assign display_limit = display_limit_pagination_limit[0] | split: '/'
    assign pagination_limit = display_limit_pagination_limit[1] | split: '/' | first | abs

    assign desktop_display_limit = display_limit.first | abs
    assign mobile_display_limit = display_limit.last | abs

    assign max_display_limit = desktop_display_limit | at_least: mobile_display_limit | default: 12
    assign collection_iteration_limit = max_display_limit | at_most: 50

    assign _products = products | uniq

    if _products == blank and request.visual_preview_mode
      assign _products = collections.all
    endif

    for _prod in _collection.products limit: collection_iteration_limit
      assign _product = _prod | uniq
      assign _products = _products | concat: _product | uniq
    endfor
  %}

  {% render '_utils.dynamic-css',
      block: block,
      selector: "& [data-style-content-product-grid]",
      keys: "grid_cols_align_x_align_y_gap"
  %}

  {% render "_section.universal-settings", section_type: section_type, insert: "before" %}
  {% if current_page > 1 %}
    {%- capture contentForQuerystring -%}{{ content_for_header }}{%- endcapture -%}
    {%- assign query_params = contentForQuerystring | split: '"pageurl":"' | last | split: '"' | first | replace: '\/', '/' | replace: '%20', ' ' | replace: '\u0026', '&' | split: "?" | last -%}
    {% assign query_pagination_limit = query_params | split: "pagination_limit=" | last | split: "&" | first | abs %}
    {% if query_pagination_limit != blank and query_pagination_limit != 0 %}
      {% assign pagination_limit = query_pagination_limit | default: pagination_limit %}
    {% endif %}
  {% endif %}

  {% if pagination_limit > 0 and collection.id and _products.size == 0 or collection.id == _collection.id %}
    {% paginate collection.products by pagination_limit %}
      {% assign _products = collection.products %}
      {% assign _paginate = paginate %}
    {% endpaginate %}
  {% endif %}

  {% if pagination_limit == 0 and collection.id and _products.size == 0 or collection.id == _collection.id %}
    {% paginate collection.products by 24 %}
      {% assign _products = collection.products %}
      {% assign _paginate = paginate %}
    {% endpaginate %}
  {% endif %}

  {% liquid
    assign filter_sort_bar_block = section.blocks | where: "type", "filter_sort_bar" | first
    assign filter_sidebar_block = section.blocks | where: "type", "filter_sidebar" | first
    assign active_filters_bar_block = section.blocks | where: "type", "active_filters_bar" | first
    if filter_sidebar_block
      assign grid_layout_classes = 'grid lg:grid-cols-[320px_1fr] gap-x-6'
    endif
  %}

  <form class="{{ grid_layout_classes }}"
        x-effect="() => $el.setAttribute('class', show_filter_sidebar ? gridClasses : '')"
        x-data="{
        loading: false,
        show_filter_sidebar: $data.windowWidth >= 1024 && `{{ filter_sidebar_block.settings.view_state }}` === 'open',
        gridClasses: `{{ grid_layout_classes }}`,
        update_filters: async (url) => {
          const content = await fetch(url).then(res=> res.text())
          url.searchParams.delete('barba_prefetch')
          barba.history.add(url.toString(), 'barba', 'replace');
          const div = document.createElement('div')
          div.innerHTML = content;
          const target = div.querySelector(`[data-style-id='{{ section.id }}'] form`)
          const navbar = $el.querySelector(`[x-ref='filter_nav_bar']`)
          const new_navbar = target?.querySelector(`[x-ref='filter_nav_bar']`)
          const grid = $el.querySelector(`[x-ref='content_grid']`)
          const new_grid = target?.querySelector(`[x-ref='content_grid']`)
          if (navbar && new_navbar) {
            navbar.innerHTML = new_navbar.innerHTML
          }
          if (grid && new_grid) {
            grid.innerHTML = new_grid.innerHTML
          }

          target?.querySelectorAll(`[data-filter-param]`).forEach(filter => {
             const filterElement = $el.querySelector(`[data-filter-param='${filter.getAttribute('data-filter-param')}']`)
             if (filterElement) {
                 filterElement.innerHTML = filter.innerHTML
             }
          })
          const header = document.querySelector('.header-sections-container');
          const offsetHeight = Math.max(0, header?.getBoundingClientRect()?.bottom ?? 0);

          utils.scrollToY(150, utils.getElementPosition($el).top - offsetHeight - +getComputedStyle($el).paddingTop.replace('px', ''))
        },
        debounce_update_filters: utils.debounce(() => { $el.dispatchEvent(new Event('submit')) } ,750)
        }"
        @submit.stop.prevent="async (e) => {
          const searchParams = new URLSearchParams(new FormData($el)).toString()
          const url = new URL($el.action?.split('?')[0] + '?barba_prefetch=true&' + searchParams)
          loading = true
          await update_filters(url)
          loading = false
          if (window.innerWidth < 1024) {
            show_filter_sidebar = false
          }
        }"
        @input="(e)=> { if (e.target.closest(`[data-product-grid]`)) { return; } debounce_update_filters()}">
    {% if filter_sort_bar_block %}
      {% render 'content-product-grid.filter_sort_bar', block: filter_sort_bar_block, object: collection %}
    {% endif %}
    {% if filter_sidebar_block %}
      {% render 'content-product-grid.filter_sidebar', block: filter_sidebar_block, object: collection %}
    {% endif %}
    <div x-ref="content_grid">
      {% if active_filters_bar_block %}
        {% render 'content-product-grid.active_filters_bar', block: active_filters_bar_block, object: collection %}
      {% endif %}
      <main data-product-grid
            x-data="{ next_url: `{{ _paginate.next.url }}`, loading: false, count: $refs?.content?.children?.length, max_limit: +`{{ max_display_limit }}`, desktop_limit: +`{{ desktop_display_limit }}`, mobile_limit: +`{{ mobile_display_limit }}` }">
        <div class="grid"
            data-style-content-product-grid="{{ section.id }}"
            x-ref="content"
            data-next-url="{{ _paginate.next.url }}">
          {% if _paginate.current_page == 1 or _paginate == null %}
            {% for block in section.blocks %}
              {% if block.type == 'layout__flex' %}
                {% render 'content-grid.layout__flex', block: block, forloop: forloop, section_type: section_type, form: form, columnIndex: forloop.index0 %}
              {% endif %}
              {% if block.type == 'layout__grid' %}
                {% render 'content-grid.layout__grid', block: block, forloop: forloop, section_type: section_type, form: form, columnIndex: forloop.index0 %}
              {% endif %}
              {% if block.type == 'layout__grid_slider' %}
                {% render 'content-grid.layout__grid_slider', block: block, forloop: forloop, section_type: section_type, form: form, columnIndex: forloop.index0 %}
              {% endif %}
            {% endfor %}
          {% endif %}
          {% for product in _products limit: max_display_limit %}
            {% assign product_visibility = "" %}
            {% if forloop.index > desktop_display_limit %}
              {% assign product_visibility = "mobile-only" %}
            {% endif %}
            {% if forloop.index > mobile_display_limit %}
              {% assign product_visibility = "desktop-tablet-only" %}
            {% endif %}
            {% assign pagination_size = _paginate.current_page | minus: 1 | times: _paginate.page_size %}
            <div class="{{ product_visibility }} shrink-0 max-w-full w-full h-full"
                 style="order: {{ forloop.index | plus: pagination_size | times: 10 }}">
              <section
                  class="card-loading product-card--{{ product_card_class }}"
                  data-product-handle="{{ product.handle }}"
                  data-product-id="{{ product.id }}"
                  x-data="{}"
                  {% if request.visual_preview_mode %}
                    data-intersected
                  {% endif %}
                  x-init="() => $nextTick(() => _sections.hydrateProductCard($el, '{{ product_card_class }}', $el.getAttribute('data-product-handle'), $el.getAttribute('data-product-id'), ['h-full']))"></section>
              <script type="application/json"
                      data-product-data="{{ product.handle }}">{%- render '_json.product', product: product, meta_product: true, meta_keys: metafield_keys -%}</script>
            </div>
          {% endfor %}
        </div>
      {% if max_display_limit >= 999 %}
        {% if _paginate.next.url and _paginate.current_page == 1 %}
          <div x-show="!!next_url"
               class="p-4"
               x-data="{loadPages: async () => {
                if (next_url && !loading) {
                  loading = true;
                  const data = await fetch(`${next_url}&sections={{ section.id }}&pagination_limit={{ pagination_limit }}`).then((data) => data.json());
                  const div = document.createElement('div');
                  div.innerHTML = data['{{ section.id }}'];
                  const root = div.querySelector(`[data-style-content-product-grid='{{ section.id }}']`);
                  next_url = root.getAttribute('data-next-url');
                  [...(root?.children ?? [])].forEach((child) => {
                    if (count >= max_limit) {
                        next_url = '';
                        loading = false
                        return;
                    }
                    if (count >= desktop_limit) {
                      child.classList.add('mobile-only')
                    }
                    if (count >= mobile_limit) {
                      child.classList.add('desktop-tablet-only')
                    }
                    $refs?.content?.appendChild(child)
                    count = $refs?.content?.children?.length;
                  });
                  loading = false;
                }
               }}"
               x-intersect.margin.1200px="loadPages"
               x-effect="()=> {
              if (!loading && ($el.getBoundingClientRect().top - window.innerHeight) < 1200) {
                loadPages();
              }
            }">
            <div class="relative h-12 button-loading">
            </div>
          </div>
        {% endif %}
      {% else %}
        {% if pagination_class != blank %}
          {% render "_components.pagination",
              class: pagination_class,
              paginate: _paginate,
              pagination_container_ref: '$refs.content',
              html_attributes: 'data-style-pagination' %}
        {% endif %}
      {% endif %}
      </main>
    </div>
  </form>
  {% render "_section.universal-settings", insert: "after" %}

{% endcapture %}

{% if section_content contains '/break"></script>' %}
  {% break %}
{% endif %}
{{ section_content }}
