{%- comment -%} Auto Generated Variables start {%- endcomment -%}
{%- liquid
  assign section_type = "content-cards"
  assign background_image = section.settings.background_image
  assign title = section.settings.title
  assign title_class = section.settings.title_class
  assign subtitle = section.settings.subtitle
  assign subtitle_class = section.settings.subtitle_class
  assign text_color = section.settings.text_color
  assign vertical_padding_section = section.settings.vertical_padding_section
  assign section_id = section.settings.section_id
  assign container_spacing = section.settings.container_spacing
  assign responsive_visibility = section.settings.responsive_visibility
-%}
{%- comment -%} Auto Generated Variables end {%- endcomment -%}

{% liquid
  assign background_color = "background-color: " | append: background_color | append: ";"

  assign slider_overflow = "max-md:-mx-4 max-lg:-mx-9 max-lg:scroll-px-[var(--layout-container-padding-md)] max-lg:px-6" 
  assign slider_gap = "gap-3 xl:gap-6 px-6"
  assign section_gap = "gap-6"
  assign grid_cols = "max-lg:auto-cols-[calc((100%_-_(12px_*_(1.05_-_1)))_/_1.05)] lg:auto-cols-[calc((100%_-_(12px_*_(3.3_-_1)))_/_3.3)] xl:auto-cols-[calc((100%_-_(24px_*_(4_-_1)))_/_4)]"
  assign background_image_class = "w-full h-full max-lg:object-cover"

  assign vertical_padding_section = vertical_padding_section | strip_newlines | replace: ' ', "" | split: '|'
  assign pt = vertical_padding_section[0] | split: '/'
  assign pb = vertical_padding_section[1] | split: '/'

  assign pagination_block = section.blocks | where: "type", "pagination" | first
%}

<style>
  #{{ section.id }} {
    padding-top: {{ pt.first }};
    padding-bottom: {{ pb.first }};
  }
  @media (max-width: 768px) {
    #{{ section.id }} {
      padding-top: {{ pt.last }};
      padding-bottom: {{ pb.last }};
    }
  }
</style>

{% render "_section.universal-settings", section_type: section_type, styles: background_color, section_id: section.id, insert: "before" %}

<section class="flex flex-col {{ section_gap }}" style="color: {{ text_color }};">
  <div class="flex flex-col gap-4 md:gap-3 justify-center text-center w-full max-w-[960px] place-self-center">
    {% render '_input.richtext', content: title, class: title_class, block: block, forloop: forloop %}
    {% render '_input.richtext', content: subtitle, class: subtitle_class, block: block, forloop: forloop %}
  </div>
  <div class="flex flex-col relative"
        x-defer="intersect"
        data-grid-slider
        x-data="{ ..._sections.initContentSlider($refs.container, undefined, false) }">
    <picture class="absolute inset-0 pointer-events-none block max-md:w-[calc(100%_+_32px)] max-lg:w-[calc(100%_+_72px)] max-md:-left-4 max-lg:-left-9 overflow-hidden{% if background_image == blank %} hidden{% endif %}"
              style="z-index: -10;">
      {% render '_object.image', image: background_image, sizes: "100vw", class: background_image_class, preload: false %}
    </picture>
    <div class="relative grid grid-flow-col-dense {{ grid_cols }} {{ slider_gap }} place-content-center overflow-x-auto scrollbar-none overflow-y-hidden snap-x snap-mandatory scrollbar-none {{ slider_overflow }} pt-14 pb-[calc(48px_+_32px)] md:py-24"
          x-ref="container"
          @resize.window="content_slider.handleResize"
          x-init="$nextTick(() => content_slider.handleResize())"
          @scroll="content_slider.handleScroll"
          data-style-content-slider>
      {% liquid
        for block in section.blocks
          if block.type == 'card'
            render 'content-cards.card', block: block, forloop: forloop, section_type: section_type
          endif
        endfor
      %}
    </div>
    {% if pagination_block %}
      {% liquid
        render 'content-cards.pagination', block: pagination_block, forloop: forloop, section_type: section_type
      %}
    {% endif %}
  </div>
</section>

{% render "_section.universal-settings", insert: "after" %}
