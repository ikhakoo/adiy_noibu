{%- comment -%} Auto Generated Variables start {%- endcomment -%}
{%- liquid
  assign block_type = "_blocks.search-input"
  assign placeholder = block.settings.placeholder
  assign title = block.settings.title
  assign prefix = block.settings.prefix
  assign suffix = block.settings.suffix
  assign input_class = block.settings.input_class
  assign name = block.settings.name
  assign default_value = block.settings.default_value
  assign allow_autocomplete = block.settings.allow_autocomplete
  assign include_articles = block.settings.include_articles
  assign include_products = block.settings.include_products
  assign include_pages = block.settings.include_pages
  assign flex_direction_align_x_align_y_gap_wrap = block.settings.flex_direction_align_x_align_y_gap_wrap
  assign margin_top_bottom_left_right = block.settings.margin_top_bottom_left_right
  assign max_w_flex_col_row_order_align = block.settings.max_w_flex_col_row_order_align
  assign responsive_visibility = block.settings.responsive_visibility
  assign hide_if_empty = block.settings.hide_if_empty
  assign responsive_breakpoint = block.settings.responsive_breakpoint
  assign anchor_id = block.settings.anchor_id
-%}
{%- comment -%} Auto Generated Variables end {%- endcomment -%}

{% liquid
  assign searchType = ""
  if include_articles
    assign searchType = searchType | append: "article,"
  endif
  if include_products
    assign searchType = searchType | append: "product,"
  endif
  if include_pages
    assign searchType = searchType | append: "page"
  endif
  assign autocomplete = "off"
  if allow_autocomplete
    assign autocomplete = "on"
  endif
  
%}

{% render '_utils.dynamic-css',
    block: block,
    keys: "responsive_visibility,margin_top_bottom_left_right, max_w_flex_col_row_order_align" %}

<div data-style-id="{{ section.id }}--{{ block.id }}"
    {{ block.shopify_attributes }}>
  {% comment %} TODO: Don't allow forms within forms {% endcomment %}
  <form class="flex items-stretch gap-4"
    action="{{ routes.search_url }}">
    {% render "_components.input",
        name: name,
        type: type,
        label: title,
        prefix: prefix,
        suffix: suffix,
        placeholder: placeholder,
        autocomplete: autocomplete,
        required: true,
        form: form,
        class: input_class,
        default_value: default_value
    %}
    <input type="hidden" name="type" value="{{ searchType }}">
  </form>
</div>
