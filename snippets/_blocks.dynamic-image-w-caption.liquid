{%- comment -%} Auto Generated Variables start {%- endcomment -%}
{%- liquid
  assign block_type = "_blocks.dynamic-image-w-caption"
  assign metaobject_namespace_key = block.settings.metaobject_namespace_key
  assign image_key = block.settings.image_key
  assign content_key = block.settings.content_key
  assign url_key = block.settings.url_key
  assign width_height_aspect_object_fit = block.settings.width_height_aspect_object_fit
  assign content_class = block.settings.content_class
  assign padding_top_bottom_left_right = block.settings.padding_top_bottom_left_right
  assign flex_direction_align_x_align_y_gap_wrap = block.settings.flex_direction_align_x_align_y_gap_wrap
  assign border_bg_style = block.settings.border_bg_style
  assign border_width_radius = block.settings.border_width_radius
  assign border_color = block.settings.border_color
  assign background_gradient = block.settings.background_gradient
  assign margin_top_bottom_left_right = block.settings.margin_top_bottom_left_right
  assign max_w_flex_col_row_order_align = block.settings.max_w_flex_col_row_order_align
  assign responsive_visibility = block.settings.responsive_visibility
  assign hide_if_empty = block.settings.hide_if_empty
  assign responsive_breakpoint = block.settings.responsive_breakpoint
  assign anchor_id = block.settings.anchor_id
  assign color_override = block.settings.color_override
-%}
{%- comment -%} Auto Generated Variables end {%- endcomment -%}

{% liquid
  assign namespace = metaobject_namespace_key | split: "." | first
  assign key = metaobject_namespace_key | split: "." | last

  assign resource = product | default: collection | default: article | default: page | default: blog | default: shop
  assign items = resource.metafields[namespace][key].value
  assign first_item = items | first

  if request.design_mode != true
    if items == blank or items.count <= 0
      assign is_empty = true
    endif
    if hide_if_empty == 'block' and is_empty
      echo '<script type="block/hide"></script>'
      break
    endif
    if hide_if_empty == 'container' and is_empty
      echo '<script type="container/break"></script>'
      break
    endif
    if hide_if_empty == 'section' and is_empty
      echo '<script type="section/break"></script>'
      break
    endif
  endif
%}

{% liquid
  if color_override != blank and color_override.alpha != 0
    assign color = color_override | default: "inherit"
  endif
%}
{% render '_utils.dynamic-css',
    block: block,
    selector: '& [data-style-caption]',
    keys: "padding_top_bottom_left_right" %}

{% if border_bg_style == 'image' %}
  {% render '_utils.dynamic-css',
      block: block,
      keys: "responsive_visibility,flex_direction_align_x_align_y_gap_wrap, max_w_flex_col_row_order_align, margin_top_bottom_left_right" %}
  {% render '_utils.dynamic-css',
      block: block,
      selector: "& [data-style-image]",
      keys: "width_height_aspect_object_fit, border_width_radius, border_color, background_gradient" %}
{% endif %}

{% if border_bg_style == 'card' %}
  {% render '_utils.dynamic-css',
      block: block,
      selector: "& [data-style-image]",
      keys: "width_height_aspect_object_fit" %}
  {% render '_utils.dynamic-css',
      block: block,
      keys: "responsive_visibility,flex_direction_align_x_align_y_gap_wrap, max_w_flex_col_row_order_align, margin_top_bottom_left_right, border_width_radius, border_color, background_gradient" %}
{% endif %}

{% for item in items %}
  {% assign image = item[image_key] | image_url: width: 400, height: 400 %}
  <figure
      {% if item[url_key] != blank %}
        title="{{ item[url_key] }}"
        role="button"
        tabindex="0"
        @click.prevent.stop="barba.go('{{ url }}'); $modal.setId('')"
      {% endif %}
      data-style-id="{{ section.id }}--{{ block.id }}"
    {% if anchor_id != blank %}id="{{ anchor_id }}"{% endif %}
      {{ block.shopify_attributes }}
      style="color: {{ color }}"
      class="overflow-hidden">
    <picture data-style-image class="relative block shrink-0 overflow-hidden">
      {% render '_object.image', image: image, class: "w-full h-full object-[inherit]" %}
    </picture>
    <figcaption data-style-caption>
      {% assign richtextStr = "" %}
      {% assign richtext = item[content_key] | metafield_tag | replace: '<div class="metafield-rich_text_field">', "" | split: "</div>" %}
      {% for htmlBlock in richtext %}
        {% if forloop.last %}
          {% assign richtextStr = richtextStr | append: htmlBlock %}
          {% break %}
        {% endif %}
        {% assign richtextStr = richtextStr | append: htmlBlock | append: "</div>" %}
      {% endfor %}
      {% render '_input.richtext', content: richtextStr, class: content_class, block: block, forloop: forloop %}
    </figcaption>
  </figure>

{% endfor %}
