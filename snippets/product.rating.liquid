{%- comment -%} Auto Generated Variables start {%- endcomment -%}
{%- liquid
  assign block_type = "rating"
  assign section_type = "product"
  assign reviews_heading = block.settings.reviews_heading
  assign css_class = block.settings.css_class
  assign icon_size_gap = block.settings.icon_size_gap
  assign icon_active_color = block.settings.icon_active_color
  assign icon_base_color = block.settings.icon_base_color
  assign hide_zero_reviews = block.settings.hide_zero_reviews
  assign margin_top_bottom_left_right = block.settings.margin_top_bottom_left_right
  assign max_w_flex_col_row_order_align = block.settings.max_w_flex_col_row_order_align
  assign responsive_visibility = block.settings.responsive_visibility
  assign responsive_breakpoint = block.settings.responsive_breakpoint
  assign anchor_id = block.settings.anchor_id
  assign show_conditionally = block.settings.show_conditionally
-%}
{%- comment -%} Auto Generated Variables end {%- endcomment -%}

{% liquid
  assign icon_size_gap = icon_size_gap | strip_newlines | replace: ' ', "" | split: '|'
  assign icon = icon_size_gap[0] | split: '/'
  assign size = icon_size_gap[1] | split: '/'
  assign gap = icon_size_gap[2] | split: '/'

  if icon_active_color.alpha > 0
    assign styles = styles | append: "--color-review-stars:" | append: icon_active_color | append: ";"
  endif

  if icon_base_color.alpha > 0
    assign styles = styles | append: "--color-review-stars-base:" | append: icon_base_color | append: ";"
  endif

  assign reviews_rating = settings.data__product__reviews_rating | replace: " ", '' | split: "."
  assign reviews_rating = product.metafields[reviews_rating.first][reviews_rating.last].value
  assign reviews_rating = reviews_rating.rating | default: reviews_rating | default: 0 | times: 1.0

  assign reviews_count = settings.data__product__reviews_count | replace: " ", '' | split: "."
  assign reviews_count = product.metafields[reviews_count.first][reviews_count.last].value | default: 0 | times: 1

  assign reviews_content = reviews_heading | replace: "[count]", reviews_count | replace: "[rating]", reviews_rating
%}

{% render '_utils.dynamic-css',
    block: block,
    keys: "responsive_visibility,max_w_flex_col_row_order_align,padding_top_bottom_left_right,margin_top_bottom_left_right,border_width_radius,background_color,background_gradient,border_color" %}

<div
    data-style-id="{{ section.id }}--{{ block.id }}"
    {% if anchor_id != blank %}id="{{ anchor_id }}"{% endif %}
    {{ block.shopify_attributes }}
    x-show="$data.showConditionally('{{ show_conditionally }}')"
  {% if hide_zero_reviews != blank %}x-show="state?.product?.reviews?.review_count > +`{{ hide_zero_reviews }}`"{% endif %}
    data-block-type="{{ block.type }}">
  <div class="flex items-center gap-2"
       style="{{ styles }}">
    <div class="relative"
         style="--gap: {{ gap.last }}; --gap-md: {{ gap.first }}; --h: {{ size.last }}; --h-md: {{ size.first }};">
      <div class="flex gap-dynamic text-[--color-review-stars-base]">
        {% for i in (1..5) %}
          {% render '_components.icon', icon: icon, class: "h-dynamic" %}
        {% endfor %}
      </div>
      <div class="absolute left-0 top-0 flex gap-dynamic text-[--color-review-stars]"
           style="clip-path: polygon(0 0, {{ reviews_rating | divided_by: 5 | times: 100 }}% 0, {{ reviews_rating | divided_by: 5 | times: 100 }}% 100%, 0 100%);"
           :style="`clip-path: polygon(0 0, ${((state?.product?.reviews?.rating ?? 0) / 5) * 100}% 0, ${((state?.product?.reviews?.rating ?? 0) / 5) * 100}% 100%, 0 100%);`">
        {% for i in (1..5) %}
          {% render '_components.icon', icon: icon, class: "h-dynamic" %}
        {% endfor %}
      </div>
    </div>
    <span class="{{ css_class }}"
          data-content="{% render '_input.inline_richtext', content: reviews_heading, escape: true, block: block, forloop: forloop %}"
          x-html="$el.getAttribute('data-content').replace('[count]', state?.product?.reviews?.review_count).replace('[rating]',state?.product?.reviews?.rating || 'No rating')">
      {% render '_input.inline_richtext', content: reviews_content, block: block, forloop: forloop %}
    </span>
  </div>
</div>
