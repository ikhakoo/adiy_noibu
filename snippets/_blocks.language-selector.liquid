{%- comment -%} Auto Generated Variables start {%- endcomment -%}
{%- liquid
  assign block_type = "_blocks.language-selector"
  assign select_class = block.settings.select_class
  assign margin_top_bottom_left_right = block.settings.margin_top_bottom_left_right
  assign max_w_flex_col_row_order_align = block.settings.max_w_flex_col_row_order_align
  assign responsive_visibility = block.settings.responsive_visibility
  assign hide_if_empty = block.settings.hide_if_empty
  assign responsive_breakpoint = block.settings.responsive_breakpoint
  assign anchor_id = block.settings.anchor_id
-%}
{%- comment -%} Auto Generated Variables end {%- endcomment -%}

{% render '_utils.dynamic-css',
    block: block,
    selector: "& [data-style-select]",
    keys: "margin_top_gap" %}

{% render '_utils.dynamic-css',
    block: block,
    keys: "responsive_visibility,max_w_flex_col_row_order_align,padding_top_bottom_left_right,margin_top_bottom_left_right,border_width_radius,background_color,background_gradient,border_color" %}

<div
    data-style-id="{{ section.id }}--{{ block.id }}"
    {% if anchor_id != blank %}id="{{ anchor_id }}"{% endif %}
    {{ block.shopify_attributes }}
    data-block-type="{{ block.type }}"
    x-data="{ isOpen: false }"
>
  <div class="relative">
    <button
      type="button"
      class="w-full {{ select_class }} {{ select_class | append: "--font" }}"
      @click="isOpen = !isOpen"
    >
      {{ localization.language.endonym_name | capitalize }}
    </button>
    <div
      x-show="isOpen"
      @click.outside="isOpen = false"
      class="z-[2147483647] mt-1 max-h-60 absolute w-full justify-start overflow-auto rounded-md bg-white py-1 shadow-lg outline-none ring-1 ring-black/5 transition-opacity duration-75 focus:outline-none"
    >
      {% form 'localization', x-ref:"localizationForm" %}
        {% for language in localization.available_languages %}
          <button
            type="submit"
            name="locale_code"
            value="{{ language.iso_code }}"
            class="flex items-center w-full text-left relative select-none py-2 pl-3 text-gray-900 ac:bg-gray-100 hf:bg-gray-100 hf:text-gray-900 {{ select_class | append: "--font" }}"
            @click="isOpen = false"
          >
            <span class="flex-shrink-0 mr-2 text-theme-accent {% if localization.language.iso_code == language.iso_code %}opacity-100{% else %}opacity-0{% endif %}">
              {% render '_components.icon', icon: 'check-mark', class: "size-5 opacity-60 bg-gray-900" %}
            </span>
            <span class="block truncate">
              {{ language.endonym_name | capitalize }}
            </span>
          </button>
        {% endfor %}
      {% endform %}
    </div>
  </div>
</div>