{%- comment -%} Auto Generated Variables start {%- endcomment -%}
{%- liquid
  assign block_type = "richtext"
  assign section_type = "bundle"
  assign show_conditionally = block.settings.show_conditionally
  assign show_based_on_bundle_state = block.settings.show_based_on_bundle_state
  assign title = block.settings.title
  assign page_content = block.settings.page_content
  assign use_page_content = block.settings.use_page_content
  assign content_class = block.settings.content_class
  assign margin_top_bottom_left_right = block.settings.margin_top_bottom_left_right
  assign max_w_flex_col_row_order_align = block.settings.max_w_flex_col_row_order_align
  assign responsive_visibility = block.settings.responsive_visibility
  assign hide_if_empty = block.settings.hide_if_empty
  assign responsive_breakpoint = block.settings.responsive_breakpoint
  assign anchor_id = block.settings.anchor_id
  assign color_override = block.settings.color_override
-%}
{%- comment -%} Auto Generated Variables end {%- endcomment -%}

{% liquid

  assign content = title | default: "" | append: page_content.content

  if use_page_content and page.content != blank
    assign content = page.content
  endif

  if request.design_mode != true
    if title == blank
      assign is_empty = true
    endif
    if hide_if_empty == 'block' and is_empty
      echo '<script type="block/hide"></script>'
      break
    endif
    if hide_if_empty == 'container' and is_empty
      echo '<script type="container/break"></script>'
      break
    endif
    if hide_if_empty == 'section' and is_empty
      echo '<script type="section/break"></script>'
      break
    endif
  endif
%}

{% liquid
  if color_override != blank and color_override.alpha != 0
    assign color = color_override | default: "inherit"
  endif
%}
{% render '_utils.dynamic-css',
    block: block,
    keys: "responsive_visibility,margin_top_bottom_left_right, max_w_flex_col_row_order_align" %}

{% liquid
  assign bundle_blocks = section.blocks | where: "type", 'bundle_target' | first

  assign _content = title | replace: '[current]', '0' | replace: '[target]', bundle_blocks.settings.target
%}

<div
    data-style-id="{{ section.id }}--{{ block.id }}"
    {% if anchor_id != blank %}id="{{ anchor_id }}"{% endif %}
    {{ block.shopify_attributes }}
    x-show="($data.windowWidth >= 1024 || $data.showConditionally(`{{ show_conditionally }}`)) && $data.showBasedOnBundleState(`{{ show_based_on_bundle_state }}`)"
    style="color: {{ color }}"
    x-html="$el.getAttribute('data-content').replace('[current]', $data.bundle.current_wording)
     .replace('[difference]', $data.bundle.difference_wording)
     .replace('[target]', $data.bundle.target_wording)
     .replace('[discount]', $data.bundle.discount_wording)
     .replace('[active_discount]', $data.bundle.active_discount_wording)
     .replace('[target_discount]', $data.bundle.target_discount_wording)
     .replace('[active_target_discount]', $data.bundle.active_target_discount_wording)
     .replace('[compare_at_price]', `<span class='opacity-50 line-through'>${utils.formatMoney($data.bundle.total_price)}</span>`)
     .replace('[final_price]', `<span>${utils.formatMoney($data.bundle.final_price)}</span>`)"
    data-content="{% render '_input.richtext', content: title, class: content_class, escape: true, block: block, forloop: forloop %}">
  {% render '_input.richtext', content: _content, class: content_class, block: block, forloop: forloop %}
</div>
