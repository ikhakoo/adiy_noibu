{%- comment -%} Auto Generated Variables start {%- endcomment -%}
{%- liquid
  assign block_type = "order"
  assign section_type = "content-accounts-grid"
  assign border_width_radius = block.settings.border_width_radius
  assign background_color = block.settings.background_color
  assign border_color = block.settings.border_color
  assign margin_top_bottom_left_right = block.settings.margin_top_bottom_left_right
  assign max_w_flex_col_row_order_align = block.settings.max_w_flex_col_row_order_align
  assign responsive_visibility = block.settings.responsive_visibility
  assign hide_if_empty = block.settings.hide_if_empty
  assign responsive_breakpoint = block.settings.responsive_breakpoint
  assign anchor_id = block.settings.anchor_id
-%}
{%- comment -%} Auto Generated Variables end {%- endcomment -%}

{% render '_utils.dynamic-css', block: block, keys: "responsive_visibility,margin_top_bottom_left_right,max_w_flex_col_row_order_align" %}
{% render '_utils.dynamic-css',
    block: block,
    selector: '& [data-style-container]',
    keys: "border_width_radius,background_color,border_color" %}

<div
    data-style-id="{{ section.id }}--{{ block.id }}"
    {% if anchor_id != blank %}id="{{ anchor_id }}"{% endif %}
    {{ block.shopify_attributes }}>
  <main class="overflow-hidden" data-style-container>

    <table class="min-w-full divide-y divide-gray-300">
      <thead class="bg-inherit">
        <tr>
          <th scope="col"
              class="w-full pl-4 pr-3 text-left text-sm font-semibold text-opacity/90 py-3.5 sm:pl-6">
            {{ "content_accounts_grid.product" | t }}
          </th>
          <th scope="col"
              class="px-4 text-left text-sm font-semibold text-opacity/90 sm:px-6 py-3.5">
            {{ "content_accounts_grid.sku" | t }}
          </th>
          <th scope="col"
              class="px-4 text-right text-sm font-semibold text-opacity/90 sm:px-6 py-3.5">
            {{ "content_accounts_grid.quantity" | t }}
          </th>
          <th scope="col"
              class="px-4 text-right text-sm font-semibold text-opacity/90 sm:px-6 py-3.5">
            {{ "content_accounts_grid.total" | t }}
          </th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        {% for line_item in order.line_items %}
          <tr class="cursor-pointer group hf:bg-gray-50"
              data-order-link="{{ line_item.url }}">
            <td class="py-4 pl-4 pr-3 text-sm sm:pl-6">
              <div class="grid w-full grid-cols-[100px_1fr] items-center gap-4">
                {% render '_object.image', image: line_item.image, width: 100, height: 100, placeholder: 'product-1', class: 'w-[100px]' %}
                <div class="flex-1">
                  <h3 class="font-semibold group-hf:underline">{{ line_item.product.title }}</h3>
                  <h4 class="text-xs uppercase tracking-wide opacity-50">{{ line_item.title | replace: line_item.product.title, "" | replace_first: "-", "" | strip }}</h4>
                  <div class="mt-1 text-primary-outline">
                    {{ line_item.final_price | money }}
                  </div>
                </div>
              </div>
            </td>
            <td class="whitespace-nowrap px-4 py-2 text-sm opacity-50 sm:px-6">
              {{ line_item.sku }}
            </td>
            <td class="whitespace-nowrap px-4 py-2 text-right text-sm opacity-50 sm:px-6">
              {{ line_item.quantity }}
            </td>
            <td class="whitespace-nowrap px-4 py-2 text-right text-sm opacity-50 sm:px-6">
              {{ line_item.final_line_price | money }}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
    <div class="grid border-t border-t-gray-200 text-sm md:grid-cols-2 divide-y divide-y-gray-200">
      <div class="flex items-center justify-between px-6 py-5 md:col-end-3">
        <span class="">
          {{ "content_accounts_grid.subtotal" | t }}
        </span>
        <span class="text-gray-700">{{ order.subtotal_price | money }}</span>
      </div>

      {%- for discount_application in order.cart_level_discount_applications -%}
        <div class="flex items-center justify-between px-6 py-5 md:col-end-3">
          <span class="">
            {{ "content_accounts_grid.discount" | t }}
            ({{ discount_application.title }})</span>
          <span class="text-gray-700">{{ discount_application.total_allocated_amount | times: -1.0 | money }}</span>
        </div>
      {%- endfor -%}

      {%- for shipping_method in order.shipping_methods -%}
        <div class="flex items-center justify-between px-6 py-5 md:col-end-3">
          <span class="">
            {{ "content_accounts_grid.shipping" | t }}
            ({{ shipping_method.title }})</span>
          <span class="text-gray-700">{{ shipping_method.price | money }}</span>
        </div>
      {%- endfor -%}

      {%- for tax_line in order.tax_lines -%}
        <div class="flex items-center justify-between px-6 py-5 md:col-end-3">
          {%- if cart.taxes_included -%}
            <span class="">
              {{ "content_accounts_grid.tax_included" | t }}
              ({{ tax_line.title }} {{ tax_line.rate_percentage }}%)</span>
          {%- else -%}
            <span class="">
              {{ "content_accounts_grid.tax_excluded" | t }}
              ({{ tax_line.title }} {{ tax_line.rate_percentage }}%)</span>
          {%- endif -%}
          <span class="text-gray-700">{{ tax_line.price | money }}</span>
        </div>
      {%- endfor -%}

      {%- if order.total_refunded_amount > 0 -%}
        <div class="flex items-center justify-between px-6 py-5 md:col-end-3">
          <span class="">
            {{ "content_accounts_grid.refunded_amount" | t }}
          </span>
          <span class="text-gray-700">{{ order.total_refunded_amount | money }}</span>
        </div>
      {%- endif -%}

      <div class="flex items-center justify-between px-6 py-5 md:col-end-3">
        <span class="font-medium">
          {{ "content_accounts_grid.total" | t }}
        </span>
        <span class="font-medium text-opacity/90">{{ order.total_net_amount | money }}</span>
      </div>

    </div>
  </main>

  <footer class="mt-3 grid gap-2 sm:grid-cols-2">
    <div class="py-4 px-6 text-sm"
         data-style-container>
      <p class="mb-2 font-medium uppercase tracking-wide">
        {{ "content_accounts_grid.billing_address" | t }}
      </p>
      {%- if order.billing_address -%}
        {{- order.billing_address | format_address -}}
      {%- else -%}
        <p>
          {{ "content_accounts_grid.no_billing" | t }}
        </p>
      {%- endif -%}
    </div>
    <div class="py-4 px-6 text-sm"
         data-style-container>
      <p class="mb-2 font-medium uppercase tracking-wide">
        {{ "content_accounts_grid.shipping_address" | t }}
      </p>
      {%- if order.shipping_address -%}
        {{- order.shipping_address | format_address -}}
      {%- else -%}
        <p>
          {{ "content_accounts_grid.no_shipping" | t }}
        </p>
      {%- endif -%}
    </div>
  </footer>
</div>

