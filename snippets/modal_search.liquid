{%- comment -%} Auto Generated Variables start {%- endcomment -%}
{%- liquid
  assign section_type = "modal_search"
  assign label = section.settings.label
  assign prefix = section.settings.prefix
  assign placeholder = section.settings.placeholder
  assign style = section.settings.style
  assign button_content = section.settings.button_content
  assign input_class = section.settings.input_class
  assign button_class = section.settings.button_class
  assign close_icon = section.settings.close_icon
  assign background_blur = section.settings.background_blur
  assign section_id = section.settings.section_id
  assign color_scheme = section.settings.color_scheme
  assign container_spacing = section.settings.container_spacing
  assign border_divider = section.settings.border_divider
  assign top_bottom_min_height = section.settings.top_bottom_min_height
  assign responsive_visibility = section.settings.responsive_visibility
  assign responsive_breakpoint = section.settings.responsive_breakpoint
  assign target_visibility = section.settings.target_visibility
-%}
{%- comment -%} Auto Generated Variables end {%- endcomment -%}

{% liquid
  if settings.layout__style == 'solid'
    assign container_classes = 'top-[--header-height-offset] left-0 w-full'
  endif

  if settings.layout__style == 'floating'
    assign container_classes = 'inset-x-1.5 top-[calc(var(--header-height-offset)+12px)] inset-x-1.5 '
    assign styles = 'background: transparent;'
    assign paddings = "px-4 md:px-9 py-6 bg-theme-bg rounded-[20px]"
  endif
%}

{% liquid
  case style
    when 'inline_button'
      assign inline_button = true
    when 'input_and_button'
      assign inline_button = false
  endcase
%}
<style>
  .scrollbar_search::-webkit-scrollbar {
    width: 14px;
  }
  .scrollbar_search::-webkit-scrollbar-thumb {
  border: 4px solid rgba(0, 0, 0, 0);
  background-clip: padding-box;
  border-radius: 9999px;
  background-color: #AAAAAA;
}
</style>

<div x-data="{ open:  $modal.id === 'search' }"
     x-effect="open = $editor?.select_section_id === '{{ section.id }}' || $modal.id === 'search'"
     @keydown.document="(e) => { if (e.key === 'k' && e.ctrlKey) {
         e.preventDefault();
         e.stopPropagation();
         $modal.setId('search');
     }}"
     x-cloak>
  <div class="fixed inset-0 z-20 bg-[--color-modal-background] {{ background_blur }} transition duration-150 ease-in-out"
       x-show="open"
       @click="$modal.setId('')"
       x-transition:enter-start="opacity-0"
       x-transition:enter-end="opacity-100"
       x-transition:leave-start="opacity-100"
       x-transition:leave-end="opacity-0"></div>
  <section class="fixed inset-x-0 z-20 transition-transform duration-150 ease-in-out max-md:bottom-0 {{ container_classes }}"
           x-show="open"
           x-transition:enter-start="-translate-y-full"
           x-transition:enter-end="translate-y-0"
           x-transition:leave-start="translate-y-0"
           x-transition:leave-end="-translate-y-full">
    <div class="relative overflow-hidden {{ color_scheme }} px-container-md bg-transparent"
         data-search-modal x-data x-init="
         if (!$store.search) {
           _sections.initSearch($el, $refs, `{{ search.terms }}`);
         }
       ">
      {% render "_section.universal-settings", section_type: section_type, styles: styles, insert: "before" %}
      <form class="flex items-stretch gap-4 {{ paddings }}"
            action="{{ routes.search_url }}">
        {% render "_components.input",
            name: 'q',
            type: 'search',
            label: label,
            prefix: prefix,
            placeholder: placeholder,
            autocomplete: 'off',
            inline_button: inline_button,
            button_content: button_content,
            class: input_class,
            setState: '$store.search.query = value',
            default_value: search.terms,
            value: '$store.search.query'
        %}
        {% if inline_button == false %}
          <button type="submit" class="!h-full {{ button_class }}">
            {% render '_input.inline_richtext', content: button_content, block: block, forloop: forloop %}
          </button>
        {% endif %}
      </form>
      <main class="scrollbar_search max-h-[calc(100vh-var(--header-height-offset)_-_100px)] flex flex-1 flex-col overflow-y-auto relative bg-theme-bg -top-[18px] rounded-b-[20px] ">
        {% liquid
          assign allow_no_cols = true
          assign child_layout = false
          for block in section.blocks
            if child_layout and block.type == 'layout_child__end'
              assign allow_no_cols = true
              assign child_layout = false
            endif

            if allow_no_cols

              if block.type == 'query_results' or block.type == 'product_results' or block.type == 'collection_results' or block.type == 'article_results' or block.type == 'page_results'
                render 'modal_search.results-block', block: block, forloop: forloop, section_type: section_type, form: form, columnIndex: forloop.index0
              endif
              
              if block.type == "article-cards"
                render "_blocks.article-cards", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "article-content"
                render "_blocks.article-content", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "article-grid"
                render "_blocks.article-grid", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "article-grid-collage"
                render "_blocks.article-grid-collage", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "article-tags"
                render "_blocks.article-tags", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "background"
                render "_blocks.background", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "background-video"
                render "_blocks.background-video", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "background-video-controls"
                render "_blocks.background-video-controls", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "breadcrumbs"
                render "_blocks.breadcrumbs", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "button"
                render "_blocks.button", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "collapsible"
                render "_blocks.collapsible", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "collection-cards"
                render "_blocks.collection-cards", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "collection-grid"
                render "_blocks.collection-grid", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "collections-image-caption"
                render "_blocks.collections-image-caption", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "custom-liquid"
                render "_blocks.custom-liquid", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "delivery-range"
                render "_blocks.delivery-range", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "divider"
                render "_blocks.divider", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "dynamic-collapsible-items"
                render "_blocks.dynamic-collapsible-items", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "dynamic-content"
                render "_blocks.dynamic-content", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "dynamic-faq-items"
                render "_blocks.dynamic-faq-items", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "dynamic-image-w-caption"
                render "_blocks.dynamic-image-w-caption", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "dynamic-product-cards"
                render "_blocks.dynamic-product-cards", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "hide-section"
                render "_blocks.hide-section", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "image"
                render "_blocks.image", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "image-with-caption"
                render "_blocks.image-with-caption", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "image-with-content"
                render "_blocks.image-with-content", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "inline-richtext"
                render "_blocks.inline-richtext", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "language-selector"
                render "_blocks.language-selector", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "list-items"
                render "_blocks.list-items", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "location-selector"
                render "_blocks.location-selector", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "menu"
                render "_blocks.menu", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "newsletter-signup"
                render "_blocks.newsletter-signup", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "payment-types"
                render "_blocks.payment-types", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "product-cards"
                render "_blocks.product-cards", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "product-grid"
                render "_blocks.product-grid", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "product-rating"
                render "_blocks.product-rating", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "products-image-caption"
                render "_blocks.products-image-caption", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "review-card"
                render "_blocks.review-card", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "review-card-mobile"
                render "_blocks.review-card-mobile", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "richtext"
                render "_blocks.richtext", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "search-input"
                render "_blocks.search-input", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "select-input"
                render "_blocks.select-input", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "share"
                render "_blocks.share", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "social-icons"
                render "_blocks.social-icons", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "spacer"
                render "_blocks.spacer", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "tab-image-with-caption"
                render "_blocks.tab-image-with-caption", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "testimonial-card"
                render "_blocks.testimonial-card", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "text-card"
                render "_blocks.text-card", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "text-input"
                render "_blocks.text-input", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "variant-based-button"
                render "_blocks.variant-based-button", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "variant-based-text"
                render "_blocks.variant-based-text", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "video"
                render "_blocks.video", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "video-button"
                render "_blocks.video-button", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == "video-product-card"
                render "_blocks.video-product-card", block: block, forloop: forloop, section_type: section_type, form: form
              endif
              if block.type == 'layout_child__flex_card'
                render 'modal_search.layout_child__flex_card', block: block, forloop: forloop, section_type: section_type, form: form, columnIndex: forloop.index0
                assign allow_no_cols = false
                assign child_layout = true
              endif
              if block.type == 'layout_child__grid_card'
                render 'modal_search.layout_child__grid_card', block: block, forloop: forloop, section_type: section_type, form: form, columnIndex: forloop.index0
                assign allow_no_cols = false
                assign child_layout = true
              endif
            endif

            if block.type == 'layout__end'
              assign allow_no_cols = true
            endif

            if block.type == 'layout__grid'
              assign allow_no_cols = false
              render 'modal_search.layout__grid', block: block, forloop: forloop, section_type: section_type, form: form, columnIndex: forloop.index0
            endif

            if block.type == 'layout__flex_wrap'
              assign allow_no_cols = false
              render 'modal_search.layout__flex_wrap', block: block, forloop: forloop, section_type: section_type, form: form, columnIndex: forloop.index0
            endif
          endfor
        %}
      </main>
      {% if close_icon != blank and settings.layout__style != 'solid' %}
      <button type="button"
              class="absolute right-4 md:right-9 top-1/2 -translate-y-1/2 z-10 text-theme-text/60 hf:text-theme-text/90"
              @click="$modal.setId(open ? '' : 'search'), $store.search.query = ''">
        <span class="sr-only">Close Drawer</span>
        {% render '_components.icon', icon: close_icon, class: "h-5 shrink-0" %}
      </button>
    {% endif %}
      {% render "_section.universal-settings", insert: "after" %}
    </div>
    {% if close_icon != blank and settings.layout__style == 'solid' %}
      <button type="button"
              class="absolute right-4 top-4 z-10 text-theme-text/60 hf:text-theme-text/90"
              @click="$modal.setId(open ? '' : 'search')">
        <span class="sr-only">Close Drawer</span>
        {% render '_components.icon', icon: close_icon, class: "h-5 shrink-0" %}
      </button>
    {% endif %}
  </section>
</div>

