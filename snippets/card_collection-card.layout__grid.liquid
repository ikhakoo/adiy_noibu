{%- comment -%} Auto Generated Variables start {%- endcomment -%}
{%- liquid
  assign block_type = "layout__grid"
  assign section_type = "card_collection-card"
  assign grid_cols_align_x_align_y_gap = block.settings.grid_cols_align_x_align_y_gap
  assign padding_top_bottom_left_right = block.settings.padding_top_bottom_left_right
  assign border_width_radius = block.settings.border_width_radius
  assign background_color = block.settings.background_color
  assign border_color = block.settings.border_color
  assign margin_top_bottom_left_right = block.settings.margin_top_bottom_left_right
  assign max_w_flex_col_row_order_align = block.settings.max_w_flex_col_row_order_align
  assign responsive_visibility = block.settings.responsive_visibility
  assign responsive_breakpoint = block.settings.responsive_breakpoint
  assign anchor_id = block.settings.anchor_id
-%}
{%- comment -%} Auto Generated Variables end {%- endcomment -%}

{% render '_utils.dynamic-css', block: block %}

<div
    data-style-id="{{ section.id }}--{{ block.id }}"
    {% if anchor_id != blank %}id="{{ anchor_id }}"{% endif %}
    {{ block.shopify_attributes }}
    class="grid relative overflow-hidden">
  {% liquid
    assign count = 0
    assign allow_no_cols = true
    for block in section.blocks
      if forloop.index0 <= columnIndex
        continue
      endif
      if block.type contains "layout__"
        break
      endif

      if allow_no_cols
        case block.type
          when "dynamic-text"
            render 'card_collection-card.dynamic-text', block: block, forloop: forloop
          when "dynamic-button"
            render 'card_collection-card.dynamic-button', block: block, forloop: forloop
          when "labels"
            render 'card_collection-card.labels', block: block, forloop: forloop
          when "accent_line"
            render 'card_collection-card.accent_line', block: block, forloop: forloop
          when "image"
            render 'card_collection-card.image', block: block, forloop: forloop
        endcase

        assign count = count | plus: 1
      endif

      if block.type == 'layout_child__overlay'
        assign allow_no_cols = false
        render 'card_collection-card.layout_child__overlay', block: block, forloop: forloop, section_type: section_type, form: form, columnIndex: forloop.index0
      endif

    endfor

    if count == 0
      assign no_dynamic_content = true
    endif
  %}
</div>

