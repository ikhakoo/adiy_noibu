{% liquid
  if always_show_in_editor and request.design_mode
    break
  endif
  if hide_if_empty == 'container'
    assign break_tag = '<script type="container/break"></script>'
  endif

  if hide_if_empty == 'section'
    assign break_tag = '<script type="section/break"></script>'
  endif

  if match_paths != blank
    assign match_paths_array = match_paths | trim | replace: " ", "" | split: ","

    assign match = false
    for match_path in match_paths_array
      assign path = request.path

      if match_path == path
        assign match = true
      endif
    endfor

    if required_paths and match
      echo break_tag
      break
    endif
    if hide_if_set_paths and match
      echo break_tag
      break
    endif
  endif

  if match_templates != blank
    assign match_templates_array = match_templates | trim | replace: " ", "" | split: ","

    assign match = false
    for match_template in match_templates_array
      assign match_template_prefix = match_template | split: "." | first
      assign template_prefix = template | split: "." | first
      assign match_template_suffix = match_template | split: "." | last
      assign template_suffix = template | split: "." | last

      if match_template_prefix != template_prefix
        continue
      endif
      if match_template.size == 1 or match_template_suffix == template_suffix
        assign match = true
        break
      endif
    endfor

    if required_templates and match
      echo break_tag
      break
    endif
    if hide_if_set_templates and match
      echo break_tag
      break
    endif
  endif
  
  for i in (1..15)
    assign required = 'required_' | append: i
    assign hide_if_set = 'hide_if_set_' | append: i
    assign content = 'content_' | append: i

    if block.settings[required] and block.settings[content] == blank
      echo break_tag
      break
    endif

    if block.settings[hide_if_set] and block.settings[content] != blank
      echo break_tag
      break
    endif
  endfor
%}
