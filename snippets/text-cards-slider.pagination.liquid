{%- comment -%} Auto Generated Variables start {%- endcomment -%}
{%- liquid 
  assign block_type = "pagination"
  assign section_type = "text-cards-slider"
  assign width_height_border_width_radius = block.settings.width_height_border_width_radius
  assign background_color = block.settings.background_color
  assign border_color = block.settings.border_color
  assign hover_border_color = block.settings.hover_border_color
  assign hover_background_color = block.settings.hover_background_color
-%}
{%- comment -%} Auto Generated Variables end {%- endcomment -%}

{% render '_utils.dynamic-css', block: block, selector: '& button span', keys: 'width_height_border_width_radius,background_color,border_color' %}

<div data-style-id="{{ section.id }}--{{ block.id }}"
     x-cloak
     class="relative flex justify-center items-center gap-2 mt-9 md:gap-3 md:hidden"
     x-show="content_slider?.state?.slide_count > 1">
  <template x-for="index in [...new Array(content_slider?.state?.slide_count ?? 0)].map((_,i) => i)">
    <button type="button"
            :aria-label="`Scroll to slide ${index + 1}`"
            x-show="index <= content_slider?.state?.slide_count"
            class="-m-1.5 p-1.5 hf:opacity-80"
            @click="content_slider?.scrollToIndex(index)">
      <span class="block hfaa:bg-[--hover-bg] hfaa:border-[--hover-border]"
            style="--hover-bg: {{ hover_background_color }}; --hover-border: {{ hover_border_color }}; "
            :class="content_slider?.state?.slide_index === index ? 'active' : ''"></span>
    </button>
  </template>
</div>
