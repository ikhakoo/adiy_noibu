{%- comment -%} Auto Generated Variables start {%- endcomment -%}
{%- liquid
  assign block_type = "richtext"
  assign section_type = "global_typography"
  assign title = block.settings.title
  assign font_family__p = block.settings.font_family__p
  assign size_weight_height_opacity__p = block.settings.size_weight_height_opacity__p
  assign spacing_transform_style_whitespace__p = block.settings.spacing_transform_style_whitespace__p
  assign custom_css__p = block.settings.custom_css__p
  assign font_family__h1 = block.settings.font_family__h1
  assign size_weight_height_opacity__h1 = block.settings.size_weight_height_opacity__h1
  assign spacing_transform_style_whitespace__h1 = block.settings.spacing_transform_style_whitespace__h1
  assign custom_css__h1 = block.settings.custom_css__h1
  assign font_family__h2 = block.settings.font_family__h2
  assign size_weight_height_opacity__h2 = block.settings.size_weight_height_opacity__h2
  assign spacing_transform_style_whitespace__h2 = block.settings.spacing_transform_style_whitespace__h2
  assign custom_css__h2 = block.settings.custom_css__h2
  assign font_family__h3 = block.settings.font_family__h3
  assign size_weight_height_opacity__h3 = block.settings.size_weight_height_opacity__h3
  assign spacing_transform_style_whitespace__h3 = block.settings.spacing_transform_style_whitespace__h3
  assign custom_css__h3 = block.settings.custom_css__h3
  assign font_family__h4 = block.settings.font_family__h4
  assign size_weight_height_opacity__h4 = block.settings.size_weight_height_opacity__h4
  assign spacing_transform_style_whitespace__h4 = block.settings.spacing_transform_style_whitespace__h4
  assign custom_css__h4 = block.settings.custom_css__h4
  assign font_family__h5 = block.settings.font_family__h5
  assign size_weight_height_opacity__h5 = block.settings.size_weight_height_opacity__h5
  assign spacing_transform_style_whitespace__h5 = block.settings.spacing_transform_style_whitespace__h5
  assign custom_css__h5 = block.settings.custom_css__h5
  assign font_family__h6 = block.settings.font_family__h6
  assign size_weight_height_opacity__h6 = block.settings.size_weight_height_opacity__h6
  assign spacing_transform_style_whitespace__h6 = block.settings.spacing_transform_style_whitespace__h6
  assign custom_css__h6 = block.settings.custom_css__h6
  assign responsive_breakpoint = block.settings.responsive_breakpoint
  assign apply_container_queries = block.settings.apply_container_queries
-%}
{%- comment -%} Auto Generated Variables end {%- endcomment -%}

{% liquid
  assign setting_keys = "p,ul,ol,h1,h2,h3,h4,h5,h6" | split: ','

  for key in setting_keys
    assign selector = "." | append: title | append: " " | append: key | append: ", ." | append: title | append: "." | append: key
    assign _key = key
    if key == "ul" or key == "ol"
      assign _key = "p"
    endif
    if generate_richtext
      assign selector = selector | append: ", .richtext" | append: " " | append: key
    endif
    assign check_items = "font_family__" | append: _key | append: ",size_weight_height_opacity__" | append: _key | append: ",spacing_transform_style_whitespace__" | append: _key | append: ",custom_css__" | append: _key
    
    render '_utils.dynamic-css', selector: selector, block: block, apply_container_queries: true, keys: check_items
  endfor
%}

