{%- comment -%} Auto Generated Variables start {%- endcomment -%}
{%- liquid
  assign block_type = "announcements"
  assign section_type = "modal_cart-drawer"
  assign show_conditionally = block.settings.show_conditionally
-%}
{%- comment -%} Auto Generated Variables end {%- endcomment -%}

<div class="w-full relative @container"
    {{ block.shopify_attributes }}
     x-show="_cart.showConditionally(`{{ show_conditionally }}`) || $editor?.select_block_id === `{{ block.id }}`"
     x-init="()=>{ const node = document.querySelector('[data-announcement-bar]')?.cloneNode(true); if (!node) return; node?.removeAttribute('data-announcement-bar'); node?.classList.add('!px-0'); $el.appendChild(node)}">
</div>
