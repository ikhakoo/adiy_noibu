{%- comment -%} Auto Generated Variables start {%- endcomment -%}
{%- liquid
  assign section_type = "text-banner"
  assign media_position = section.settings.media_position
  assign vertical_padding_content = section.settings.vertical_padding_content
  assign background_color = section.settings.background_color
  assign vertical_padding_section = section.settings.vertical_padding_section
  assign section_id = section.settings.section_id
  assign container_spacing = section.settings.container_spacing
  assign responsive_visibility = section.settings.responsive_visibility
-%}
{%- comment -%} Auto Generated Variables end {%- endcomment -%}
 
{% liquid

    if media_position == "right"
      assign media_order = "order-2"
      assign content_ratio = "lg:grid-cols-[1fr_44%]"
    else 
      assign content_ratio = "lg:grid-cols-[44%_1fr]"
      assign media_order = "-order-1"
    endif

    assign vertical_padding_content = vertical_padding_content | strip_newlines | replace: ' ', "" | split: '|'
    assign pt = vertical_padding_content[0] | split: '/'
    assign pb = vertical_padding_content[1] | split: '/'
    assign padding_styles_content = "--pt:" | append: pt.last | append: "; --pt-md:" | append: pt.first | append: ";--pb:" | append: pb.last | append: "; --pb-md:" | append: pb.first | append: ";"

    assign vertical_padding_section = vertical_padding_section | strip_newlines | replace: ' ', "" | split: '|'
    assign pt = vertical_padding_section[0] | split: '/'
    assign pb = vertical_padding_section[1] | split: '/'
%}

<style>
  [data-section-type="text-banner"] {
    padding-top: {{ pt.first }};
    padding-bottom: {{ pb.first }};
  }
  @media (max-width: 768px) {
    [data-section-type="text-banner"] {
      padding-top: {{ pt.last }};
      padding-bottom: {{ pb.last }};
    }
  }
</style>

{% render "_section.universal-settings", section_type: section_type, insert: "before" %}
<div class="grid h-full gap-6 md:gap-9 {{ content_ratio }} rounded-[20px] md:rounded-[30px] pt-[--pt] md:pt-[--pt-md] pb-[--pb] md:pb-[--pb-md]"
    style="background-color: {{ background_color}}; {{ padding_styles_content }};">
  <section class="h-full w-full flex flex-col px-1.5 md:px-9 text-left justify-center">
      {% liquid
        for block in section.blocks
          case block.type
            when 'richtext'
              render 'text-banner.richtext', block: block, forloop: forloop, section_type: section_type
          endcase
        endfor
      %}
  </section>
  <section class="w-full relative flex items-center justify-center {{ media_order }}">
    {% liquid
      for block in section.blocks
        case block.type
          when 'image'
            render 'text-banner.image', block: block, forloop: forloop, section_type: section_type
          when "banner"
            render 'text-banner.banner', block: block, forloop: forloop, section_type: section_type
        endcase 
      endfor
      %}
  </section>
</div>
{% render "_section.universal-settings", section_type: section_type, insert: "after" %}