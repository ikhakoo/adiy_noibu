{%- comment -%} Auto Generated Variables start {%- endcomment -%}
{%- liquid
  assign block_type = "dynamic-button"
  assign section_type = "card_collection-card"
  assign label = block.settings.label
  assign url = block.settings.url
  assign button_class = block.settings.button_class
  assign margin_top_bottom_left_right = block.settings.margin_top_bottom_left_right
  assign max_w_flex_col_row_order_align = block.settings.max_w_flex_col_row_order_align
  assign responsive_visibility = block.settings.responsive_visibility
  assign responsive_breakpoint = block.settings.responsive_breakpoint
  assign anchor_id = block.settings.anchor_id
-%}
{%- comment -%} Auto Generated Variables end {%- endcomment -%}

{% render '_utils.dynamic-css', block: block %}

{% liquid
  if color_override != blank and color_override.alpha != 0
    assign color = color_override | default: "inherit"
  endif
%}

<div
    data-style-id="{{ section.id }}--{{ block.id }}"
    {% if anchor_id != blank %}id="{{ anchor_id }}"{% endif %}
    {{ block.shopify_attributes }}
    {% if link_to_collection %}
      :title="`/collections/${card?.collection?.handle}`"
      role="button"
      tabindex="0"
      @click.prevent.stop="barba.go(`/collections/${card?.collection?.handle}`);"
    {% endif %}
    x-data="{ content: renderDynamicText($el.getAttribute('data-content')), content_check: renderDynamicText($el.getAttribute('data-content-check')), url: renderDynamicText(`{{ block.settings.url }}`)}"
    data-content="{% render '_input.inline_richtext', content: label, escape: true, block: block, forloop: forloop %}"
    data-content-check="{{ label | strip_html | escape }}"
    x-effect="() => { if (card?.hydrated) { content = renderDynamicText($el.getAttribute('data-content')) } }"
    x-show="!!content_check.trim()"
    x-cloak>
  <a :href="url"
     x-html="content"
     class="w-full {{ button_class }}"
  ></a>
</div>
