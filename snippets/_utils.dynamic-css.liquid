{%- comment -%}
    Generate CSS variables for dynamic Breakpoint CSS

    Accepts:
    - variable: {string} CSS Variable
    - input: {array} Array of [first,last] for Desktop | Mobile styles
    - no_pixel_default: {boolean} Defaults to false - Disables numbers to fallback to 'px' by default
    - force_pixel: {boolean} Defaults to false - Disables numbers to fallback to 'px' by default

    Usage:
    {%- render '_utils.css-variables', variable: "--pt", input: top -%}

{%- endcomment -%}

{% liquid
  assign _settings = block.settings | default: section.settings
  assign __keys = _settings | join: "," | prepend: ","
  if css_variables
    assign css_var = "--"
  endif
  assign default_selector = '[data-style-id="' | append: section.id | append: '"]'
  assign desktop_styles = ""
  assign mobile_styles = ""
  assign hover_mobile_styles = ""
  assign desktop_styles_only = ""
  assign mobile_styles_only = ""

  if block.id
    assign default_selector = '[data-style-id="' | append: section.id | append: "--" | append: block.id | append: '"]'
  endif

  assign selector = selector | default: default_selector
  assign where_selector = ':where(' | append: default_selector | append: ')'
  assign selector = selector | replace: "&", where_selector | replace: '\/', '/' | replace: '/', '\/'

  if keys
    assign keys = keys | prepend: ',' | strip_newlines | replace: ' ', "" | append: ","
  endif

  comment
  -------------- COLORS --------------
  endcomment
  if __keys contains ',text_color' or __keys contains ',background_color' or __keys contains ',background_gradient' or __keys contains ',border_color' or __keys contains ',divider_background_color' or __keys contains ',hover_outline_color'

    assign text_color = _settings['text_color']
    if _settings['text_color'] == blank or _settings['text_color'].alpha == 0
      assign text_color = 'inherit'
    endif

    assign mobile_text_color = _settings['mobile_text_color']
    if mobile_text_color == blank or mobile_text_color.alpha == 0
      assign mobile_text_color = text_color
    endif

    assign background_color = _settings['background_color']
    assign mobile_background_color = _settings['mobile_background_color']
    if mobile_background_color == blank or mobile_background_color.alpha == 0
      assign mobile_background_color = background_color
    endif

    assign divider_background_color = _settings['divider_background_color']
    assign mobile_divider_background_color = _settings['mobile_divider_background_color']
    if mobile_divider_background_color == blank or mobile_divider_background_color.alpha == 0
      assign mobile_divider_background_color = divider_background_color
    endif

    assign background_gradient = _settings['background_gradient'] | default: _settings['background_color']
    assign mobile_background_gradient = _settings['mobile_background_gradient']
    if mobile_background_gradient == blank or mobile_background_gradient.alpha == 0
      assign mobile_background_gradient = background_gradient
    endif
    assign border_color = _settings['border_color']
    assign mobile_border_color = _settings['mobile_border_color']
    if mobile_border_color == blank or mobile_border_color.alpha == 0
      assign mobile_border_color = border_color
    endif

    if text_color and text_color.alpha != 0 and keys contains ',text_color,' or keys == null
      assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "color:" | append: mobile_text_color
      assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "color:" | append: text_color
    endif

    if background_color and background_color.alpha != 0 and keys contains ',background_color,' or keys == null
      assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "background-color:" | append: mobile_background_color
      assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "background-color:" | append: background_color
    endif

    if divider_background_color and divider_background_color.alpha != 0 and keys contains ',divider_background_color,' or keys == null
      assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "background-color:" | append: mobile_divider_background_color
      assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "background-color:" | append: divider_background_color
    endif

    if background_gradient and background_gradient.alpha != 0 and keys contains ',background_gradient,' or keys == null
      assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "background:" | append: mobile_background_gradient
      assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "background:" | append: background_gradient
    endif

    if border_color and border_color.alpha != 0 and keys contains ',border_color,' or keys == null
      assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "border-color:" | append: mobile_border_color
      assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "border-color:" | append: border_color
    endif

    if keys contains ',hover_outline_color,' or keys == null
      assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "outline-color:" | append: _settings['hover_outline_color']
    endif
  endif

  comment
  -------------- Hover COLORS --------------
  endcomment
  if __keys contains ',hover_text_color' or __keys contains ',hover_background_color' or __keys contains ',hover_background_gradient' or __keys contains ',hover_border_color'

    assign hover_text_color = _settings['hover_text_color']
    if _settings['hover_text_color'] == blank or _settings['hover_text_color'].alpha == 0
      assign hover_text_color = 'inherit'
    endif

    assign hover_background_color = _settings['hover_background_color']

    assign hover_background_gradient = _settings['hover_background_gradient'] | default: _settings['hover_background_color']

    assign hover_border_color = _settings['hover_border_color']

    if hover_text_color and hover_text_color.alpha != 0 and keys contains ',hover_text_color,' or keys == null
      assign hover_mobile_styles = hover_mobile_styles | append: ";" | append: css_var | append: "color:" | append: hover_text_color
    endif

    if hover_background_color and hover_background_color.alpha != 0 and keys contains ',hover_background_color,' or keys == null
      assign hover_mobile_styles = hover_mobile_styles | append: ";" | append: css_var | append: "background-color:" | append: hover_background_color
    endif

    if hover_background_gradient and hover_background_gradient.alpha != 0 and keys contains ',hover_background_gradient,' or keys == null
      assign hover_mobile_styles = hover_mobile_styles | append: ";" | append: css_var | append: "background:" | append: hover_background_gradient
    endif

    if hover_border_color and hover_border_color.alpha != 0 and keys contains ',hover_border_color,' or keys == null
      assign hover_mobile_styles = hover_mobile_styles | append: ";" | append: css_var | append: "border-color:" | append: hover_border_color
    endif
  endif

  comment
  -------------- PAGINATION COLORS --------------
  endcomment
  if __keys contains ',pagination_background_color' or __keys contains ',pagination_border_color'

    assign pagination_background_color = _settings['pagination_background_color']
    assign mobile_pagination_background_color = _settings['mobile_pagination_background_color']
    if mobile_pagination_background_color == blank or mobile_pagination_background_color.alpha == 0
      assign mobile_pagination_background_color = pagination_background_color
    endif

    assign pagination_border_color = _settings['pagination_border_color']
    assign mobile_pagination_border_color = _settings['mobile_pagination_border_color']
    if mobile_pagination_border_color == blank or mobile_pagination_border_color.alpha == 0
      assign mobile_pagination_border_color = pagination_border_color
    endif

    if pagination_background_color and pagination_background_color.alpha != 0 and keys contains ',pagination_background_color,' or keys == null
      assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "background-color:" | append: mobile_pagination_background_color
      assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "background-color:" | append: pagination_background_color
    endif

    if pagination_border_color and pagination_border_color.alpha != 0 and keys contains ',pagination_border_color,' or keys == null
      assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "border-color:" | append: mobile_pagination_border_color
      assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "border-color:" | append: pagination_border_color
    endif
  endif

  comment
-------------- TYPOGRAPHY --------------
  endcomment
  if __keys contains ',font_family' or __keys contains ',size_weight_height_opacity' or __keys contains ',spacing_transform_style_whitespace'
    assign setting_keys = ",__body,__p,__h1,__h2,__h3,__h4,__h5,__h6" | split: ','
    for _setting_key in setting_keys
      comment
        ------ font_family ------
      endcomment
      assign _settings_key = 'font_family' | append: _setting_key
      assign _settings_key_check = ',font_family' | append: _setting_key | append: ','
      if _settings[_settings_key] and keys contains _settings_key_check or keys == null
        assign font_family = _settings[_settings_key] | strip_newlines | split: '/'

        assign v = font_family.first
        assign fonts = section.blocks | where: 'type', 'font' | map: '_settings'
        for font in fonts
          assign font_name = font.name | downcase | replace: ' ', ''
          assign font_compare_name = v | downcase | replace: ' ', ''
          if font_name == font_compare_name
            if font.family.system? == true
              assign fallback_fonts = font.fallback_families | default: font.family.fallback_families
            endif
            if font.family.system? != true
              assign fallback_fonts = font.family.fallback_families | default: font.fallback_families
            endif
            break
          endif
        endfor

        if v contains " "
          assign v = v | replace: "'", '' | replace: '"', '' | prepend: "'" | append: "'"
        endif
        if fallback_fonts != blank
          assign v = v | append: ', ' | append: fallback_fonts
        endif
        if font_family.last == font_family.first
          assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "font-family:" | append: v
        else
          assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "font-family:" | append: v

          assign v = font_family.last
          assign fonts = section.blocks | where: 'type', 'font' | map: '_settings'
          for font in fonts
            assign font_name = font.name | downcase | replace: ' ', ''
            assign font_compare_name = v | downcase | replace: ' ', ''
            if font_name == font_compare_name
              if font.family.system? == true
                assign fallback_fonts = font.fallback_families | default: font.family.fallback_families
              endif
              if font.family.system? != true
                assign fallback_fonts = font.family.fallback_families | default: font.fallback_families
              endif
              break
            endif
          endfor

          if v contains " "
            assign v = v | replace: "'", '' | replace: '"', '' | prepend: "'" | append: "'"
          endif
          if fallback_fonts != blank
            assign v = v | append: ', ' | append: fallback_fonts
          endif
          assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "font-family:" | append: v
        endif
      endif

      comment
        ------ size_weight_height_opacity ------
      endcomment
      assign _settings_key = 'size_weight_height_opacity' | append: _setting_key
      assign _settings_key_check = ',size_weight_height_opacity' | append: _setting_key | append: ','
      if _settings[_settings_key] and keys contains _settings_key_check or keys == null
        assign size_weight_height_opacity = _settings[_settings_key] | strip_newlines | split: '|'
        assign font_size = size_weight_height_opacity[0] | split: '/'
        assign font_weight = size_weight_height_opacity[1] | split: '/'
        assign line_height = size_weight_height_opacity[2] | split: '/'
        assign opacity = size_weight_height_opacity[3] | split: '/'

        if font_size
          assign v = font_size.first
          assign v_num = v | times: 1
          unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
            assign v = v_num | append: "px"
          endunless
          assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "font-size:" | append: v

          assign v = font_size.last
          assign v_num = v | times: 1
          unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
            assign v = v_num | append: "px"
          endunless
          assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "font-size:" | append: v
        endif

        assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "line-height:" | append: line_height.first
        assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "line-height:" | append: line_height.last
        assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "font-weight:" | append: font_weight.first
        assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "font-weight:" | append: font_weight.last
        assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "opacity:" | append: opacity.first
        assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "opacity:" | append: opacity.last
      endif

      comment
        ------ spacing_transform_style_whitespace ------
      endcomment
      assign _settings_key = 'spacing_transform_style_whitespace' | append: _setting_key
      assign _settings_key_check = ',spacing_transform_style_whitespace' | append: _setting_key | append: ','
      if _settings[_settings_key] and keys contains _settings_key_check or keys == null
        assign spacing_transform_style_whitespace = _settings[_settings_key] | strip_newlines | split: '|'
        assign letter_spacing = spacing_transform_style_whitespace[0] | split: '/'
        assign text_transform = spacing_transform_style_whitespace[1] | split: '/'
        assign font_style = spacing_transform_style_whitespace[2] | split: '/'
        assign white_space = spacing_transform_style_whitespace[3] | split: '/'

        if letter_spacing
          assign v = letter_spacing.first
          assign v_num = v | times: 1
          unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
            assign v = v_num | append: "px"
          endunless
          assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "letter-spacing:" | append: v

          assign v = letter_spacing.last
          assign v_num = v | times: 1
          unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
            assign v = v_num | append: "px"
          endunless
          assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "letter-spacing:" | append: v
        endif

        assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "text-transform:" | append: text_transform.first
        assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "text-transform:" | append: text_transform.last
        assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "font-style:" | append: font_style.first
        assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "font-style:" | append: font_style.last
        assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "white-space:" | append: white_space.first
        assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "white-space:" | append: white_space.last
      endif
    endfor
  endif

  comment
-------------- DESIGN ELEMENTS --------------
  endcomment
  if __keys contains ',padding_top_bottom_left_right_min_height' or __keys contains ',border_width_radius_shadow_gap_text_align'
    comment
      ------ padding_top_bottom_left_right_min_height ------
    endcomment
    if _settings['padding_top_bottom_left_right_min_height'] and keys contains ',padding_top_bottom_left_right_min_height,' or keys == null
      assign padding_top_bottom_left_right_min_height = _settings['padding_top_bottom_left_right_min_height'] | strip_newlines | split: '|'
      assign padding_top = padding_top_bottom_left_right_min_height[0] | split: '/'
      assign padding_bottom = padding_top_bottom_left_right_min_height[1] | split: '/'
      assign padding_left = padding_top_bottom_left_right_min_height[2] | split: '/'
      assign padding_right = padding_top_bottom_left_right_min_height[3] | split: '/'
      assign min_height = padding_top_bottom_left_right_min_height[4] | split: '/'

      if padding_top
        assign v = padding_top.first
        assign v_num = v | times: 1
        unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
          assign v = v_num | append: "px"
        endunless
        assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "padding-top:" | append: v

        assign v = padding_top.last
        assign v_num = v | times: 1
        unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
          assign v = v_num | append: "px"
        endunless
        assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "padding-top:" | append: v
      endif

      if padding_bottom
        assign v = padding_bottom.first
        assign v_num = v | times: 1
        unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
          assign v = v_num | append: "px"
        endunless
        assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "padding-bottom:" | append: v

        assign v = padding_bottom.last
        assign v_num = v | times: 1
        unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
          assign v = v_num | append: "px"
        endunless
        assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "padding-bottom:" | append: v
      endif

      if padding_left
        assign v = padding_left.first
        if v contains 'container-'
          assign v = v | replace: 'container-', '' | trim | replace: " ", ''
          assign v = 'var(--layout-container-padding-' | append: v | append: ')'
        endif
        if v contains 'gutter'
          assign v = v | replace: "gutter", 'var(--layout-container-gutter)'
        endif
        assign v_num = v | times: 1
        unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
          assign v = v_num | append: "px"
        endunless
        assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "padding-left:" | append: v

        assign v = padding_left.last
        if v contains 'container-'
          assign v = v | replace: 'container-', '' | trim | replace: " ", ''
          assign v = 'var(--layout-container-padding-' | append: v | append: ')'
        endif
        if v contains 'gutter'
          assign v = v | replace: "gutter", 'var(--layout-container-gutter)'
        endif
        assign v_num = v | times: 1
        unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
          assign v = v_num | append: "px"
        endunless
        assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "padding-left:" | append: v
      endif

      if padding_right
        assign v = padding_right.first
        if v contains 'container-'
          assign v = v | replace: 'container-', '' | trim | replace: " ", ''
          assign v = 'var(--layout-container-padding-' | append: v | append: ')'
        endif
        if v contains 'gutter'
          assign v = v | replace: "gutter", 'var(--layout-container-gutter)'
        endif
        assign v_num = v | times: 1
        unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
          assign v = v_num | append: "px"
        endunless
        assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "padding-right:" | append: v

        assign v = padding_right.last
        if v contains 'container-'
          assign v = v | replace: 'container-', '' | trim | replace: " ", ''
          assign v = 'var(--layout-container-padding-' | append: v | append: ')'
        endif
        if v contains 'gutter'
          assign v = v | replace: "gutter", 'var(--layout-container-gutter)'
        endif
        assign v_num = v | times: 1
        unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
          assign v = v_num | append: "px"
        endunless
        assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "padding-right:" | append: v
      endif

      if min_height
        assign v = min_height.first
        assign v_num = v | times: 1
        unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
          assign v = v_num | append: "px"
        endunless
        assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "min-height:" | append: v

        assign v = min_height.last
        assign v_num = v | times: 1
        unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
          assign v = v_num | append: "px"
        endunless
        assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "min-height:" | append: v
      endif
    endif

    comment
      ------ border_width_radius_shadow_gap_text_align ------
    endcomment
    if _settings['border_width_radius_shadow_gap_text_align'] and keys contains ',border_width_radius_shadow_gap_text_align,' or keys == null
      assign border_width_radius_shadow_gap_text_align = _settings['border_width_radius_shadow_gap_text_align'] | strip_newlines | split: '|'
      assign border_width = border_width_radius_shadow_gap_text_align[0] | split: '/'
      assign border_radius = border_width_radius_shadow_gap_text_align[1] | split: '/'
      assign shadow = border_width_radius_shadow_gap_text_align[2] | split: '/'
      assign gap = border_width_radius_shadow_gap_text_align[3] | split: '/'
      assign text_align = border_width_radius_shadow_gap_text_align[4] | split: '/'

      if border_width
        assign v = border_width.first
        assign v_num = v | times: 1
        unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
          assign v = v_num | append: "px"
        endunless
        assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "border-width:" | append: v

        assign v = border_width.last
        assign v_num = v | times: 1
        unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
          assign v = v_num | append: "px"
        endunless
        assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "border-width:" | append: v
      endif

      if border_radius
        assign v = border_radius.first
        assign v_num = v | times: 1
        unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
          assign v = v_num | append: "px"
        endunless
        assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "border-radius:" | append: v

        assign v = border_radius.last
        assign v_num = v | times: 1
        unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
          assign v = v_num | append: "px"
        endunless
        assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "border-radius:" | append: v
      endif

      if gap
        assign v = gap.first
        assign v_num = v | times: 1
        unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
          assign v = v_num | append: "px"
        endunless
        assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "gap:" | append: v

        assign v = gap.last
        assign v_num = v | times: 1
        unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
          assign v = v_num | append: "px"
        endunless
        assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "gap:" | append: v
      endif

      if shadow
        assign shadow_desktop = shadow.first | trim
        assign shadow_desktop = shadow.last | trim
        case shadow_desktop
          when "1"
