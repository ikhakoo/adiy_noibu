        assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "width:" | append: v

        assign v = width.last
        assign v_num = v | times: 1
        unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
          assign v = v_num | append: "px"
        endunless
        assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "width:" | append: v
      endif

      if height
        assign v = height.first
        assign v_num = v | times: 1
        unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
          assign v = v_num | append: "px"
        endunless
        assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "height:" | append: v

        assign v = height.last
        assign v_num = v | times: 1
        unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
          assign v = v_num | append: "px"
        endunless
        assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "height:" | append: v
      endif

      if gap
        assign v = gap.first
        assign v_num = v | times: 1
        unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
          assign v = v_num | append: "px"
        endunless
        assign gap_desktop = v | default: '0' | replace: "px", "" | append: "px"
        assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "gap:" | append: v

        assign v = gap.last
        assign v_num = v | times: 1
        unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
          assign v = v_num | append: "px"
        endunless
        assign gap_mobile = v | default: '0' | replace: "px", "" | append: "px"
        assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "gap:" | append: v
      endif
    endif

  endif

  comment
    -------------- RESPONSIVE VISIBILITY --------------
  endcomment
  if __keys contains ",responsive_visibility"
    comment
      ------ width_height ------
    endcomment
    if _settings['responsive_visibility'] and keys contains ',responsive_visibility,' or keys == null
      if _settings['responsive_visibility'] == 'mobile-only'
        assign desktop_styles_only = desktop_styles_only | append: ";" | append: css_var | append: "display: none !important"
      endif
      if _settings['responsive_visibility'] == 'desktop-tablet-only'
        assign mobile_styles_only = mobile_styles_only | append: ";" | append: css_var | append: "display: none !important"
      endif
    endif
  endif

  if _settings['width_flex_text_align'] and keys contains ',width_flex_text_align,' or keys == null
    assign width_flex_text_align = _settings['width_flex_text_align'] | strip_newlines | replace: ' ', "" | split: '|'
    assign width = width_flex_text_align[0] | split: '/'
    assign flex = width_flex_text_align[1] | split: '/'
    assign text_align = width_flex_text_align[2] | split: '/'

    assign v = width.first
    assign v_num = v | times: 1
    unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
      assign v = v_num | append: "px"
    endunless
    assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "min-width:" | append: v

    assign v = width.last
    assign v_num = v | times: 1
    unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
      assign v = v_num | append: "px"
    endunless
    assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "width:" | append: v

    assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "flex:" | append: flex.first
    assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "flex:" | append: flex.last
    assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "text-align:" | append: text_align.first
    assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "text-align:" | append: text_align.last
  endif

  if _settings['width_height_aspect'] and keys contains ',width_height_aspect,' or keys == null
    assign width_height_aspect = _settings['width_height_aspect'] | strip_newlines | replace: ' ', "" | split: '|'
    assign width = width_height_aspect[0] | split: '/'
    assign height = width_height_aspect[1] | split: '/'
    assign aspect = width_height_aspect[2] | split: '/'

    assign v = width.first
    assign v_num = v | times: 1
    unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
      assign v = v_num | append: "px"
    endunless
    assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "width:" | append: v

    assign v = width.last
    assign v_num = v | times: 1
    unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
      assign v = v_num | append: "px"
    endunless
    assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "width:" | append: v

    assign v = height.first
    assign v_num = v | times: 1
    unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
      assign v = v_num | append: "px"
    endunless
    assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "height:" | append: v

    assign v = height.last
    assign v_num = v | times: 1
    unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
      assign v = v_num | append: "px"
    endunless
    assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "height:" | append: v

    assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "aspect-ratio:" | append: aspect.first
    assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "aspect-ratio:" | append: aspect.last
  endif

  if _settings['margin_top_gap'] and keys contains ',margin_top_gap,' or keys == null
    assign margin_top_gap = _settings['margin_top_gap'] | strip_newlines | replace: ' ', "" | split: '|'
    assign top = margin_top_gap[0] | split: '/'
    assign gap = margin_top_gap[1] | split: '/'

    assign v = top.first
    assign v_num = v | times: 1
    unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
      assign v = v_num | append: "px"
    endunless
    assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "margin-top:" | append: v

    assign v = top.last
    assign v_num = v | times: 1
    unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
      assign v = v_num | append: "px"
    endunless
    assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "margin-top:" | append: v

    assign v = gap.first
    assign v_num = v | times: 1
    unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
      assign v = v_num | append: "px"
    endunless
    assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "gap:" | append: v

    assign v = gap.last
    assign v_num = v | times: 1
    unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
      assign v = v_num | append: "px"
    endunless
    assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "gap:" | append: v
  endif

  if _settings['max_width_max_height_aspect'] and keys contains ',max_width_max_height_aspect,' or keys == null
    assign max_width_max_height_aspect = _settings['max_width_max_height_aspect'] | strip_newlines | replace: ' ', "" | split: '|'
    assign max_width = max_width_max_height_aspect[0] | split: '/'
    assign max_height = max_width_max_height_aspect[1] | split: '/'
    assign aspect = max_width_max_height_aspect[2] | split: '/'

    assign v = max_width.first
    assign v_num = v | times: 1
    unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
      assign v = v_num | append: "px"
    endunless
    assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "max-width:" | append: v

    assign v = max_width.last
    assign v_num = v | times: 1
    unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
      assign v = v_num | append: "px"
    endunless
    assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "max-width:" | append: v

    assign v = max_height.first
    assign v_num = v | times: 1
    unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
      assign v = v_num | append: "px"
    endunless
    assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "max-height:" | append: v

    assign v = max_height.last
    assign v_num = v | times: 1
    unless v contains 'p' or v contains 'm' or v contains 'v' or v contains 'c' or v contains 's' or v contains '%' or v contains 'a' or v contains '#' or v_num == 0
      assign v = v_num | append: "px"
    endunless
    assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "max-height:" | append: v

    assign desktop_styles = desktop_styles | append: ";" | append: css_var | append: "aspect-ratio:" | append: aspect.first
    assign mobile_styles = mobile_styles | append: ";" | append: css_var | append: "aspect-ratio:" | append: aspect.last
  endif
%}
{% capture styles %}
  {{ selector }} {
  {{ mobile_styles | append: ";" }}
  }
  @media screen and (min-width: {{ _settings.responsive_breakpoint | default: "768px" | replace: "px", "" | append: "px" }} ) {
  {{ selector }} {
  {{ desktop_styles | append: ";" }}
  }
  }
  {% if desktop_styles_only != blank %}
    @media screen and (min-width: {{ _settings.responsive_breakpoint | default: "768px" | replace: "px", "" | append: "px" }} ) {
    {{ selector | append: ':has(:not(.\@container *))' }} {
    {{ desktop_styles_only | append: ";" }}
    }
    }
  {% endif %}
  {% if mobile_styles_only != blank %}
    @media screen and (max-width: {{ _settings.responsive_breakpoint | default: "768px" | replace: "px", "" | append: "px" }} ) {
    {{ selector }} {
    {{ mobile_styles_only | append: ";" }}
    }
    }
    @container (max-width: {{ _settings.responsive_breakpoint | default: "768px" | replace: "px", "" | append: "px" }}) {
    {{ selector }} {
    {{ mobile_styles_only | append: ";" }}
    }
    }
  {% endif %}
  {% comment %}{% if _settings['apply_container_queries'] %}{% endcomment %}
  @container (max-width: {{ _settings.responsive_breakpoint | default: "768px" | replace: "px", "" | append: "px" }}) {
  {{ selector }} {
  {{ mobile_styles | append: ";" }}
  }
  }
  {{ selector }}:where(:hover,:focus-visible,:active,.active):not(.button-loading) {
  {{ hover_mobile_styles | append: ";" }}
  }
  {% comment %}{% endif %}{% endcomment %}
  {% liquid
    if __keys contains ',custom_css'
      assign setting_keys = ",__body,__p,__h1,__h2,__h3,__h4,__h5,__h6" | split: ','
      for _setting_key in setting_keys
        assign _settings_key = 'custom_css' | append: _setting_key
        assign _settings_key_check = ',custom_css' | append: _setting_key | append: ','
        if _settings[_settings_key] and keys contains _settings_key_check or keys == null
          assign where_selector = ':where(' | append: selector | append: ')'
          assign output = _settings[_settings_key] | replace: "&", where_selector
          echo output
        endif
      endfor
    endif
  %}
{% endcapture %}

<style{% comment %} x-init="requestIdleCallback(()=>document.head.appendChild($el), {timeout: 1234})"{% endcomment %}>{{ styles | strip_newlines }}</style>
