<style>
  {% for theme in settings.color_schemes %}
  {% liquid
    assign group_name = "group_" | append: i
    assign group_class_name = theme
    assign color_background = "background"
    assign color_background_gradient = "background_gradient"
    assign text_color = "text"
    assign color_overlay_text = "overlay_text"
    assign color_accent = "accent"
    assign color_border = "border"
  %}

  .{{ theme }} {
    --tw-text-opacity: 1;
    color: rgb(var(--color-text) / var(--tw-text-opacity));
    --tw-bg-opacity: 1;
    background-color: rgb(var(--color-bg) / var(--tw-bg-opacity));
    --color-text--rgb: {%- render '_input.color-rgb', color: theme.settings[text_color] -%};
    --color-text--hex: {{ theme.settings[text_color] }};
    --color-text: var(--color-text--rgb, {{ theme.settings[text_color] }});
    --color-overlay-text--rgb: {%- render '_input.color-rgb', color: theme.settings[color_overlay_text] -%};
    --color-overlay-text--hex: {{ theme.settings[color_overlay_text] }};
    --color-overlay-text: var(--color-overlay-text--rgb, {{ theme.settings[color_overlay_text] }});
    --color-bg--rgb: {%- render '_input.color-rgb', color: theme.settings[color_background] -%};
    --color-bg--hex: {{ theme.settings[color_background] }};
    --color-bg: var(--color-bg--rgb, {{ theme.settings[color_background] }});
    --color-bg-gradient: {{ theme.settings[color_background_gradient] }};
    --color-accent--rgb: {%- render '_input.color-rgb', color: theme.settings[color_accent] -%};
    --color-accent--hex: {{ theme.settings[color_accent] }};
    --color-accent: var(--color-accent--rgb, {{ theme.settings[color_accent] }});
    --color-border--rgb: {%- render '_input.color-rgb', color: theme.settings[color_border] -%};
    --color-border--hex: {{ theme.settings[color_border] }};
    --color-border: var(--color-border--rgb, {{ theme.settings[color_border] }});
  }

  {%- if settings.color_scheme == group_class_name -%}
  :root {
    --color-text--rgb: {%- render '_input.color-rgb', color: theme.settings[text_color] -%};
    --color-text--hex: {{ theme.settings[text_color] }};
    --color-text: var(--color-text--rgb, {{ theme.settings[text_color] }});
    --color-overlay-text--rgb: {%- render '_input.color-rgb', color: theme.settings[color_overlay_text] -%};
    --color-overlay-text--hex: {{ theme.settings[color_overlay_text] }};
    --color-overlay-text: var(--color-overlay-text--rgb, {{ theme.settings[color_overlay_text] }});
    --color-bg--rgb: {%- render '_input.color-rgb', color: theme.settings[color_background] -%};
    --color-bg--hex: {{ theme.settings[color_background] }};
    --color-bg: var(--color-bg--rgb, {{ theme.settings[color_background] }});
    --color-bg-gradient: {{ theme.settings[color_background_gradient] }};
    --color-accent--rgb: {%- render '_input.color-rgb', color: theme.settings[color_accent] -%};
    --color-accent--hex: {{ theme.settings[color_accent] }};
    --color-accent: var(--color-accent--rgb, {{ theme.settings[color_accent] }});
    --color-border--rgb: {%- render '_input.color-rgb', color: theme.settings[color_border] -%};
    --color-border--hex: {{ theme.settings[color_border] }};
    --color-border: var(--color-border--rgb, {{ theme.settings[color_border] }});
  }

  {%- endif -%}
  {%- endfor -%}

  :root {
    --color-error--rgb: {%- render '_input.color-rgb', color: settings.color__error -%};
    --color-error--hex: {{ settings.color__error }};
    --color-error-text--hex: {{ settings.color__error | color_darken: 30 }};
    --color-error: var(--color-error--rgb, {{ settings.color__error }});
    --color-warning--rgb: {%- render '_input.color-rgb', color: settings.color__warning -%};
    --color-warning--hex: {{ settings.color__warning }};
    --color-warning-text--hex: {{ settings.color__warning  | color_darken: 30 }};
    --color-warning: var(--color-warning--rgb, {{ settings.color__warning }});
    --color-success--rgb: {%- render '_input.color-rgb', color: settings.color__success -%};
    --color-success--hex: {{ settings.color__success }};
    --color-success-text--hex: {{ settings.color__success | color_darken: 30 }};
    --color-success: var(--color-success--rgb, {{ settings.color__success }});
    --color-info--rgb: {%- render '_input.color-rgb', color: settings.color__info -%};
    --color-info--hex: {{ settings.color__info }};
    --color-info-text--hex: {{ settings.color__info |color_darken: 30 }};
    --color-info: var(--color-info--rgb, {{ settings.color__info }});
    --color-review-stars--rgb: {%- render '_input.color-rgb', color: settings.color__review_stars -%};
    --color-review-stars--hex: {{ settings.color__review_stars }};
    --color-review-stars: var(--color-review-stars--rgb, {{ settings.color__review_stars }});
    --color-modal-background: {{ settings.color__modal_background }};
  }

  :root {
    --color-gray-50: 249 250 251;
    --color-gray-100: 243 244 246;
    --color-gray-200: 229 231 235;
    --color-gray-300: 209 213 219;
    --color-gray-400: 156 163 175;
    --color-gray-500: 107 114 128;
    --color-gray-600: 75 85 99;
    --color-gray-700: 55 65 81;
    --color-gray-800: 31 41 55;
    --color-gray-900: 17 24 39;
  }

  :root {

    --color-review-stars: {{ settings.color__review_stars }};
    --color-review-stars-base: #D1D5DB;
  }

  {% case settings.color_grayscale %}
  {% when 'slate' %}
  :root {
    --color-gray-50: 248 250 252;
    --color-gray-100: 241 245 249;
    --color-gray-200: 226 232 240;
    --color-gray-300: 203 213 225;
    --color-gray-400: 148 163 184;
    --color-gray-500: 100 116 139;
    --color-gray-600: 71 85 105;
    --color-gray-700: 51 65 85;
    --color-gray-800: 30 41 59;
    --color-gray-900: 15 23 42;
  }

  {% when 'gray' %}

  :root {
    --color-gray-50: 249 250 251;
    --color-gray-100: 243 244 246;
    --color-gray-200: 229 231 235;
    --color-gray-300: 209 213 219;
    --color-gray-400: 156 163 175;
    --color-gray-500: 107 114 128;
    --color-gray-600: 75 85 99;
    --color-gray-700: 55 65 81;
    --color-gray-800: 31 41 55;
    --color-gray-900: 17 24 39;
  }

  {% when 'zinc' %}

  :root {
    --color-gray-50: 250 250 250;
    --color-gray-100: 244 244 245;
    --color-gray-200: 228 228 231;
    --color-gray-300: 212 212 216;
    --color-gray-400: 161 161 170;
    --color-gray-500: 113 113 122;
    --color-gray-600: 82 82 91;
    --color-gray-700: 63 63 70;
    --color-gray-800: 39 39 42;
    --color-gray-900: 24 24 27;
  }

  {% when 'neutral' %}

  :root {
    --color-gray-50: 250 250 250;
    --color-gray-100: 245 245 245;
    --color-gray-200: 229 229 229;
    --color-gray-300: 212 212 212;
    --color-gray-400: 163 163 163;
    --color-gray-500: 115 115 115;
    --color-gray-600: 82 82 82;
    --color-gray-700: 64 64 64;
    --color-gray-800: 38 38 38;
    --color-gray-900: 23 23 23;
  }

  {% when 'stone' %}

  :root {
    --color-gray-50: 250 250 249;
    --color-gray-100: 245 245 244;
    --color-gray-200: 231 229 228;
    --color-gray-300: 214 211 209;
    --color-gray-400: 168 162 158;
    --color-gray-500: 120 113 108;
    --color-gray-600: 87 83 78;
    --color-gray-700: 68 64 60;
    --color-gray-800: 41 37 36;
    --color-gray-900: 28 25 23;
  }

  {% endcase %}


</style>
