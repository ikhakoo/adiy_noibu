{%- comment -%} Auto Generated Variables start {%- endcomment -%}
{%- liquid
  assign block_type = "image-with-content"
  assign section_type = "megamenu"
  assign image = block.settings.image
  assign title = block.settings.title
  assign title_class = block.settings.title_class
  assign icon = block.settings.icon
  assign url = block.settings.url
  assign columns_span = block.settings.columns_span
-%}
{%- comment -%} Auto Generated Variables end {%- endcomment -%}

<div data-style-id="{{ section.id }}--{{ block.id }}"
     class="group grid w-full h-full relative col-[span_var(--col-span)_/_span_var(--col-span)] rounded-[15px] overflow-hidden"
     style="--col-span: {{ columns_span }};"
     {% if url != blank %}
      title="{{ url }}"
      role="button"
      tabindex="0"
      @click.prevent.stop="barba.go('{{ url }}'); $modal.setId('')"
    {% endif %}
     {{ block.shopify_attributes }}>
  <figure class="relative inset-0 pointer-events-none block aspect-[1.25]"
          style="z-index: 1;">
    {% render '_object.image', image: image, sizes: "100vw", class: "w-full h-full object-cover transition-all scale-100 group-hf:scale-105 select-none", preload: false %}
    <figcaption class="absolute inset-0 p-8 flex flex-col w-full h-full justify-between z-10">
      {% render '_input.richtext', content: title, class: title_class, block: block, forloop: forloop %}
      {% render '_object.image', image: icon, sizes: "100vw", class: "w-8 h-8", preload: false %}
    </figcaption>
  </figure>
</div>