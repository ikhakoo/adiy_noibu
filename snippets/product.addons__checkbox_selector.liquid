{%- comment -%} Auto Generated Variables start {%- endcomment -%}
{%- liquid
  assign block_type = "addons__checkbox_selector"
  assign section_type = "product"
  assign legend_label = block.settings.legend_label
  assign metafield = block.settings.metafield
  assign legend = block.settings.legend
  assign legend_class = block.settings.legend_class
  assign radio_button_class = block.settings.radio_button_class
  assign margin_top_gap = block.settings.margin_top_gap
  assign content_flow = block.settings.content_flow
  assign margin_top_bottom_left_right = block.settings.margin_top_bottom_left_right
  assign max_w_flex_col_row_order_align = block.settings.max_w_flex_col_row_order_align
  assign responsive_visibility = block.settings.responsive_visibility
  assign hide_if_empty = block.settings.hide_if_empty
  assign responsive_breakpoint = block.settings.responsive_breakpoint
  assign anchor_id = block.settings.anchor_id
  assign show_conditionally = block.settings.show_conditionally
-%}
{%- comment -%} Auto Generated Variables end {%- endcomment -%}

{% liquid
  assign namespace_key = metafield | replace: " ", "" | trim | strip_newlines | split: '.'
  assign metafield = product.metafields[namespace_key[0]][namespace_key[1]].value

  assign has_any_available = false
  for p in metafield
    if p.available
      assign has_any_available = true
      break
    endif
  endfor

  if request.design_mode != true
    unless has_any_available
      unless metafield.count > 0
        assign is_empty = true
      endunless
      if hide_if_empty == 'block' and is_empty
        echo '<script type="block/hide"></script>'
        break
      endif
      if hide_if_empty == 'container' and is_empty
        echo '<script type="container/break"></script>'
        break
      endif
      if hide_if_empty == 'section' and is_empty
        echo '<script type="section/break"></script>'
        break
      endif
    endunless
  endif

  if is_empty
    break
  endif

  assign content_legend = legend | replace: "[heading]", legend_label
  assign current_legend = content_legend | replace: "[value]", current_title | default: legend_label

  case content_flow
    when "show_all"
      assign container_classes = 'flex-wrap overflow-hidden'
    when "truncate"
      assign container_classes = 'overflow-hidden'
    when "overflow"
      assign container_classes = 'overflow-x-auto'
  endcase
%}

{% render '_utils.dynamic-css',
    block: block,
    selector: "& [data-style-container]",
    keys: "margin_top_gap" %}
{% render '_utils.dynamic-css',
    block: block,
    keys: "responsive_visibility,max_w_flex_col_row_order_align,padding_top_bottom_left_right,margin_top_bottom_left_right,border_width_radius,background_color,background_gradient,border_color" %}

<fieldset x-data="{ index: +$el.getAttribute('data-index'), hoverValue: '' }"
  data-style-id="{{ section.id }}--{{ block.id }}"
  {% if anchor_id != blank %}id="{{ anchor_id }}"{% endif %}
  {{ block.shopify_attributes }}
  data-block-type="{{ block.type }}"
  data-style-container
  >
  <legend class="flex justify-center bg-[#ECE8E4] text-[#3A6958] py-[6px] px-3 w-full max-w-full truncate rounded-t-[15px] {{ legend_class }}"
        data-legend="{% render '_input.inline_richtext', content: content_legend, escape: true, block: block, forloop: forloop %}"
        x-effect="$el.innerHTML = $el.getAttribute('data-legend').replace('[value]', hoverValue || ` ${$data.state.options[index]} (${$data.state?.selected_variant?.metafields?.custom?.sqfootage} sqft.)`)">
    {% render '_input.inline_richtext', content: current_legend, block: block, forloop: forloop %}
  </legend>

  <div class="flex flex-col gap-4 bg-[#F6F4F2] p-4 rounded-b-[15px]">
    {% for object in metafield %}
      {% unless object.available %}
        {% continue %}
      {% endunless %}
      <div
        x-show="$data.showConditionally('{{ show_conditionally }}')"
        data-handle="{{ object.handle }}"
        class="flex flex-col gap-4"
        x-data="{
          active: false,
          default_value: '',
          default_variant_index: null,
          local: { product: null, options:  null },
          init() {
            const h = this.$el.dataset.handle
            const data = utils.JSONParse($el.querySelector('[data-product-data]').innerHTML);

            this.local.product = data

            const first = (data.variants || []).find(v => v.available) || (data.variants || [])[0]
            const fallbackOpts = [first?.option1, first?.option2, first?.option3].filter(Boolean)
            const fromOptionsWithValues = (data.options_with_values || []).map(o => o.selected_value).filter(Boolean)

            this.local.options = fromOptionsWithValues.length ? fromOptionsWithValues : fallbackOpts
            this.local.selected_variant = first || null
          },
          setProductOption({ index, value }) {
            this.local.options[index] = value
            this.local.selected_variant = (this.local.product.variants || []).find(v =>
              this.local.options.every((opt, i) => v[`option${i+1}`] === opt)
            ) || null
          },
          hasAvailableVariant(index, value) {
            const temp = [...this.local.options]
            temp[index] = value
            return (this.local.product.variants || []).some(v =>
              temp.every((opt,i)=> v[`option${i+1}`] === opt) && v.available
            )
          },
          firstValueFor(index) {
            const values = (this.local.product.options_with_values?.[index]?.values) || [];
            return values.find(v => this.hasAvailableVariant(index, v)) || values[0] || '';
          },
          selectFirstFor(index) {
            const v = this.firstValueFor(index);
            if (!v) return;
            this.setProductOption({ index, value: v });

            const input = $el.querySelector(`input[type='radio'][value='${CSS.escape(v)}']`);
            if (input && !input.checked) input.checked = true;
          }
        }"
        x-effect=" if (active) { 
                        default_variant_index = $data.local.product.variants.findIndex(variant => variant?.id === $data?.local?.selected_variant?.id)
                      } else {
                        default_variant_index = $data.local.product.variants.findIndex(variant => variant?.id === $data?.local?.selected_variant?.id) + 1
                      };" 
        >
        <script type="application/json"
                data-product-data="{{ object.handle }}">{%- render '_json.product', product: object, meta_product: true -%}</script>

        <label class="input-checkbox-pdp">
          <span class="relative shrink-0">
            <input type="checkbox"
                  x-model="active"
                  @pageshow.window="
                    const nav = performance.getEntriesByType('navigation')[0];
                    const isBack = $event.persisted || nav?.type === 'back_forward';
                    if (!isBack) return;

                    if ($el.checked) {
                      $el.checked = false;
                      active = false;
                      $el.dispatchEvent(new Event('change', { bubbles: true }));
                    }
                  "
                  @change="value = $el.checked;
                          active = $el.checked;
                          if (active) {
                            selectFirstFor(index);
                            $store.main_product.addOrUpdateAddon({
                              handle: '{{ object.handle }}',
                              product: local.product,
                              variant: local.selected_variant,
                              quantity: 1
                            });
                          } else {
                            setProductOption({ index, value: '' });
                            $store.main_product.removeAddon('{{ object.handle }}');
                          }"
                  aria-label="{{ object.selected_or_first_variant.price }}">
            <span class="absolute inset-0 flex items-center justify-center">
              <svg class=""></svg>
            </span>
          </span>
          <span>
            Add {{ object.title }}
          </span>
        </label>

        {% for option in object.options_with_values %}
          <div class="relative w-full scrollbar-none {{ container_classes }}"
            x-show="!!active" 
            x-data="{ 
              offset: +`{{ option.values.size }}`
            }"
            style="display: none;">
            <div class="relative w-full flex flex-wrap scrollbar-none gap-x-2 gap-y-4 pb-4">
              {% for value in option.values %}
                <div class="flex flex-col shrink-0">
                  <label class="flex flex-col flex-grow items-center !w-full !outline-none {{ radio_button_class }}"
                          x-data="{ matchedVariant: null }"
                          x-effect="
                              let tempOptions = [...local.options];
                              tempOptions[index] = $el.getAttribute('aria-label');
                              matchedVariant = local.product.variants.find(variant => 
                                  tempOptions.every((option, idx) => variant[`option${idx + 1}`] === option)
                              );
                              $el.classList.toggle('active', local.options[index] === $el.getAttribute('aria-label'));
                          "
                          x-show="offset >= +`{{ forloop.index0 }}` && $data.hasAvailableVariant(index, `{{ value }}`)"
                          @pointerenter="if (window.matchMedia('(min-width: 768px)').matches) { hoverValue = ` ${$el.getAttribute('aria-label')} (${matchedVariant?.metafields?.custom?.sqfootage}sqft).`}"
                          @pointerleave="if (window.matchMedia('(min-width: 768px)').matches) { hoverValue = '' }"
                          :class="$data.hasAvailableVariant(index, `{{ value }}`) ? '' : ''"
                          aria-label="{{ value }}">
                    <input type="radio"
                            class="sr-only"
                            name="{{ block.id }}"
                            @change="$data.setProductOption({ index, value: $el.value });
                             if (active) {
                               $store.main_product.addOrUpdateAddon({
                                 handle: '{{ object.handle }}',
                                 product: local.product,
                                 variant: local.selected_variant,
                                 quantity: 1
                               });
                             }"
                            :checked="$data.state.options[index] === $el.value"
                            value="{{ value }}">
                    {% assign value_content = value | replace: "[value]", value %}
                    {% render '_input.inline_richtext', content: value_content %}
                    <span class="richtext-md h6" x-show="matchedVariant?.metafields?.smart?.seating_capacity"
                          x-html="matchedVariant?.metafields?.smart?.seating_capacity"></span>
                  </label>
                </div>
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endfor %}
  </div>
</fieldset>