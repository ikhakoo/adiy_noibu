{%- comment -%} Auto Generated Variables start {%- endcomment -%}
{%- liquid
  assign section_type = "text-cards"
  assign columns = section.settings.columns
  assign mobile_layout = section.settings.mobile_layout
  assign gap_content = section.settings.gap_content
  assign vertical_padding_section = section.settings.vertical_padding_section
  assign section_id = section.settings.section_id
  assign container_spacing = section.settings.container_spacing
  assign responsive_visibility = section.settings.responsive_visibility
-%}
{%- comment -%} Auto Generated Variables end {%- endcomment -%}

{% liquid
  if mobile_layout == "slider"
    assign grid_cols = "max-md:auto-cols-[calc((100%_-_(12px_*_(1.05_-_1)))_/_1.05)] max-md:grid-flow-col-dense place-content-center max-md:overflow-x-auto max-md:overflow-y-hidden snap-x snap-mandatory scrollbar-none"
    assign slider_overflow = container_spacing | replace: 'px', 'max-md:-mx' | append: " max-md:scroll-" | append: container_spacing | append: " max-md:" | append: container_spacing
  endif
  assign gap_content = gap_content | strip_newlines | replace: ' ', "" | split: '|'
  assign gap_desktop = gap_content[0]
  assign gap_mobile = gap_content[1]
  assign gap_content = "--gap:" | append: gap_mobile | append: "; --gap-md:" | append: gap_desktop | append: ";"

  assign vertical_padding_section = vertical_padding_section | strip_newlines | replace: ' ', "" | split: '|'
  assign pt = vertical_padding_section[0] | split: '/'
  assign pb = vertical_padding_section[1] | split: '/'

  assign pagination_block = section.blocks | where: "type", "pagination" | first
%}

<style>
  #{{ section.id }} {
    padding-top: {{ pt.first }};
    padding-bottom: {{ pb.first }};
  }
  @media (max-width: 768px) {
    #{{ section.id }} {
      padding-top: {{ pt.last }};
      padding-bottom: {{ pb.last }};
    }
  }
</style>

{% render "_section.universal-settings", section_type: section_type, section_id: section.id, insert: "before" %}
<section class="grid relative md:overflow-hidden"
    style="{{ gap_content }};--columns: {{ columns }};"
    {% if mobile_layout == "slider" %}
    x-data="{ ..._sections.initContentSlider($refs.container, undefined, true) }"
    x-defer="intersect"
    data-grid-slider
    {% endif %}>
    <div class="relative grid md:grid-flow-col-dense md:auto-cols-[calc((100%_-_(var(--gap-md)_*_(var(--columns)_-_1)))_/_var(--columns))] gap-[--gap] md:gap-[--gap-md] {{ grid_cols }} {{ slider_overflow }}"
      {% if mobile_layout == "slider" %}
         x-ref="container"
         @resize.window="content_slider.handleResize"
         x-init="$nextTick(() => content_slider.handleResize())"
         @scroll="content_slider.handleScroll"
         @scrollend="content_slider.handleInfiniteScroll"
         data-style-content-slider
      {% endif %}
    >
      {% liquid
        for block in section.blocks
          case block.type
            when "card"
              render 'text-cards.card', block: block, forloop: forloop, section_type: section_type
          endcase 
        endfor
        %}
    </div>
    {% if pagination_block %}
      {% liquid
        render 'text-cards.pagination', block: pagination_block, forloop: forloop, section_type: section_type
      %}
    {% endif %}
</section>
{% render "_section.universal-settings", section_type: section_type, insert: "after" %}
