{%- comment -%} Auto Generated Variables start {%- endcomment -%}
{%- liquid
  assign block_type = "subscribe__button_card"
  assign section_type = "product"
  assign legend_label = block.settings.legend_label
  assign legend_class = block.settings.legend_class
  assign price_calculation = block.settings.price_calculation
  assign currency_display = block.settings.currency_display
  assign subscription_content = block.settings.subscription_content
  assign subscription_highlights = block.settings.subscription_highlights
  assign savings_highlight_class = block.settings.savings_highlight_class
  assign select_class = block.settings.select_class
  assign discount_percentage_override = block.settings.discount_percentage_override
  assign one_time_content = block.settings.one_time_content
  assign one_time_highlights = block.settings.one_time_highlights
  assign default_selection = block.settings.default_selection
  assign margin_top_gap = block.settings.margin_top_gap
  assign grid_cols_align_x_align_y_gap = block.settings.grid_cols_align_x_align_y_gap
  assign layout_order = block.settings.layout_order
  assign padding_top_bottom_left_right = block.settings.padding_top_bottom_left_right
  assign border_width_radius = block.settings.border_width_radius
  assign label_class = block.settings.label_class
  assign price_class = block.settings.price_class
  assign text_color = block.settings.text_color
  assign border_color = block.settings.border_color
  assign background_color = block.settings.background_color
  assign hover_text_color = block.settings.hover_text_color
  assign hover_border_color = block.settings.hover_border_color
  assign hover_background_color = block.settings.hover_background_color
  assign margin_top_bottom_left_right = block.settings.margin_top_bottom_left_right
  assign max_w_flex_col_row_order_align = block.settings.max_w_flex_col_row_order_align
  assign responsive_visibility = block.settings.responsive_visibility
  assign responsive_breakpoint = block.settings.responsive_breakpoint
  assign anchor_id = block.settings.anchor_id
-%}
{%- comment -%} Auto Generated Variables end {%- endcomment -%}

{% liquid
  unless product.selling_plan_groups.size > 0
    break
  endunless

  capture subscription_content
    render '_input.inline_richtext', content: subscription_content
  endcapture

  assign selling_plan_allocations = product.selected_or_first_available_variant | map: "selling_plan_allocations"
  assign subscriptions = selling_plan_allocations | map: "selling_plan"
  assign subscription_titles = subscriptions | map: "name"
  assign subscription_ids = subscriptions | map: "id"

  assign selected_subscription = product.selected_or_first_available_variant.selected_selling_plan_allocation.selling_plan | default: subscriptions
  assign selected_subscription_id = selected_subscription.id | default: subscriptions[0].id
  assign selected_subscription_title = selected_subscription.name | default: subscriptions[0].name
  assign lowest_percentage = selected_subscription | map: "price_adjustments" | where: "value_type", "percentage" | map: "value" | first
  assign lowest_amount = selected_subscription | map: "price_adjustments" | where: "value_type", "fixed_amount" | map: "value" | first

  assign save_value = ''
  if lowest_percentage
    assign save_percentage = lowest_percentage | default: '10' | abs | divided_by: 100.00
    assign save_amount = product.selected_or_first_available_variant.price | times: save_percentage | round
    if save_value > 0
      assign save_value = lowest_percentage | append: ", block: block, forloop: forloop %" | prepend: 'Save '
    endif
  endif
  if lowest_amount
    assign save_amount = lowest_amount | abs
    if save_value > 0
      assign save_value = lowest_amount | money | append: ' off'
    endif
  endif

  assign price = product.selected_or_first_available_variant.price
  assign discounted_price = price | minus: save_amount | at_least: 0
  assign current_subscription_content = subscription_content | replace: "[value]", save_value | strip_newlines
  assign _subscription_content = subscription_content | escape
%}

{% render '_utils.dynamic-css',
    block: block,
    keys: "responsive_visibility,max_w_flex_col_row_order_align,margin_top_bottom_left_right" %}

{% render '_utils.dynamic-css',
    block: block,
    keys: "border_width_radius, margin_top_gap",
    css_variables: true %}

{% render '_utils.dynamic-css',
    block: block,
    selector: "& [data-style-label]",
    keys: "padding_top_bottom_left_right,border_width_radius,background_color,border_color,text_color" %}

<div
    data-style-id="{{ section.id }}--{{ block.id }}"
    {% if anchor_id != blank %}id="{{ anchor_id }}"{% endif %}
    {{ block.shopify_attributes }}
    class="flex flex-col gap-[--gap]"
    style="--ac-color: {{ hover_text_color }}; --ac-border-color: {{ hover_border_color }}; --ac-bg-color: {{ hover_background_color }}"
    x-show="$data.state?.selected_variant?.selling_plan_allocations?.length"
    {% if selected_subscription_id == blank %}
      x-cloak
    {% endif %}
    {{ block.shopify_attributes }}>
  <fieldset>
    {% if legend_label != blank %}
      <legend class="mb-[--margin-top] flex w-full max-w-full truncate {{ legend_class }}">
        {% render '_input.inline_richtext', content: legend_label, block: block, forloop: forloop %}
      </legend>
    {% endif %}
    <div class="grid gap-[--gap]">
      <label class="w-full overflow-hidden group ac:text-[--ac-color] ac:border-[--ac-border-color] ac:bg-[--ac-bg-color] {% if default_selection == 'one_time' %}active{% endif %}"
             x-effect="() => { $el.classList?.toggle('active', !$data.state?.selected_selling_plan); $el.classList?.toggle('cursor-pointer', $data.state?.selected_selling_plan); }"
          {% if default_selection == 'one_time' %}
            x-init="$data.setSellingPlan(null)"
          {% endif %}
             aria-label="{{ value }}"
             data-style-label>
        <input type="radio"
               class="sr-only"
               @change="$data.setSellingPlan(null)"
               name="{{ block.id }}"
               value="{{ value }}">

        <span class="flex items-center gap-1 sm:gap-3">
          <span class="flex size-5 shrink-0 items-center justify-center overflow-hidden rounded-full border-solid border-w-[--border-width] group-ac:text-[--ac-bg-color] group-ac:border-[--ac-border-color] group-ac:bg-[--ac-border-color]">
            {% render '_components.icon', icon: 'check-mark', class: 'size-3.5 group-ac:opacity-100 opacity-0' %}
          </span>
          <span class="shrink-0 {{ label_class }}">
            {% render '_input.inline_richtext', content: one_time_content, block: block, forloop: forloop %}
          </span>

          <span class="ml-auto shrink-0 flex items-baseline gap-2 {{ price_class }}">
            <span
                {% if price_calculation == 'normal' %}
                  x-html="utils.formatMoney($data.state.selected_variant.price, window.money_format.replace(/amount[^}]*/gi,`{{ currency_display }}`))"
                {% endif %}
                {% if price_calculation == 'quantity_multiplied' %}
                  x-html="utils.formatMoney($data.state.selected_variant.price * ($data.state.quantity ?? 1), window.money_format.replace(/amount[^}]*/gi,`{{ currency_display }}`))"
                {% endif %}
            >{{ price | money }}</span>
          </span>
        </span>
        <span class="flex flex-col" x-show="!$data.state?.selected_selling_plan">
          <span class="block pl-3 pt-4" x-show="$el.innerText?.trim()">
            {% render '_input.richtext', content: one_time_highlights, class: 'richtext-md [&_svg]:!text-[--ac-border-color]', block: block, forloop: forloop %}
          </span>
        </span>
      </label>
      <label class="w-full group ac:text-[--ac-color] ac:border-[--ac-border-color] ac:bg-[--ac-bg-color] overflow-hidden {% if default_selection == 'subscription' %}active{% endif %} {{ layout_order }}"
             x-effect="() => { $el.classList?.toggle('active', !!$data.state?.selected_selling_plan); $el.classList?.toggle('cursor-pointer', !$data.state?.selected_selling_plan); }"
             aria-label="{{ value }}"
          {% if default_selection == 'subscription' %}
            x-init="$data.setSellingPlan(+`{{ selected_subscription_id }}`)"
          {% endif %}
             data-style-label>
        <input type="radio"
               class="sr-only"
               @change="$data.setSellingPlan(+$el.value)"
               name="{{ block.id }}"
               value="{{ selected_subscription_id }}">
        <span class="flex items-center gap-1 sm:gap-3">
          <span class="flex size-5 shrink-0 items-center justify-center overflow-hidden rounded-full border-solid border-w-[--border-width] group-ac:text-[--ac-bg-color] group-ac:border-[--ac-border-color] group-ac:bg-[--ac-border-color]">
            {% render '_components.icon', icon: 'check-mark', class: 'size-3.5 group-ac:opacity-100 opacity-0' %}
          </span>
          <span class=" shrink-0 {{ label_class }}"
                data-content="{{ subscription_content | escape }}"
                x-html="$el.getAttribute('data-content').replace('[value]', $data.state?.selling_plan_discount_wording)">
            {{ current_subscription_content }}
          </span>
          {% if savings_highlight_class != blank %}
            <span class="shrink-0 {{ savings_highlight_class }}"
                  x-show="$data.state?.selling_plan_discount_wording"
                  x-html="$data.state?.selling_plan_discount_wording">{{ save_value }}</span>
          {% endif %}

          <span class="shrink-0 ml-auto flex max-md:flex-col-reverse max-md:items-end items-baseline md:gap-2 {{ price_class }}"
                x-data="{ discounted_price: +`{{ discounted_price }}`, price: +`{{ price }}` }">
            <span class="line-through opacity-50 text-[0.8em]"
                  x-show="discounted_price !== price"
                {% if price_calculation == 'normal' %}
                  x-html="utils.formatMoney($data.state.selected_variant.price, window.money_format.replace(/amount[^}]*/gi,`{{ currency_display }}`))"
                {% endif %}
                {% if price_calculation == 'quantity_multiplied' %}
                  x-html="utils.formatMoney($data.state.selected_variant.price * ($data.state.quantity ?? 1), window.money_format.replace(/amount[^}]*/gi,`{{ currency_display }}`))"
                {% endif %}
            >{{ price | money }}</span>
            <span x-effect="() => {
                    price = $data.state?.selected_variant?.price;
                    const price_adjustment = $data.state?.selected_selling_plan?.price_adjustments?.[0] ?? $data.state.selected_variant?.selling_plan_allocations?.[0]?.selling_plan?.price_adjustments?.[0]

                    if (+`{{ discount_percentage_override }}`) {
                      discounted_price = Math.max(price - Math.round(+`{{ discount_percentage_override }}` / 100 * price),0)
                      return;
                    }

                    if (price_adjustment?.value_type === 'fixed_amount') {
                      discounted_price = Math.max(price - Math.round(+price_adjustment?.value),0)
                      return;
                    }
                    if (price_adjustment?.value_type === 'percentage') {
                      discounted_price = Math.max(price - Math.round(+price_adjustment?.value / 100 * price),0)
                      return;
                    }

                    discounted_price = Math.max(+$el.getAttribute('data-discounted-price'), 0)
                  }"
                {% if price_calculation == 'normal' %}
                  x-html="utils.formatMoney(discounted_price, window.money_format.replace(/amount[^}]*/gi,`{{ currency_display }}`))"
                {% endif %}
                {% if price_calculation == 'quantity_multiplied' %}
                  x-html="utils.formatMoney(discounted_price * ($data.state.quantity ?? 1), window.money_format.replace(/amount[^}]*/gi,`{{ currency_display }}`))"
                {% endif %}
                  data-discounted-price="{{ discounted_price }}">{{ discounted_price | money }}</span>
          </span>
        </span>
        <span class="flex flex-col" x-show="$data.state?.selected_selling_plan">
          <span class="block pl-3 pt-4" x-show="$el.innerText?.trim()">
            {% render '_input.richtext', content: subscription_highlights, class: 'richtext-md [&_svg]:!text-[--ac-border-color]', block: block, forloop: forloop %}
          </span>
          <span class="mt-5">
            {% render "_components.select",
                values: subscription_ids,
                default_values: subscription_ids,
                titles: subscription_titles,
                select_class: select_class,
                label: _subscription_content,
                setState: "$data.setSellingPlan(+value);",
                state: "$data.state?.selected_selling_plan?.id",
                current_value: selected_subscription_id,
                current_title: selected_subscription_title
            %}
          </span>
        </span>
      </label>
    </div>
  </fieldset>
</div>




