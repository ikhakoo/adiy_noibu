{%- comment -%} Auto Generated Variables start {%- endcomment -%}
{%- liquid
  assign block_type = "progress_bar"
  assign section_type = "bundle"
  assign show_conditionally = block.settings.show_conditionally
  assign show_based_on_bundle_state = block.settings.show_based_on_bundle_state
  assign success_bg_color = block.settings.success_bg_color
  assign success_border_color = block.settings.success_border_color
  assign base_bg_color = block.settings.base_bg_color
  assign base_border_color = block.settings.base_border_color
  assign bar_height_border_width_radius = block.settings.bar_height_border_width_radius
  assign always_show_description = block.settings.always_show_description
  assign margin_top_bottom_left_right = block.settings.margin_top_bottom_left_right
  assign max_w_flex_col_row_order_align = block.settings.max_w_flex_col_row_order_align
  assign responsive_visibility = block.settings.responsive_visibility
  assign hide_if_empty = block.settings.hide_if_empty
  assign responsive_breakpoint = block.settings.responsive_breakpoint
  assign anchor_id = block.settings.anchor_id
-%}
{%- comment -%} Auto Generated Variables end {%- endcomment -%}

{% render '_utils.dynamic-css',
    block: block
%}
{% liquid
  assign bar_height_border_width_radius = bar_height_border_width_radius | strip_newlines | split: '|'
  assign bar_height = bar_height_border_width_radius[0] | split: '/'
  assign border = bar_height_border_width_radius[1] | split: '/'
  assign radius = bar_height_border_width_radius[2] | split: '/'
  assign gap = bar_height_border_width_radius[3] | split: '/'

  assign incentive_blocks = section.blocks | where: 'type', 'incentive_target'
  assign targets = incentive_blocks | map: "settings" | map: "target"
%}

<div
    data-style-id="{{ section.id }}--{{ block.id }}"
    {% if anchor_id != blank %}id="{{ anchor_id }}"{% endif %}
    {{ block.shopify_attributes }}
    data-block-type="{{ block.type }}"
    x-show="($data.windowWidth >= 1024 || $data.showConditionally(`{{ show_conditionally }}`)) && $data.showBasedOnBundleState(`{{ show_based_on_bundle_state }}`)">
  <section x-data="{ settings: utils.JSONParse($el.getAttribute('data-settings')), current: 0, targets: utils.JSONParse($el.getAttribute('data-targets')), percentages: [], currentIndex: 0 }"
           x-effect="() => {
             current = bundle?.[settings.incentive_target_type] ?? 0;
             percentages = targets.map((target, i, arr)=> [Math.max(0, Math.min(1, (current - (arr[i - 1] ?? 0)) / (target - (arr[i - 1] ?? 0)))) * 100, i, target])?.sort((a,b)=> a[2] - b[2]);
             currentIndex = percentages.find(([percent])=> percent > 0 && percent < 100)?.[1] ?? percentages.find(([percent,i,target]) => percent === 0)?.[1] ?? percentages.findLast(([percent,i,target]) => percent === 100)?.[1]
           }"
           data-settings="{{ section.settings | json | escape }}"
           data-targets="{{ targets | json | escape }}"
           data-progress-bar
           class="@max-md:[&.cart-only]:flex relative flex h-[--height] flex-col gap-dynamic items-center justify-center overflow-hidden md:h-[--height-md] @max-md:px-[--layout-container-gutter] {{ color_scheme }} {{ responsive_visibility }} {{ container_spacing }}"
           style="--height-md: {{ section_height | first }};--height: {{ section_height | last }};
               --bar-height-md: {{ bar_height | first }};--bar-height: {{ bar_height | last }};
               --border-md: {{ border | first }};--border: {{ border | last }};
               --radius-md: {{ radius | first }};--radius: {{ radius | last }};
               --gap-md: {{ gap | first }};--gap: {{ gap | last }};
               --success-bg-color: {{ success_bg_color }};--success-border-color: {{ success_border_color }};
               --base-bg-color: {{ base_bg_color }};--base-border-color: {{ base_border_color }};">
    <footer class="grid auto-cols-fr w-full grid-flow-col items-center gap-dynamic">
      {% for block in incentive_blocks %}
        {% liquid
          assign success_message = block.settings.success_message
          assign incentive_message = block.settings.incentive_message
          assign content_class = block.settings.content_class
        %}
        <div x-data="{ index: +`{{ forloop.index0 }}`, show: $el.hasAttribute('data-always-show') }"
            {% if always_show_description %}
              data-always-show="true"
            {% endif %}
             x-cloak
             x-show="show || (index === currentIndex && percentages[percentages.length - 1][0] !== 100) || (index === (targets.length - 1) && percentages[percentages.length - 1][0] === 100)"
             class="flex justify-center text-center" data-target="{{ block.settings.target }}">
          <div x-cloak
               x-show="show ? percentages[index][0] === 100 : (index === (targets.length - 1) && percentages[percentages.length - 1][0] === 100)">
            {% render '_input.richtext', content: success_message, class: content_class, block: block, forloop: forloop %}
          </div>
          <div x-cloak
               x-show="show ? percentages[index][0] !== 100 : (index === currentIndex && percentages[percentages.length - 1][0] !== 100)"
               x-html="$el.getAttribute('data-content')?.replace('[difference]',
                 show
                    ? settings.incentive_target_type === 'total_price' || settings.incentive_target_type === 'final_price'
                     ? utils.formatMoney(targets[index] - current)
                     : `${targets[index] - current}`
                    : settings.incentive_target_type === 'total_price' || settings.incentive_target_type === 'final_price'
                     ? utils.formatMoney(targets[currentIndex] - current)
                     : `${targets[currentIndex] - current}`
               )"
               data-content="{% render '_input.richtext', content: incentive_message, class: content_class, escape: true, block: block, forloop: forloop %}"></div>
        </div>
      {% endfor %}
    </footer>
    <main class="grid auto-cols-fr w-full grid-flow-col items-center gap-dynamic">
      {% for block in incentive_blocks %}
        <div x-data="{ percent: percentages.find(([percent, i, target])=> i === +`{{ forloop.index0 }}`)[0], order: percentages.findIndex(([percent, i, target])=> i === +`{{ forloop.index0 }}`) }"
             x-effect="()=> {
               order = percentages.findIndex(([percent, i, target])=> i === +`{{ forloop.index0 }}`)
               percent = percentages[order][0];
             }"
             class="flex w-full rounded-[--radius] bg-[--base-bg-color] p-[--border] transition-all duration-150 ease-linear @md:p-[--border] @md:rounded-[--radius-md]"
             :style="`background: linear-gradient(90deg, var(--success-border-color), var(--success-border-color) ${percent}%, var(--base-border-color) ${percent}%, var(--base-border-color)); order: ${order};`"
             data-target="{{ block.settings.target }}">
          <div class="relative h-[--bar-height] flex-1 overflow-hidden rounded-[--radius] bg-[--base-bg-color] @md:h-[--bar-height-md] @md:rounded-[--radius-md]">
            <div class="relative h-full bg-[--success-bg-color] transition-all duration-150 ease-linear"
                 :style="`width: ${percent}%`"></div>
          </div>
        </div>
      {% endfor %}
    </main>
  </section>
</div>
